# Copy to .env for local dev (SQLite, no DB setup needed) and fill in real
# values. In Vercel, each of Development / Preview(staging) / Production has
# its own copy of these set via the dashboard — see docs/GO-LIVE-RUNBOOK.md.

# ── Database ──
# Local dev: leave as file:./dev.db (SQLite, zero setup).
# Staging/production: a Neon Postgres connection string. The app auto-detects
# the provider from the URL scheme (scripts/prepare-db.mjs) — no code changes
# needed to switch. Each environment MUST point at its own separate database.
DATABASE_URL="file:./dev.db"
# Neon's direct/unpooled connection — required for `prisma migrate deploy` and
# `prisma db push` (Neon's pooled URL can fail DDL). Leave unset locally.
DATABASE_URL_UNPOOLED=
# Alternate name some Neon integrations set; same purpose as DATABASE_URL_UNPOOLED.
POSTGRES_URL_NON_POOLING=

# ── Auth ──
# Long random string, DIFFERENT per environment. If unset in production the
# app refuses to start (see lib/auth.ts) rather than sign tokens with a
# guessable fallback secret.
JWT_SECRET=

# development | production — Vercel sets this automatically per scope.
NODE_ENV=development

# ── Ownership / access control ──
# The one super-user account allowed to edit/delete Users. Must exactly match
# a seeded user's login email in this environment's database.
NEXT_PUBLIC_OWNER_EMAIL=

# ── Automation / cron ──
# Protects /api/admin/* and /api/cron/*. Long random string, DIFFERENT per
# environment — Vercel Cron sends this automatically for scheduled jobs.
CRON_SECRET=

# ── Outbound email (SMTP) ──
# While SMTP_PASS is blank the app falls back to an Ethereal preview inbox
# (safe default for dev/staging — never point staging at the real tips.co.tz
# mailbox).
SMTP_HOST="mail.tips.co.tz"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── App URL ──
# Used to build absolute links in emails (e.g. password reset). Falls back to
# the request origin if unset, which is fine for local dev.
APP_URL=

# ── Error monitoring (Sentry) — optional ──
# Use a separate Sentry project for staging so its noise doesn't pollute
# production alerting.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# ── Web push notifications — optional ──
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT="mailto:admin@tips.co.tz"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
