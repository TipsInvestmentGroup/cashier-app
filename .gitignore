# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local database & logs
*.db
*.db-journal
prisma/dev.db*
/logs

# real staff/customer data — never commit; see the matching *.json files
# (without .local) for the committed placeholder shape each one expects.
prisma/persons.seed.local.json
prisma/waiter-roster.local.json
prisma/team-roster.local.json

.vercel
