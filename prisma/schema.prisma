generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// NOTE: SQLite does not support native enums. The following values are
// enforced at the application layer:
//   Role:          CASHIER | ACCOUNTANT | MANAGER | DIRECTOR | ADMIN
//   PaymentMethod: CASH | CRDB | STANBIC | MPESA
//   BillType:      ADMIN | DIRECTOR | CUSTOMER | TIPS | DJ | STAFF_LOSS
//   BillStatus:    UNPAID | PARTIAL | PAID

model User {
  id          String   @id @default(cuid())
  name        String
  email       String   @unique
  password    String
  role        String
  outletId    String?
  outlet      Outlet?  @relation(fields: [outletId], references: [id])
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  dailyCollections  DailyCollection[]
  signedBills       SignedBill[]
  paidBills         PaidBill[]
  auditLogs         AuditLog[]
  posOrders         PosOrder[]
  posWaiterSessions PosWaiterSession[]
}

model Outlet {
  id          String   @id @default(cuid())
  name        String   @unique
  location    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  users            User[]
  dailyCollections DailyCollection[]
  signedBills      SignedBill[]
  paidBills        PaidBill[]
  posTables        PosTable[]
  posShifts        PosShift[]
  posCounters      PosCounter[]
  posOrders        PosOrder[]
  posBlockedItems  PosBlockedItem[]
  dayClosures      DayClosure[]
}

/// Locks a single outlet's day. Once a (outlet, date) is closed, cashiers can no
/// longer create/edit/delete that day's collections. Reopening is supervisor-only.
model DayClosure {
  id         String   @id @default(cuid())
  outletId   String
  outlet     Outlet   @relation(fields: [outletId], references: [id])
  date       DateTime
  closedBy   String
  closedById String?
  closedAt   DateTime @default(now())

  @@unique([outletId, date])
  @@index([outletId])
}

model DailyCollection {
  id         String        @id @default(cuid())
  date       DateTime      @default(now())
  cash       Float         @default(0)
  crdb       Float         @default(0)
  stanbic    Float         @default(0)
  mpesa      Float         @default(0)
  total      Float         @default(0)
  staffName        String?
  systemSales      Float         @default(0)
  creditSales      Float         @default(0)
  paymentsReceived Float         @default(0)
  discount         Float         @default(0)     // authorized discount — reduces staff loss
  discountReason   String?
  notes      String?
  outletId   String
  outlet     Outlet        @relation(fields: [outletId], references: [id])
  cashierId  String
  cashier    User          @relation(fields: [cashierId], references: [id])
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  cancellations Cancellation[]

  @@index([date])
  @@index([outletId])
}

model Person {
  id          String   @id @default(cuid())
  name        String
  phone       String?
  email       String?
  type        String
  creditLimit Float    @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  signedBills SignedBill[]
  paidBills   PaidBill[]

  @@index([type])
}

model SignedBill {
  id            String     @id @default(cuid())
  date          DateTime   @default(now())
  voucherNumber String     @unique
  billType      String
  personId      String?
  person        Person?    @relation(fields: [personId], references: [id])
  personName    String
  amount        Float
  serviceStaff  String?
  description   String?
  dueDate       DateTime?
  status        String     @default("UNPAID")
  approvalStatus String    @default("PENDING") // PENDING | APPROVED | REJECTED (used for Tips/DJ bill requests)
  approvedBy    String?
  outletId      String
  outlet        Outlet     @relation(fields: [outletId], references: [id])
  cashierId     String
  cashier       User       @relation(fields: [cashierId], references: [id])
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  payments      PaidBill[]
  items         BillItem[]

  @@index([date])
  @@index([billType])
  @@index([status])
  @@index([outletId])
  @@index([personId])
}

// Product line items on a signed bill (Customer / Tips / DJ etc.).
model BillItem {
  id           String     @id @default(cuid())
  signedBillId String
  signedBill   SignedBill @relation(fields: [signedBillId], references: [id], onDelete: Cascade)
  productId    String?
  product      Product?   @relation(fields: [productId], references: [id])
  productName  String
  unitPrice    Float      @default(0)
  quantity     Float      @default(0)
  amount       Float      @default(0) // unitPrice * quantity
  createdAt    DateTime   @default(now())

  @@index([signedBillId])
  @@index([productId])
}

model PaidBill {
  id            String        @id @default(cuid())
  date          DateTime      @default(now())
  billRef       String?
  signedBillId  String?
  signedBill    SignedBill?   @relation(fields: [signedBillId], references: [id])
  personId      String?
  person        Person?       @relation(fields: [personId], references: [id])
  payerCategory String?
  payerName     String
  amountPaid    Float
  paymentMethod String
  notes         String?
  outletId      String
  outlet        Outlet        @relation(fields: [outletId], references: [id])
  cashierId     String
  cashier       User          @relation(fields: [cashierId], references: [id])
  createdAt     DateTime      @default(now())

  @@index([date])
  @@index([outletId])
  @@index([signedBillId])
}

model PettyCash {
  id            String   @id @default(cuid())
  date          DateTime @default(now())
  requestedBy   String
  department    String?
  functionName  String?                      // e.g. Purchases of | Allowance | Transport
  purpose       String
  amount        Float    @default(0)
  paymentMethod String                       // CASH | CRDB | STANBIC | MPESA
  payeeName     String?
  payeeAccount  String?
  paymentStatus String?  @default("PAID")     // PAID | UNPAID — has the cash actually been paid out
  approvedBy    String?
  status        String   @default("PENDING") // PENDING | APPROVED | REJECTED
  outletId      String?
  cashierId     String
  createdAt     DateTime @default(now())

  items         PettyCashItem[]

  @@index([date])
  @@index([status])
}

/// Optional line-item breakdown of a cash request (Detail · Unit · Unit Cost · Total).
/// A request with no items is a simple single-amount request.
model PettyCashItem {
  id          String    @id @default(cuid())
  pettyCashId String
  pettyCash   PettyCash @relation(fields: [pettyCashId], references: [id], onDelete: Cascade)
  detail      String
  unit        Float     @default(1)
  unitCost    Float     @default(0)
  amount      Float     @default(0)
  createdAt   DateTime  @default(now())

  @@index([pettyCashId])
}

// Departments selectable on the cash-request form (managed in /departments).
model Department {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

// Functions selectable on the cash-request form (e.g. Purchases of, Allowance, Transport).
model PettyFunction {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

// Product catalogue (managed in /products).
model Product {
  id           String   @id @default(cuid())
  code         String   @unique // auto-generated, human-readable e.g. COC-001
  name         String
  category     String?           // e.g. "Beers", "Spirits", "Soft Drinks"
  buyingPrice  Float    @default(0)
  sellingPrice Float    @default(0)
  unitMeasure  String            // unit | kg | crate 24 bottle | crate 25 bottle | crate 6 bottle
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  cancellations   Cancellation[]
  billItems       BillItem[]
  posOrderItems   PosOrderItem[]
  posBlockedItems PosBlockedItem[]

  @@index([name])
}

// Cancellations recorded against a daily collection (Double Punch / Out of Stock / Wrong Punch).
model Cancellation {
  id           String           @id @default(cuid())
  date         DateTime         @default(now())
  collectionId String?
  collection   DailyCollection? @relation(fields: [collectionId], references: [id])
  reason       String           // Double Punch | Out of Stock | Wrong Punch
  staffName    String?          // set directly for standalone requests (collection ones use collection.staffName)
  productId    String?
  product      Product?         @relation(fields: [productId], references: [id])
  productName  String
  sellingPrice Float            @default(0)
  quantity     Float            @default(0)
  amount       Float            @default(0) // sellingPrice * quantity
  status       String           @default("PENDING") // PENDING | APPROVED | REJECTED
  approvedBy   String?
  outletId     String?
  cashierId    String
  createdAt    DateTime         @default(now())

  @@index([collectionId])
  @@index([date])
  @@index([status])
}

model CashRecon {
  id             String   @id @default(cuid())
  date           DateTime @default(now())
  outletId       String?
  openingBalance Float    @default(0) // auto = previous day's closing
  cashDeposited  Float    @default(0)
  closingBalance Float    @default(0) // computed & stored so next day can auto-open
  verifiedAmount Float?              // physical cash verified by an officer
  verifiedBy     String?
  notes          String?
  cashierId      String
  createdAt      DateTime @default(now())

  @@index([date])
  @@index([outletId])
}

// Digital Payment Reconciliation — one row per digital channel per day+outlet.
model BankRecon {
  id             String   @id @default(cuid())
  date           DateTime @default(now())
  outletId       String?
  channel        String?              // digital channel code (CRDB | STANBIC | MPESA | …); null = legacy total
  reportedAmount Float    @default(0) // auto: collections + paid bills for this channel (system "collected")
  openingBalance Float?               // account opening balance (cashier)
  closingBalance Float?               // account closing balance (cashier) — required = closing − opening
  verifiedAmount Float?               // verified collected amount by an officer (null = not yet verified)
  verifiedOpening Float?              // opening balance verified by an officer
  verifiedClosing Float?              // closing balance verified by an officer
  reason         String?              // reason for variance
  reportedBy     String?
  verifiedBy     String?
  cashierId      String
  createdAt      DateTime @default(now())

  @@index([date])
  @@index([outletId])
}

model Setting {
  key   String  @id
  value String?
}

// Configurable person/bill categories (managed under Persons). code is the
// canonical key used as Person.type / SignedBill.billType; label is for display.
model PersonCategory {
  id        String   @id @default(cuid())
  code      String   @unique
  label     String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

// Configurable payment channels (managed under Outlets). Used by Paid Bills &
// Petty Cash method pickers (Daily-Collection channels are fixed columns).
model PaymentChannel {
  id        String   @id @default(cuid())
  code      String   @unique
  label     String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  details   String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entity])
  @@index([createdAt])
}

// ─── MyPos Module ─────────────────────────────────────────────────────────────
// NOTE: Status/type values are enforced at the application layer (no native enums in SQLite).
//   PosOrder.status:      OPEN | SENT | CLOSED | CANCELLED | VOID
//   PosOrderItem.status:  PENDING | SENT | CANCELLED
//   PosShift.name:        KWANZA | PILI | TATU | NNE
//   PosCounter.code:      MAIN | BAR | SHISHA | KITCHEN
//   PosOrderItem.counterCode: MAIN | BAR | SHISHA | KITCHEN

// Physical tables on the venue floor.
model PosTable {
  id        String   @id @default(cuid())
  outletId  String
  outlet    Outlet   @relation(fields: [outletId], references: [id])
  number    Int
  label     String?  // e.g. "VIP 1", "Outside 3"
  capacity  Int      @default(4)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  orders    PosOrder[]

  @@unique([outletId, number])
  @@index([outletId])
}

// One shift per outlet per day — KWANZA, PILI, TATU, NNE.
model PosShift {
  id        String    @id @default(cuid())
  outletId  String
  outlet    Outlet    @relation(fields: [outletId], references: [id])
  name      String    // KWANZA | PILI | TATU | NNE
  date      DateTime
  openedAt  DateTime  @default(now())
  closedAt  DateTime?
  openedBy  String    // userId
  closedBy  String?   // userId

  orders         PosOrder[]
  waiterSessions PosWaiterSession[]

  @@index([outletId])
  @@index([date])
}

// One counter/station per outlet (matches the 4-counter setup).
model PosCounter {
  id          String   @id @default(cuid())
  outletId    String
  outlet      Outlet   @relation(fields: [outletId], references: [id])
  code        String   // MAIN | BAR | SHISHA | KITCHEN
  label       String   // "Main Counter" | "Bar" | "Shisha" | "Kitchen"
  printerName String?  // default printer assigned to this counter
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@unique([outletId, code])
  @@index([outletId])
}

// One bill per table per visit. Closing it feeds into DailyCollection.
model PosOrder {
  id            String    @id @default(cuid())
  orderNo       String    @unique // ORD-20260619-001
  outletId      String
  outlet        Outlet    @relation(fields: [outletId], references: [id])
  tableId       String?
  table         PosTable? @relation(fields: [tableId], references: [id])
  shiftId       String
  shift         PosShift  @relation(fields: [shiftId], references: [id])
  waiterId      String
  waiter        User      @relation(fields: [waiterId], references: [id])
  status        String    @default("OPEN") // OPEN | SENT | CLOSED | CANCELLED | VOID
  discount      Float     @default(0)
  totalAmount   Float     @default(0)
  paidAmount    Float     @default(0)
  paymentMethod String?   // CASH | CRDB | STANBIC | MPESA | SIGNED
  signedBillId  String?   // set when paymentMethod = SIGNED → links to cashier SignedBill
  closedAt      DateTime?
  closedBy      String?   // userId
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  items     PosOrderItem[]
  printLogs PosPrintLog[]

  @@index([outletId])
  @@index([shiftId])
  @@index([waiterId])
  @@index([status])
  @@index([createdAt])
}

// Individual items on an order. counterCode tells the system which printer to use.
model PosOrderItem {
  id          String   @id @default(cuid())
  orderId     String
  order       PosOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  productName String   // snapshot at time of order (price may change later)
  unitPrice   Float
  quantity    Float    @default(1)
  amount      Float    // unitPrice * quantity
  extras      String?  // JSON array e.g. ["Barafu","Straw"]
  counterCode String?  // MAIN | BAR | SHISHA | KITCHEN — which counter prints this
  status      String   @default("PENDING") // PENDING | SENT | CANCELLED
  sentAt      DateTime?
  cancelledBy String?  // userId
  createdAt   DateTime @default(now())

  @@index([orderId])
  @@index([productId])
}

// Tracks every receipt/ticket sent to a counter printer.
model PosPrintLog {
  id          String   @id @default(cuid())
  orderId     String
  order       PosOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  counterCode String   // BAR | SHISHA | KITCHEN | CASHIER
  printedAt   DateTime @default(now())
  printedBy   String   // userId
  items       String   // JSON snapshot of items on this print job

  @@index([orderId])
}

// Waiter signs in/out per shift — matches POSTERMINAL SignInForm/SignOutForm.
model PosWaiterSession {
  id          String    @id @default(cuid())
  waiterId    String
  waiter      User      @relation(fields: [waiterId], references: [id])
  shiftId     String
  shift       PosShift  @relation(fields: [shiftId], references: [id])
  signedInAt  DateTime  @default(now())
  signedOutAt DateTime?

  @@index([waiterId])
  @@index([shiftId])
}

// Add-ons selectable per order item (e.g. Barafu, Straw, Lemon).
model PosProductExtra {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

// Items blocked per outlet by a manager (out of stock / not available today).
// Does not affect the global product catalogue — only the POS menu for that outlet.
model PosBlockedItem {
  id        String   @id @default(cuid())
  outletId  String
  outlet    Outlet   @relation(fields: [outletId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  blockedBy String   // userId
  reason    String?
  createdAt DateTime @default(now())

  @@unique([outletId, productId])
  @@index([outletId])
}
