generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// NOTE: SQLite does not support native enums. The following values are
// enforced at the application layer:
//   Role:          CASHIER | ACCOUNTANT | MANAGER | DIRECTOR | ADMIN | WAITER
//   PaymentMethod: CASH | CRDB | STANBIC | MPESA
//   BillType:      ADMIN | DIRECTOR | CUSTOMER | TIPS | DJ | STAFF_LOSS
//   BillStatus:    UNPAID | PARTIAL | PAID
//   ShiftType:     MORNING (09:00–16:00) | EVENING (16:00–05:00)
//   ScheduleRole:  WAITER | SUPERVISOR | BARTENDER | CASHIER | HOSTESS
//   AssignSource:  AUTO | MANUAL
//   AbsenceReason: LEAVE | ABSENT | OTHER
//   EventExpense.paymentStatus: UNPAID | PARTIAL | PAID (same vocabulary as BillStatus)
//   EventSponsor.sponsorshipType:   CASH | IN_KIND | MEDIA | OTHER
//   EventSponsor.agreementStatus:   PENDING | SIGNED | FULFILLED
//   EventTarget.type:               SALES | PROCUREMENT
//   TicketBooking.paymentStatus:    UNPAID | PARTIAL | PAID
//   TicketBooking.bookingStatus:    PENDING | CONFIRMED | CANCELLED
//   EventTable.status:              AVAILABLE | RESERVED | OCCUPIED
//   TableBooking.bookingStatus:     PENDING | CONFIRMED | CANCELLED
//   Person.codeMode:                          AUTO | MANUAL | EMPLOYEE_NUMBER | CUSTOMER_NUMBER | MEMBERSHIP_NUMBER | SUPPLIER_CODE
//   BillReferenceConfig.dateFormat:            YYMMDD | DDMMYY | YYYYMMDD | DD-MM-YYYY | MM-YYYY | CUSTOM
//   BillReferenceConfig.separator:             "-" | "/" | "_" | "." | NONE
//   BillReferenceConfig.personNumberingMode:   AUTO | MANUAL | EMPLOYEE_NUMBER | CUSTOMER_NUMBER | MEMBERSHIP_NUMBER | SUPPLIER_CODE
//   BillReferenceConfig.sequenceResetRule:     NEVER | DAILY | MONTHLY | YEARLY | PER_PERSON | PER_BILL_TYPE
//   BillReferenceComponent.type:               DATE | BILL_TYPE_CODE | PERSON_CODE | SEQUENCE | COMPANY_CODE | BRANCH_CODE | DEPARTMENT_CODE | COUNTER_CODE | OUTLET_CODE | STATIC_TEXT
//   BillTypeConfig.category:                   SIGNED_BILL | PAID_BILL | EXCESS_PAYMENT | EXCESS_REFUND | LOSS_RECORD
//   ExcessRefund.reason:                       OVERPAYMENT | DUPLICATE_PAYMENT | OTHER
//   ExcessRefund.approvalStatus:                PENDING | APPROVED | REJECTED
//   CollectionStage.entryMode:      SINGLE_STAFF | MULTI_STAFF_GRID | BATCH | EXCEL_IMPORT | POS_SYNC
//   CollectionField.fieldType:      NUMBER | TEXT | SELECT | STAFF_PICKER | PERSON_PICKER | DATE | BOOLEAN
//   CollectionValidationRule.ruleType: STAGE_SEQUENCE | CASH_NOT_EXCEED_SYSTEM_SALES | DISCOUNT_APPROVAL_LIMIT | NO_NEGATIVE_BALANCE | REQUIRED_FIELD
//   CollectionSession.status:       OPEN | IN_PROGRESS | COMPLETED | FINALIZED
//   CollectionStageRecord.status:   PENDING | IN_PROGRESS | PENDING_APPROVAL | COMPLETED | APPROVED | REJECTED
//   WorkflowApproval.status:        PENDING | APPROVED | REJECTED
//   TransactionSession.status:      OPEN | VALIDATED | CLOSED
//   StaffTransaction.category:      PAYMENT | SIGNED_BILL | DISCOUNT | CANCELLATION | CREDIT_SALE
//   StaffTransaction.status:        DECLARED | PENDING_APPROVAL | APPROVED | REJECTED
//   ── Universal Payroll Framework (Phase 1 — see docs/payroll-framework-design.md) ──
//   PayrollModuleConfig.scope:              GLOBAL | COMPANY | OUTLET
//   PayrollModuleConfig.exchangeRatePolicy: RUN_DATE | PERIOD_END | MANUAL
//   PayrollModuleConfig.roundingPolicy:     NONE | NEAREST_0_01 | NEAREST_1 | NEAREST_5 | NEAREST_10
//   PayrollModuleConfig.negativeNetPolicy:  BLOCK | CARRY_FORWARD | CAP
//   PayrollModuleConfig.payElementVisibilityDefault: SUMMARY | FULL | MASKED
//   EmployeeCategory.status:                ACTIVE | INACTIVE
//   EmployeeCategory.defaultPayFrequency:   MONTHLY | FORTNIGHTLY | WEEKLY | DAILY | HOURLY
//   PayGroup.status:                        ACTIVE | INACTIVE
//   Employee.status:                        ACTIVE | PROBATION | SUSPENDED | ON_LEAVE | TERMINATED
//   Employee.paymentMethod:                 BANK | MOBILE_MONEY | CASH
//   PayComponent.status:                    ACTIVE | INACTIVE
//   PayComponent.componentType:             EARNING | ALLOWANCE | BENEFIT | DEDUCTION | EMPLOYER_CONTRIBUTION | STATUTORY
//   PayComponent.calcMethod:                FIXED | PERCENTAGE | RATE_QTY | FORMULA | TABLE | SOURCED
//   PayComponent.frequency:                 PER_RUN | ONE_TIME | MONTHLY | ANNUAL
//   PayComponent SOURCED source (parameters.source): CREDIT_BALANCE | LOAN_SCHEDULE | ADVANCE | MANUAL | STATUTORY
//   PayrollFormula.returnType:              NUMBER | BOOLEAN
//   PayrollRun.runType:                     REGULAR | OFF_CYCLE | BONUS | FINAL | CORRECTION
//   PayrollRun.status:                      DRAFT | CALCULATED | PENDING_APPROVAL | APPROVED | LOCKED | POSTED | PAID | REVERSED
//   Payslip.status:                         CALCULATED | LOCKED | PAID
//   PayslipLine.bucket:                     EARNING | DEDUCTION | EMPLOYER
//   PayrollAuditLog.action:                 CREATE | CALCULATE | SUBMIT | APPROVE | REJECT | LOCK | POST | PAY | REVERSE
//   StatutoryRule.ruleType:                 TAX_BAND | FLAT_RATE | CAP | THRESHOLD
//   StatutoryRule.authority (TZ):           TRA | NSSF | PSSSF | NHIF | WCF | SDL | HESLB | ...
//   AttendanceRecord.source:                MANUAL | SCHEDULE | POS_SHIFT | BIOMETRIC | IMPORT | API
//   AttendanceRecord.status:                PRESENT | ABSENT | UNPAID_LEAVE | PAID_LEAVE | HOLIDAY | HALF_DAY
//   LeaveType.status:                       ACTIVE | INACTIVE
//   LeaveRequest.status:                    PENDING | APPROVED | REJECTED | CANCELLED
//   PaymentBatch.status:                    PENDING | EXPORTED | PAID | REVERSED
//   PaymentBatch.method:                    BANK | MOBILE_MONEY | CASH | MIXED
//   PaymentInstruction.status:              PENDING | PAID

model User {
  id                String    @id @default(cuid())
  name              String
  email             String    @unique
  password          String
  role              String
  outletId          String?
  outlet            Outlet?   @relation(fields: [outletId], references: [id])
  isActive          Boolean   @default(true)
  // Forgot-password flow: a hashed, single-use token with a short expiry.
  // Never store the raw token — only its SHA-256 hash (see lib/auth.ts).
  resetToken        String?   @unique
  resetTokenExpiry  DateTime?
  // Streamlined MyPOS staff login: WAITER accounts sign in by tapping their
  // name and entering a short numeric PIN instead of email+password. `pin`
  // is a bcrypt hash (same as `password`), never the raw digits. `position`
  // is the floor role shown on the picker tile (OUTSIDE STAFF | BAR LADY |
  // VIP BAR) — informational only, not enforced by the system.
  pin               String?
  position          String?
  pinFailedAttempts Int       @default(0)
  pinLockedUntil    DateTime?
  // Casual/temporary worker (event day labour, outlet cover) — a real User
  // record so scheduling/event-assignment logic works unchanged, but excluded
  // from auto-rostering and from the permanent staff list by default.
  isCasual          Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  dailyCollections    DailyCollection[]
  signedBills         SignedBill[]
  paidBills           PaidBill[]
  auditLogs           AuditLog[]
  posOrders           PosOrder[]
  posWaiterSessions   PosWaiterSession[]
  scheduleAssignments ScheduleAssignment[]
  unavailabilities    StaffUnavailability[]
  eventStaff          EventStaff[]
  pushSubscriptions   PushSubscription[]
  permissions         UserPermission[]
  excessRefunds       ExcessRefund[]

  collectionSessionsCreated   CollectionSession[]     @relation("CollectionSessionCreatedBy")
  collectionSessionsCompleted CollectionSession[]     @relation("CollectionSessionCompletedBy")
  stageRecordsCompleted       CollectionStageRecord[] @relation("StageRecordCompletedBy")
  stageRecordsApproved        CollectionStageRecord[] @relation("StageRecordApprovedBy")
  approvalsRequested          WorkflowApproval[]      @relation("ApprovalRequestedBy")
  approvalsToApprove          WorkflowApproval[]      @relation("ApprovalApprover")

  transactionSessionsCreated   TransactionSession[] @relation("TxSessionCreatedBy")
  transactionSessionsValidated TransactionSession[] @relation("TxSessionValidatedBy")
  systemSalesRecords           SystemSalesRecord[]  @relation("SystemSalesStaff")
  staffTransactions            StaffTransaction[]   @relation("StaffTransactionStaff")

  businessDayUnlockRequestsMade     BusinessDayUnlockRequest[] @relation("BusinessDayUnlockRequestedBy")
  businessDayUnlockRequestsApproved BusinessDayUnlockRequest[] @relation("BusinessDayUnlockApprover")
  notifications                     Notification[]
}

/// Per-user, per-resource grant of Add/Edit/Delete(/Settle/Unsettle for
/// EXCESS_RECON), set only by the system owner (see lib/rbac.ts). Additive on
/// top of existing role/email checks — the owner always has full access
/// regardless of rows here. canSettle/canUnsettle are only meaningful for the
/// EXCESS_RECON resource; other resources leave them false/unused.
model UserPermission {
  id          String   @id @default(cuid())
  userId      String
  resource    String // 'PAID_BILLS' | 'SIGNED_BILLS' | 'PERSONS' | 'PRODUCTS' | 'EXCESS_RECON'
  canAdd      Boolean  @default(false)
  canEdit     Boolean  @default(false)
  canDelete   Boolean  @default(false)
  canSettle   Boolean  @default(false)
  canUnsettle Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, resource])
}

/// A browser's Web Push subscription for one user's device. Lets the server
/// send a real OS-level notification (works even if the tab is backgrounded
/// or closed) -- used for "order ready to collect" alerts on MyPos, where an
/// in-page beep is unreliable once a phone's tab isn't the active one.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

// Minimal tenant concept above Outlet — structural prep for eventual resale to
// other businesses. Does NOT enforce tenant isolation on its own (auth/session
// stay outlet-scoped as before); it only lets Collection Templates be scoped
// per business instead of being global. See prisma/schema.prisma Company
// section notes alongside CollectionTemplate below.
model Company {
  id        String   @id @default(cuid())
  name      String   @unique
  legalName String?
  tin       String?
  vrn       String?
  createdAt DateTime @default(now())

  outlets             Outlet[]
  collectionTemplates CollectionTemplate[]

  accounts               Account[]
  financialPeriods       FinancialPeriod[]
  journalEntries         JournalEntry[]
  supplierInvoices       SupplierInvoice[]
  supplierPayments       SupplierPayment[]
  grns                   Grn[]
  companyPaymentAccounts CompanyPaymentAccount[]
  bankTransactions       BankTransaction[]
  budgets                Budget[]

  reconciliationStages         ReconciliationStage[]
  paymentVerifications         PaymentVerification[]
  paymentIntegrationConnectors PaymentIntegrationConnector[]
  writeOffRequests             WriteOffRequest[]

  creditPolicies CreditPolicy[]
  creditGroups   CreditGroup[]
  creditAccounts CreditAccount[]

  requestTypes      RequestType[]
  expenseCategories ExpenseCategory[]
  fundingSources    FundingSource[]
  expenseRequests   ExpenseRequest[]
}

model Outlet {
  id                String              @id @default(cuid())
  name              String              @unique
  location          String?
  isActive          Boolean             @default(true)
  companyId         String?
  company           Company?            @relation(fields: [companyId], references: [id])
  // The template used when no session-specific template is chosen for a new
  // Daily Collection at this outlet. Nullable/optional even after backfill —
  // absence means "fall back to the fixed DailyCollection form unchanged".
  defaultTemplateId String?
  defaultTemplate   CollectionTemplate? @relation("OutletDefaultTemplate", fields: [defaultTemplateId], references: [id])
  // Events-only outlets (e.g. "Tips Events") are NOT included in the automatic
  // weekly roster — staff are only assigned temporarily when an event is created.
  isEventsOnly      Boolean             @default(false)
  // Printed-bill header details (company legal name + tax IDs). Shown on the
  // customer/in-house bill; the outlet name appears in parentheses beside them.
  legalName         String?
  tin               String?
  vrn               String?
  // Optional code backing the BRANCH_CODE/COMPANY_CODE bill-reference
  // components (see lib/bill-reference.ts). Falls back to a slugified
  // Outlet.name when unset.
  branchCode        String?
  createdAt         DateTime            @default(now())

  users                  User[]
  dailyCollections       DailyCollection[]
  signedBills            SignedBill[]
  paidBills              PaidBill[]
  companyPaymentAccounts CompanyPaymentAccount[]
  budgets                Budget[]
  posTables              PosTable[]
  posShifts              PosShift[]
  posCounters            PosCounter[]
  posStockRequests       PosStockRequest[]
  stockLevels            StockLevel[]
  stockTransfers         StockTransfer[]
  posOrders              PosOrder[]
  posBlockedItems        PosBlockedItem[]
  dayClosures            DayClosure[]
  salesMetrics           SalesMetric[]
  salesImports           SalesImport[]
  scheduleAssignments    ScheduleAssignment[]
  scheduleConfig         OutletScheduleConfig?
  events                 Event[]
  excessRefunds          ExcessRefund[]
  salesTargets           SalesTarget[]
  collectionSessions     CollectionSession[]
  transactionSessions    TransactionSession[]
  businessSessions       BusinessSession[]
  businessDays           BusinessDay[]

  reconciliationStages ReconciliationStage[]
  paymentVerifications PaymentVerification[]
  priceLists           PriceList[]
  dailyReports         DailyReport[]
}

/// Uploaded per-staff sales figures that the POS/collections don't capture
/// directly — Shisha (count) for Mikocheni and Food (TZS) for Coco. Used to
/// measure actuals against the Targets.
model SalesMetric {
  id          String   @id @default(cuid())
  date        DateTime
  outletId    String?
  outlet      Outlet?  @relation(fields: [outletId], references: [id])
  department  String // SHISHA | FOOD
  staffName   String
  value       Float    @default(0) // shisha count, or food sales amount (TZS)
  createdById String?
  createdAt   DateTime @default(now())

  @@index([date])
  @@index([department])
  @@index([outletId])
}

/// Admin-managed sales/KPI targets — replaces the old hard-coded TARGETS
/// array in lib/targets.ts. weeklyTarget stores a 7-day figure; daily/monthly
/// levels derive from it (see lib/targets.ts targetLevels). Seeded once with
/// the previous hard-coded values on first read (see lib/sales-targets.ts).
///   scope: Per Staff | Per Outlet | Per Manager
///   unit:  TZS (currency) | COUNT (unitLabel names the thing counted)
model SalesTarget {
  id           String   @id @default(cuid())
  outletId     String
  outlet       Outlet   @relation(fields: [outletId], references: [id])
  scope        String
  department   String // e.g. "Total Collection", "Shisha Sales", "Food Sales"
  unit         String   @default("TZS")
  unitLabel    String? // e.g. "shisha" when unit = COUNT
  weeklyTarget Float    @default(0)
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([outletId])
  @@index([isActive])
}

/// Locks an uploaded sales day (outlet + department + date) so its SalesMetric
/// rows can't be deleted/re-uploaded. Any uploader can lock; only an Admin
/// (super user) can unlock.
model SalesMetricLock {
  id         String   @id @default(cuid())
  outletId   String?
  department String
  date       DateTime
  lockedBy   String
  lockedById String?
  lockedAt   DateTime @default(now())

  @@unique([outletId, department, date])
  @@index([department])
}

// ─── Sales Import Center ─────────────────────────────────────────────────────
// A generic, category-agnostic import pipeline that replaces the old
// Shisha/Food-only "Upload Sales" flow. Raw POS exports (e.g. the
// "$Attendant Sales In Details" sheet: Attendant | Item Name | Qty | Amount)
// are captured at item level, cleaned/validated/mapped to master data, and only
// feed SalesMetric + analytics once APPROVED. See lib/sales-import.ts.

/// One import batch moving through Upload → Clean → Validate → Map → Preview →
/// Approval → Import. Only status IMPORTED writes SalesMetric / feeds analytics.
model SalesImport {
  id                String    @id @default(cuid())
  companyId         String?
  outletId          String?
  outlet            Outlet?   @relation(fields: [outletId], references: [id])
  // Sales context used by the Price List Engine to resolve the expected price
  // (alongside outlet + line date). Optional.
  eventId           String?
  customerGroupId   String?
  fileName          String
  sourceLabel       String? // e.g. the sheet title / "FROM …" period text
  periodFrom        DateTime?
  periodTo          DateTime?
  status            String    @default("PENDING_APPROVAL") // DRAFT | PENDING_APPROVAL | APPROVED | REJECTED | IMPORTED
  rowCount          Int       @default(0)
  totalQty          Float     @default(0)
  totalAmount       Float     @default(0)
  unmatchedStaff    Int       @default(0)
  unmatchedProducts Int       @default(0)
  priceExceptions   Int       @default(0) // lines whose unit price != the active price-list price
  createdById       String?
  createdByName     String?
  approvedById      String?
  approvedByName    String?
  approvedAt        DateTime?
  rejectedReason    String?
  importedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  lines SalesImportLine[]

  @@index([outletId])
  @@index([status])
  @@index([createdAt])
}

/// One item-level line of a SalesImport — the granular record product analytics
/// is built from. Raw uploaded values are preserved alongside the resolved
/// master-data matches for a full audit trail.
model SalesImportLine {
  id                   String      @id @default(cuid())
  importId             String
  import               SalesImport @relation(fields: [importId], references: [id], onDelete: Cascade)
  date                 DateTime
  outletId             String?
  rawStaffName         String
  staffName            String // resolved canonical staff name (raw if unmatched)
  staffMatched         Boolean     @default(false)
  rawProductName       String
  productId            String?
  productName          String // resolved product name (raw if unmatched)
  productMatched       Boolean     @default(false)
  categoryId           String?
  categoryName         String?
  qty                  Float       @default(0)
  amount               Float       @default(0)
  unitPriceUploaded    Float?
  unitPriceMaster      Float? // expected unit price from the Price List Engine at import time
  priceListId          String? // which price list supplied the expected price (null = product fallback)
  priceMismatch        Boolean     @default(false)
  issues               String? // JSON array of data-quality flags
  // When a later import is approved for the same (outlet, day), the prior
  // import's lines for that day are superseded so analytics never double-counts
  // a re-imported day. Superseded lines are excluded from all BI reads.
  superseded           Boolean     @default(false)
  supersededByImportId String?
  createdAt            DateTime    @default(now())

  @@index([importId])
  @@index([date])
  @@index([productId])
  @@index([superseded])
}

/// Remembered staff-name mapping: a raw uploaded attendant name → canonical
/// staff. Populated when an import is approved so future imports auto-match.
/// companyId defaults to "" (single-company / global) so the unique key holds
/// on both SQLite and Postgres (NULLs would defeat the constraint).
model SalesStaffAlias {
  id          String   @id @default(cuid())
  companyId   String   @default("")
  alias       String // normalized raw name (uppercased, whitespace-collapsed)
  staffName   String // canonical Person/collections name
  personId    String?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([companyId, alias])
  @@index([alias])
}

/// Remembered product-name mapping: a raw uploaded item name → catalogue
/// Product. Populated on approval so future imports auto-match.
model SalesProductAlias {
  id          String   @id @default(cuid())
  companyId   String   @default("")
  alias       String // normalized raw item name
  productId   String
  productName String
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([companyId, alias])
  @@index([alias])
}

// ─── Configurable Price List Engine ──────────────────────────────────────────
// One product, many prices. Product master holds no selling price of its own in
// the end state; during the safe phased cutover Product.sellingPrice seeds the
// auto-created "Default" price list and acts as the resolver's last-resort
// fallback. Resolution priority (Event > Outlet > Customer Group > Default) is
// configurable via the Setting key PRICE_RESOLUTION_ORDER. See lib/pricing.ts.

/// A pricing segment (e.g. VIP, Corporate, Staff) that prices can target.
model CustomerGroup {
  id          String   @id @default(cuid())
  companyId   String?
  name        String
  code        String?
  isActive    Boolean  @default(true)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  priceLists PriceList[]
  promotions Promotion[]
  persons    Person[]

  @@index([isActive])
}

/// A named, scoped, time-bounded collection of product prices. Scope is any
/// combination of outlet/event/customerGroup (all null = the Default list).
model PriceList {
  id              String         @id @default(cuid())
  companyId       String?
  name            String
  description     String?
  outletId        String?
  outlet          Outlet?        @relation(fields: [outletId], references: [id])
  eventId         String?
  event           Event?         @relation(fields: [eventId], references: [id])
  customerGroupId String?
  customerGroup   CustomerGroup? @relation(fields: [customerGroupId], references: [id])
  currency        String         @default("TZS")
  effectiveFrom   DateTime?
  effectiveTo     DateTime?
  status          String         @default("ACTIVE") // ACTIVE | INACTIVE | PENDING_APPROVAL | REJECTED
  priority        Int            @default(0) // tie-break within the same scope class; higher wins
  isDefault       Boolean        @default(false) // the base list seeded from Product.sellingPrice
  approvedById    String?
  approvedByName  String?
  approvedAt      DateTime?
  createdById     String?
  createdByName   String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  items PriceListItem[]

  @@index([status])
  @@index([outletId])
  @@index([eventId])
  @@index([customerGroupId])
  @@index([isDefault])
}

/// One product's price within a price list. A product may appear in many lists.
model PriceListItem {
  id           String    @id @default(cuid())
  priceListId  String
  priceList    PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  productId    String
  product      Product   @relation(fields: [productId], references: [id])
  sellingPrice Float
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([priceListId, productId])
  @@index([productId])
}

/// Immutable log of every price change, so price history is preserved even as
/// list items are edited.
model PriceChangeLog {
  id            String   @id @default(cuid())
  priceListId   String
  priceListName String?
  productId     String
  productName   String?
  oldPrice      Float?
  newPrice      Float
  action        String   @default("UPDATE") // CREATE | UPDATE | DELETE
  changedById   String?
  changedByName String?
  reason        String?
  createdAt     DateTime @default(now())

  @@index([productId])
  @@index([priceListId])
  @@index([createdAt])
}

/// Promotions are kept separate from price lists and apply AFTER the selling
/// price is resolved. type drives which fields matter.
model Promotion {
  id              String         @id @default(cuid())
  companyId       String?
  name            String
  type            String // PERCENTAGE | FIXED | BUY_X_GET_Y | BUNDLE
  value           Float          @default(0) // PERCENTAGE: 0-100 | FIXED: amount off
  outletId        String?
  eventId         String?
  customerGroupId String?
  customerGroup   CustomerGroup? @relation(fields: [customerGroupId], references: [id])
  productId       String? // target a single product (line promos, BUY_X_GET_Y)
  categoryId      String? // or a whole category
  buyQty          Float? // BUY_X_GET_Y
  getQty          Float?
  bundleConfig    String? // BUNDLE: JSON [{productId, qty}]
  bundlePrice     Float? // BUNDLE: total price for the bundle
  effectiveFrom   DateTime?
  effectiveTo     DateTime?
  status          String         @default("ACTIVE") // ACTIVE | INACTIVE
  priority        Int            @default(0)
  createdById     String?
  createdByName   String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([status])
  @@index([productId])
  @@index([categoryId])
}

/// A cashier's saved Daily Report for an outlet+day. Can be saved as a DRAFT
/// (partial, editable) even while imported sales are still pending approval.
/// When those imports are later approved the draft is flagged needsReview so the
/// cashier re-checks and FINALIZES. Only FINALIZED reports are authoritative for
/// reconciliation / finance / reports / BI. `data` is the JSON snapshot at save.
model DailyReport {
  id              String    @id @default(cuid())
  outletId        String
  outlet          Outlet    @relation(fields: [outletId], references: [id])
  date            DateTime
  status          String    @default("DRAFT") // DRAFT | FINALIZED
  data            String? // JSON snapshot of the computed report at save/finalize
  notes           String?
  needsReview     Boolean   @default(false) // underlying sales changed after last save
  reviewReason    String?
  savedById       String?
  savedByName     String?
  finalizedById   String?
  finalizedByName String?
  finalizedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([outletId, date])
  @@index([status])
}

/// Locks a single outlet's day. Once a (outlet, date) is closed, cashiers can no
/// longer create/edit/delete that day's collections. Reopening is supervisor-only.
/// Superseded by BusinessDay below as the authoritative status; kept in sync
/// (upsert on close, delete on reopen) by lib/business-day.ts for any legacy
/// reader that still queries this table directly.
model DayClosure {
  id         String   @id @default(cuid())
  outletId   String
  outlet     Outlet   @relation(fields: [outletId], references: [id])
  date       DateTime
  closedBy   String
  closedById String?
  closedAt   DateTime @default(now())

  @@unique([outletId, date])
  @@index([outletId])
}

// ─── Business Day Exception Management ─────────────────────────────────────
// Full status lifecycle for a business day (per Outlet+Date, matching
// DailyCollection/CashRecon/DayClosure grain — PosShift/PosCounter remain
// informational breakdown only, never separate lockable units), automatic
// missing-data detection on close, a request→approve→reopen→submit→auto-lock
// workflow for non-management roles, an immutable audit trail, and
// configurable (non-hardcoded) role/user permissions. See
// lib/business-day.ts for the resolver/mutator functions.
//   BusinessDay.status:               OPEN | CLOSED | REOPENED | ARCHIVED
//   BusinessDayUnlockRequest.status:  PENDING | APPROVED | REJECTED | COMPLETED | EXPIRED
//   BusinessDayUnlockRequest.requestedDuration: 15m | 30m | 1h | CUSTOM
//   BusinessDayAuditLog.action:       CLOSE | REOPEN | LOCK | UNLOCK_REQUESTED |
//                                     UNLOCK_APPROVED | UNLOCK_REJECTED | UNLOCK_EXPIRED |
//                                     AUTO_LOCK | ARCHIVE | ALLOW_INCOMPLETE_CLOSE
//   Notification.type: MISSING_DATA_DETECTED | UNLOCK_REQUESTED | UNLOCK_APPROVED |
//                       UNLOCK_REJECTED | UNLOCK_EXPIRED | DAY_REOPENED
//   BusinessDayPolicyConfig.scope:    GLOBAL | COMPANY | OUTLET (narrowest wins, same
//                                     shape as CollectionModeConfig/BusinessCalendarConfig)
model BusinessDay {
  id             String    @id @default(cuid())
  outletId       String
  outlet         Outlet    @relation(fields: [outletId], references: [id])
  date           DateTime
  status         String    @default("OPEN")
  isComplete     Boolean   @default(true)
  missingItems   String? // JSON array of {type, label, shift?, counter?} — informational only
  closedById     String?
  closedByName   String?
  closedAt       DateTime?
  reopenedById   String?
  reopenedByName String?
  reopenedAt     DateTime?
  reopenReason   String?
  lockExpiresAt  DateTime? // set when reopened with a duration; lazily checked, see checkAndAutoLock
  archivedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  unlockRequests BusinessDayUnlockRequest[]
  auditLogs      BusinessDayAuditLog[]

  @@unique([outletId, date])
  @@index([outletId, status])
  @@index([date])
}

/// Request → Approval → Reopen → Submit → Auto-Lock workflow for roles that
/// cannot unlock directly. Kept separate from WorkflowApproval — that model
/// has no duration/expiry fields and is scoped to the Collection Workflow Engine.
model BusinessDayUnlockRequest {
  id                String      @id @default(cuid())
  businessDayId     String
  businessDay       BusinessDay @relation(fields: [businessDayId], references: [id])
  requestedById     String
  requestedBy       User        @relation("BusinessDayUnlockRequestedBy", fields: [requestedById], references: [id])
  reason            String
  scopeShift        String? // optional informational PosShift.name filter
  scopeCounter      String? // optional informational PosCounter.code filter
  requestedDuration String? // "15m" | "30m" | "1h" | "CUSTOM"
  requestedMinutes  Int?
  status            String      @default("PENDING")
  approverId        String?
  approver          User?       @relation("BusinessDayUnlockApprover", fields: [approverId], references: [id])
  approverComment   String?
  resolvedAt        DateTime?
  completedAt       DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([businessDayId, status])
  @@index([requestedById])
}

/// Immutable field-diff + approval audit trail for BusinessDay actions.
/// INSERT-ONLY by convention — no update/delete API route is ever added for
/// this model (SQLite has no trigger to enforce it; this is a code-review
/// invariant, not a DB constraint).
model BusinessDayAuditLog {
  id             String      @id @default(cuid())
  businessDayId  String
  businessDay    BusinessDay @relation(fields: [businessDayId], references: [id])
  action         String
  field          String?
  previousValue  String?
  newValue       String?
  reason         String?
  approvedById   String?
  approvedByName String?
  userId         String?
  userName       String?
  createdAt      DateTime    @default(now())

  @@index([businessDayId, createdAt])
  @@index([action])
}

/// Role-level permission default (resource + boolean) — resolved as a
/// per-user UserPermission override (if present for that resource) > this
/// role default > deny. See lib/rbac.ts resolveResourcePermission().
model RolePermission {
  id        String   @id @default(cuid())
  role      String
  resource  String
  allowed   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([role, resource])
}

/// Generic in-app notification — bell/list UI, hooked into
/// lib/pendingBellEvents.ts's notifyNotificationsChanged() for live refresh.
model Notification {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       String
  title      String
  message    String
  entityType String?
  entityId   String?
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([userId, read])
  @@index([createdAt])
}

/// Configurable "block close on missing data" / "who can approve unlocks"
/// policy — same GLOBAL→COMPANY→OUTLET scope+scopeId shape as
/// BusinessCalendarConfig/CollectionModeConfig, narrowest wins.
model BusinessDayPolicyConfig {
  id                   String   @id @default(cuid())
  scope                String
  scopeId              String?
  blockCloseOnMissing  Boolean  @default(true)
  approverRoles        String? // JSON array of role strings; null = fall back to APPROVE_UNLOCK holders
  defaultUnlockMinutes Int      @default(30)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([scope, scopeId])
}

model DailyCollection {
  id               String   @id @default(cuid())
  date             DateTime @default(now())
  cash             Float    @default(0)
  crdb             Float    @default(0)
  stanbic          Float    @default(0)
  mpesa            Float    @default(0)
  total            Float    @default(0)
  staffName        String?
  systemSales      Float    @default(0)
  creditSales      Float    @default(0)
  paymentsReceived Float    @default(0)
  discount         Float    @default(0) // authorized discount — reduces staff loss
  discountReason   String?
  notes            String?
  outletId         String
  outlet           Outlet   @relation(fields: [outletId], references: [id])
  cashierId        String
  cashier          User     @relation(fields: [cashierId], references: [id])
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  cancellations Cancellation[]
  channels      DailyCollectionChannel[]
  excessItems   CollectionExcess[]

  @@index([date])
  @@index([outletId])
}

// Per-channel amounts for a Daily Collection — lets Setup > Payment Channels
// add new digital channels (e.g. "CRDB Lipa Hapa") without a code change.
// The fixed crdb/stanbic/mpesa columns above are still dual-written for the
// 3 default channels so older read paths keep working unmodified; readers
// that want the full dynamic list should prefer these rows, falling back to
// the fixed columns only when a collection has none (pre-migration rows).
model DailyCollectionChannel {
  id           String          @id @default(cuid())
  collectionId String
  collection   DailyCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  channelCode  String // matches PaymentChannel.code (CRDB, STANBIC, MPESA, CRDB_LIPA_HAPA, ...)
  amount       Float           @default(0)
  createdAt    DateTime        @default(now())

  @@unique([collectionId, channelCode])
  @@index([collectionId])
}

// ─── Collection Workflow Engine ──────────────────────────────────────────────
// Configurable Collection Templates: businesses define how a "collection" is
// entered (stages → sections → fields) without a code change. The
// DailyCollection/DailyCollectionChannel/Cancellation/CollectionExcess models
// above are NOT replaced — the seeded "Standard Staff Collection" template
// describes that exact fixed-column workflow as metadata only, and its data
// keeps living in those typed columns. Only templates built via the future
// Template Designer store their values in CollectionFieldValue below.

model CollectionTemplate {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  code        String   @unique
  name        String
  description String?
  isDefault   Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  stages            CollectionStage[]
  validationRules   CollectionValidationRule[]
  sessions          CollectionSession[]
  defaultForOutlets Outlet[]                   @relation("OutletDefaultTemplate")

  @@index([companyId])
}

model CollectionStage {
  id         String             @id @default(cuid())
  templateId String
  template   CollectionTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  key        String
  label      String
  order      Int                @default(0)
  isOptional Boolean            @default(false)
  entryMode  String             @default("SINGLE_STAFF")
  isActive   Boolean            @default(true)

  sections CollectionSection[]
  records  CollectionStageRecord[]

  @@unique([templateId, key])
  @@index([templateId])
}

// key identifies the reusable section TYPE (SALES, PAYMENT_CHANNELS, BILLS,
// DISCOUNTS, CANCELLATIONS, EXCESS, CASH_RECON, REMARKS, ATTACHMENTS, ...).
model CollectionSection {
  id          String          @id @default(cuid())
  stageId     String
  stage       CollectionStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  key         String
  label       String
  order       Int             @default(0)
  isMandatory Boolean         @default(false)
  isActive    Boolean         @default(true)

  fields CollectionField[]

  @@unique([stageId, key])
  @@index([stageId])
}

model CollectionField {
  id         String            @id @default(cuid())
  sectionId  String
  section    CollectionSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  key        String
  label      String
  fieldType  String
  order      Int               @default(0)
  isRequired Boolean           @default(false)
  config     String? // JSON: select options, min/max, etc.

  values CollectionFieldValue[]

  @@unique([sectionId, key])
  @@index([sectionId])
}

model CollectionValidationRule {
  id         String             @id @default(cuid())
  templateId String
  template   CollectionTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  ruleType   String
  config     String? // JSON parameters for the rule (e.g. {"limit": 50000})
  isActive   Boolean            @default(true)

  @@index([templateId])
}

model CollectionSession {
  id            String             @id @default(cuid())
  date          DateTime           @default(now())
  outletId      String
  outlet        Outlet             @relation(fields: [outletId], references: [id])
  templateId    String
  template      CollectionTemplate @relation(fields: [templateId], references: [id])
  status        String             @default("OPEN")
  createdById   String
  createdBy     User               @relation("CollectionSessionCreatedBy", fields: [createdById], references: [id])
  completedById String?
  completedBy   User?              @relation("CollectionSessionCompletedBy", fields: [completedById], references: [id])
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  stageRecords CollectionStageRecord[]

  @@unique([outletId, date, templateId])
  @@index([outletId, date])
}

model CollectionStageRecord {
  id            String            @id @default(cuid())
  sessionId     String
  session       CollectionSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  stageId       String
  stage         CollectionStage   @relation(fields: [stageId], references: [id])
  status        String            @default("PENDING")
  staffId       String?
  staffName     String?
  completedAt   DateTime?
  completedById String?
  completedBy   User?             @relation("StageRecordCompletedBy", fields: [completedById], references: [id])
  approvedById  String?
  approvedBy    User?             @relation("StageRecordApprovedBy", fields: [approvedById], references: [id])
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  fieldValues CollectionFieldValue[]
  approvals   WorkflowApproval[]

  @@index([sessionId])
  @@index([stageId])
}

model CollectionFieldValue {
  id            String                @id @default(cuid())
  stageRecordId String
  stageRecord   CollectionStageRecord @relation(fields: [stageRecordId], references: [id], onDelete: Cascade)
  fieldId       String
  field         CollectionField       @relation(fields: [fieldId], references: [id])
  value         String?

  @@unique([stageRecordId, fieldId])
  @@index([stageRecordId])
}

// stageRecordId and transactionId are mutually exclusive — a WorkflowApproval
// resolves either a Collection Workflow Engine stage record OR a Transaction
// Management StaffTransaction, never both. Kept as one table (rather than a
// second parallel approvals model) so /api/collection-approvals and its
// notifyApprovers push pipeline serve both without duplication.
model WorkflowApproval {
  id               String                 @id @default(cuid())
  stageRecordId    String?
  stageRecord      CollectionStageRecord? @relation(fields: [stageRecordId], references: [id], onDelete: Cascade)
  transactionId    String?
  transaction      StaffTransaction?      @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  // Universal Expense & Disbursement Framework bridge (additive, nullable —
  // see docs/expense-disbursement-framework-design.md). Reuses this same
  // approve/reject/comment machinery for ExpenseRequest approvals instead of
  // forking a parallel approval table.
  expenseRequestId String?
  expenseRequest   ExpenseRequest?        @relation(fields: [expenseRequestId], references: [id], onDelete: Cascade)
  requestedById    String
  requestedBy      User                   @relation("ApprovalRequestedBy", fields: [requestedById], references: [id])
  approverRole     String?
  approverId       String?
  approver         User?                  @relation("ApprovalApprover", fields: [approverId], references: [id])
  status           String                 @default("PENDING")
  comment          String?
  createdAt        DateTime               @default(now())
  resolvedAt       DateTime?

  @@index([stageRecordId])
  @@index([transactionId])
  @@index([expenseRequestId])
}

// ─── Collection Mode Engine ─────────────────────────────────────────────────
// Which collection workflow (Default fixed-form cashier collection,
// Transaction Verification self-declare-and-validate, or HYBRID — both
// active at once for the same outlet, split per role via a ROLE-scope
// override, e.g. WAITER self-declares while CASHIER still enters other staff
// directly) applies for a given user session — resolved at read time, not
// hardcoded. A single generic scope+scopeId table (rather than a
// `collectionMode` column bolted onto User/Outlet/Company) so new scopes
// (Department, Business Unit, ...) can be added later purely by
// configuration, with no schema change and no code change to the resolver's
// shape — only lib/collection-mode.ts's priority list needs to grow.
// Resolution order (most specific wins), see lib/collection-mode.ts
// resolveCollectionMode(): ROLE > OUTLET > COMPANY > GLOBAL, falling all the
// way back to DEFAULT if no config row exists at any level — so a business
// that never opens this settings page gets exactly today's fixed-form
// behavior, unchanged, with zero setup.
//   CollectionModeConfig.scope: GLOBAL | COMPANY | OUTLET | ROLE
//   CollectionModeConfig.mode:  DEFAULT | TRANSACTION_VERIFICATION | HYBRID
model CollectionModeConfig {
  id        String   @id @default(cuid())
  scope     String
  // Null only for GLOBAL. Otherwise: a Company.id, Outlet.id, or a role
  // string (CASHIER|WAITER|...) depending on `scope` — not a single FK
  // since it names a different table per scope.
  scopeId   String?
  mode      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([scope, scopeId])
}

// ─── Business Calendar Engine ──────────────────────────────────────────────
// Single source of truth for "business date" (vs. calendar date), business
// week, and financial year across every module — replacing the flat, global
// companyConfig.businessDayCutoverHour (lib/company-config-shared.ts) with a
// scoped resolver identical in shape to CollectionModeConfig above: GLOBAL ->
// COMPANY -> OUTLET, narrowest wins, falling back to a hardcoded default
// (05:00 cutover, Africa/Dar_es_Salaam, week starts Monday, FY = calendar
// year) if no row exists at any level — so an unconfigured deployment behaves
// exactly as the app always has. See docs/business-calendar-engine.md.
//   BusinessCalendarConfig.scope: GLOBAL | COMPANY | OUTLET
model BusinessCalendarConfig {
  id      String  @id @default(cuid())
  scope   String
  // Null only for GLOBAL; otherwise a Company.id or Outlet.id depending on scope.
  scopeId String?

  // Preset the admin picked (still fully editable after) — RETAIL | RESTAURANT
  // | BAR | HOTEL_24H | MANUFACTURING | OFFICE | CUSTOM.
  templateName String @default("CUSTOM")

  // "HH:mm" — the business day rolls over at businessDayStartTime; a calendar
  // timestamp before it on a given calendar date belongs to the PREVIOUS
  // business date. businessDayEndTime is informational (end of the trading
  // window, spans midnight when earlier than start) — shift templates use it
  // for validation, the date cutover only needs the start time.
  businessDayStartTime String @default("05:00")
  businessDayEndTime   String @default("05:00")

  timeZone     String @default("Africa/Dar_es_Salaam")
  weekStartDay Int    @default(1) // 0=Sunday .. 6=Saturday
  fyStartMonth Int    @default(1) // 1-12
  fyStartDay   Int    @default(1) // 1-31

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([scope, scopeId])
}

// A time-boxed override of one or more BusinessCalendarConfig fields for a
// specific date range (e.g. New Year's Eve hours) — expires automatically
// once `endDate` is in the past; never mutates the underlying config row.
model BusinessCalendarOverride {
  id      String  @id @default(cuid())
  scope   String
  scopeId String?

  startDate DateTime
  endDate   DateTime

  businessDayStartTime String?
  businessDayEndTime   String?

  reason    String?
  createdBy String?
  createdAt DateTime @default(now())

  @@index([scope, scopeId, startDate, endDate])
}

// Named sub-windows inside a business day (e.g. Morning 09:00-16:00, Evening
// 16:00-05:00) — independent of the day cutover above; unlimited per scope.
model ShiftTemplate {
  id      String  @id @default(cuid())
  scope   String
  scopeId String?

  name      String
  startTime String // "HH:mm"
  endTime   String // "HH:mm"
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([scope, scopeId])
}

model BusinessCalendarAuditLog {
  id            String   @id @default(cuid())
  scope         String
  scopeId       String?
  field         String
  previousValue String?
  newValue      String?
  reason        String?
  userId        String?
  userName      String?
  createdAt     DateTime @default(now())

  @@index([scope, scopeId, createdAt])
}

// ─── Business Period cycles (effective-dated, versioned) ───────────────────
// The four configurable MONTHLY cycles that sit on top of the day/week/FY
// engine above: Business Month (operational reporting), Financial Month
// (accounting), Payroll Period, and Credit Cycle. Each cycle is defined by a
// single START DAY; the end day is always derived (day before the next start),
// which makes overlaps/gaps structurally impossible.
//
// Unlike BusinessCalendarConfig (one row per scope), these are VERSIONED: each
// save inserts a new row stamped with `effectiveDate`. Resolving the cycles for
// any date picks, per scope, the newest version with effectiveDate <= that date
// — so re-running an old month's report reproduces the grouping that was in
// force then (historical-accuracy requirement #6). Scope resolution is the same
// GLOBAL -> COMPANY -> OUTLET, narrowest-wins chain as BusinessCalendarConfig.
// Zero rows anywhere ⇒ hardcoded default of start day 1 everywhere = plain
// calendar months, identical to pre-engine grouping. Field math + validation
// live in lib/business-periods-shared.ts; the resolver in lib/business-periods.ts.
model BusinessPeriodVersion {
  id            String   @id @default(cuid())
  scope         String // GLOBAL | COMPANY | OUTLET
  scopeId       String? // null only for GLOBAL; else Company.id or Outlet.id
  effectiveDate DateTime // this version applies to dates on/after this day

  presetName String @default("CUSTOM") // CALENDAR | MID_MONTH_25 | CUSTOM

  // Business Month — operational/sales/inventory/KPI reporting month.
  businessMonthStartDay Int @default(1) // 1-31 (clamped per month)

  // Financial Month — accounting period month (financial YEAR start still lives
  // on BusinessCalendarConfig.fyStartMonth/fyStartDay).
  financialMonthStartDay Int @default(1)

  // Payroll Period — settlement events are day-of-month in the month AFTER the
  // period's start month (e.g. period 25 Jun→24 Jul ⇒ processing/pay in July).
  payrollStartDay      Int @default(1)
  payrollProcessingDay Int @default(1)
  payrollPaymentDay    Int @default(1)
  payrollLockDay       Int @default(1)

  // Credit Cycle — resetDay defaults to the cycle start; graceDays extends the
  // due window past the cycle end before a balance is overdue.
  creditStartDay  Int @default(1)
  creditResetDay  Int @default(1)
  creditGraceDays Int @default(0)

  reason        String?
  createdBy     String?
  createdByName String?
  createdAt     DateTime @default(now())

  @@index([scope, scopeId, effectiveDate])
}

// ─── Transaction Management (staff self-declared transactions) ─────────────
// Simplified layer in front of DailyCollection: the cashier only imports the
// daily System Sales report (defines the expected staff roster); each service
// staff self-declares the payments they personally received; transactions
// needing sign-off (signed bills, discounts, cancellations, credit sales) go
// through the same WorkflowApproval pipeline the Collection Workflow Engine
// already uses. Once the cashier validates a staff's summarized totals, that
// data is written into a DailyCollection row and continues through the
// existing, unchanged collection workflow (Close Day, Reporting, Finance
// Posting, Audit Trail, Bank Reconciliation).
//   TransactionSession.status:     OPEN | VALIDATED | CLOSED
//   StaffTransaction.category:     PAYMENT | SIGNED_BILL | DISCOUNT | CANCELLATION | CREDIT_SALE
//   StaffTransaction.paymentMethod: CASH | CRDB | STANBIC | MPESA | ... (matches PaymentChannel.code)
//   StaffTransaction.status:       DECLARED | PENDING_APPROVAL | APPROVED | REJECTED

model TransactionSession {
  id            String    @id @default(cuid())
  date          DateTime  @default(now())
  outletId      String
  outlet        Outlet    @relation(fields: [outletId], references: [id])
  status        String    @default("OPEN")
  createdById   String
  createdBy     User      @relation("TxSessionCreatedBy", fields: [createdById], references: [id])
  validatedById String?
  validatedBy   User?     @relation("TxSessionValidatedBy", fields: [validatedById], references: [id])
  validatedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  systemSales  SystemSalesRecord[]
  transactions StaffTransaction[]

  @@unique([outletId, date])
  @@index([outletId, date])
}

/// One row per staff from the cashier's uploaded daily System Sales report —
/// this both sets each staff's "expected sales" figure and creates the
/// official roster of staff expected to declare transactions this session.
model SystemSalesRecord {
  id        String             @id @default(cuid())
  sessionId String
  session   TransactionSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  staffId   String?
  staff     User?              @relation("SystemSalesStaff", fields: [staffId], references: [id])
  staffName String
  amount    Float              @default(0)
  createdAt DateTime           @default(now())

  @@unique([sessionId, staffName])
  @@index([sessionId])
}

/// A single payment a service staff personally received, self-declared. The
/// cashier's dashboard groups and totals these by paymentMethod +
/// receivingAccount per staff — never manually calculated.
model StaffTransaction {
  id               String             @id @default(cuid())
  sessionId        String
  session          TransactionSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  staffId          String
  staff            User               @relation("StaffTransactionStaff", fields: [staffId], references: [id])
  category         String             @default("PAYMENT")
  paymentMethod    String?
  amount           Float
  receivingAccount String?
  reference        String?
  // The customer/payer name — required for SIGNED_BILL (a payment collected
  // today against a bill signed earlier, allocated via lib/payment-alloc.ts)
  // and CREDIT_SALE (a brand-new signed bill issued today). Validating turns
  // these into real SignedBill/PaidBill rows instead of a plain sum.
  personName       String?
  status           String             @default("DECLARED")
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  approvals WorkflowApproval[]

  @@index([sessionId])
  @@index([staffId])
  @@index([status])
}

// ─── Business Intelligence Layer ────────────────────────────────────────────
// One standardized row per completed staff/outlet/day business session,
// regardless of which Collection Mode produced it (DEFAULT or
// TRANSACTION_VERIFICATION — see lib/collection-mode.ts). Written by
// lib/business-session.ts's syncBusinessSession() from a finalized
// DailyCollection row only — it never special-cases collection mode, since a
// validated TransactionSession is itself flattened into DailyCollection first
// (see TransactionSession comment above). This is the single source dashboards
// and reports should read from instead of re-aggregating DailyCollection
// directly. staffName (not staffId) is the natural key both source paths
// converge on, so the upsert is idempotent regardless of mode.
model BusinessSession {
  id                 String   @id @default(cuid())
  date               DateTime
  companyId          String?
  outletId           String
  outlet             Outlet   @relation(fields: [outletId], references: [id])
  staffId            String?
  staffName          String
  collectionMode     String // DEFAULT | TRANSACTION_VERIFICATION — informational only
  sourceCollectionId String?
  sourceSessionId    String?

  systemSales          Float     @default(0)
  officialCollection   Float     @default(0)
  cash                 Float     @default(0)
  bank                 Float     @default(0)
  mobileMoney          Float     @default(0)
  signedBillsTotal     Float     @default(0)
  paidBillsTotal       Float     @default(0)
  discounts            Float     @default(0)
  cancellations        Float     @default(0)
  collectionDifference Float     @default(0)
  dailyLoss            Float     @default(0)
  customerCount        Int?
  transactionCount     Int       @default(0)
  avgTransactionValue  Float     @default(0)
  salesTarget          Float?
  validationTime       DateTime?
  approvalTime         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([outletId, date, staffName])
  @@index([companyId, date])
  @@index([outletId, date])
  @@index([staffId])
}

model Person {
  id          String   @id @default(cuid())
  name        String
  phone       String?
  email       String?
  type        String
  creditLimit Float    @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  // Bill Reference System — the "Person Code/Number" component (see
  // lib/bill-reference.ts). codeMode governs how `code` was/should be
  // populated: AUTO (assigned by the shared sequence engine) | MANUAL |
  // EMPLOYEE_NUMBER | CUSTOMER_NUMBER | MEMBERSHIP_NUMBER | SUPPLIER_CODE.
  // Scoped unique per `type` (not globally) so e.g. customer #14 and staff
  // #14 can coexist without forcing one to skip ahead.
  code     String?
  codeMode String  @default("AUTO")

  // Optional pricing segment — lets the Price List Engine resolve a
  // customer-group-specific selling price (see lib/pricing.ts).
  customerGroupId String?
  customerGroup   CustomerGroup? @relation(fields: [customerGroupId], references: [id])

  signedBills   SignedBill[]
  paidBills     PaidBill[]
  excessRefunds ExcessRefund[]

  // Universal Credit Framework: optional 1:1 credit account (the debtor record).
  creditAccount CreditAccount?

  // Universal Payroll Framework: optional 1:1 employee record. Person is the
  // identity master a compensation record binds to (same 1:1-over-Person move
  // CreditAccount makes). Nullable — most Persons (customers) are not employees.
  employee Employee?

  @@unique([type, code])
  @@index([type])
  @@index([customerGroupId])
}

model SignedBill {
  id             String    @id @default(cuid())
  date           DateTime  @default(now())
  // Legacy voucher — kept (not dropped) because it's overloaded today as a
  // deterministic idempotency key for auto-generated bills (see
  // lib/staff-loss.ts, app/api/collections/route.ts). New auto-created bills
  // use `autoKey` for that role instead; `voucherNumber` becomes read-only
  // legacy/display data once a bill has been migrated (see legacyReference).
  voucherNumber  String?   @unique
  // Idempotency key for auto-generated bills (e.g. "SL-<collectionId>",
  // "VCH-<collectionId>-<i>") — replaces voucherNumber's old lookup role.
  autoKey        String?   @unique
  billType       String
  personId       String?
  person         Person?   @relation(fields: [personId], references: [id])
  personName     String
  amount         Float
  serviceStaff   String?
  description    String?
  dueDate        DateTime?
  status         String    @default("UNPAID") // UNPAID | PARTIAL | PAID | WRITTEN_OFF
  approvalStatus String    @default("PENDING") // PENDING | APPROVED | REJECTED (used for Tips/DJ bill requests)
  approvedBy     String?
  outletId       String
  outlet         Outlet    @relation(fields: [outletId], references: [id])
  cashierId      String
  cashier        User      @relation(fields: [cashierId], references: [id])
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  // Finance Platform (Stage 2 — Accounts Receivable): set once the credit
  // sale is posted to the GL (Dr Accounts Receivable / Cr Sales Revenue) —
  // see lib/finance-ar.ts postCreditSale(). Doubles as the idempotency guard
  // against double-posting (e.g. an approve action firing twice). Only ever
  // set for CREDIT_BILL_TYPES (lib/bill-types.ts) once approvalGate() passes
  // — never for STAFF_LOSS, and never before a request-type bill is approved.
  journalEntryId String?

  writeOffs SignedBillWriteOff[]

  // Bill Reference System (see lib/bill-reference.ts). internalBillId is the
  // permanent, never-changing system id ("B-YYYYMMDD-NNNNNN");
  // displayReference is the admin-configurable, human-facing reference.
  // Nullable until the one-time backfill (scripts/backfill-bill-references.ts
  // / the Bill Reference Settings page's Data Migration panel) completes in
  // each environment, then tightened to NOT NULL in a follow-up deploy.
  // legacyReference preserves the old voucherNumber value verbatim so an
  // already-printed paper bill stays searchable after migration.
  internalBillId         String?         @unique
  displayReference       String?         @unique
  legacyReference        String?
  billTypeConfigId       String?
  billTypeConfig         BillTypeConfig? @relation(fields: [billTypeConfigId], references: [id])
  // Replaces the fragile `voucherNumber.startsWith('SL-')` string-parse
  // (see app/api/reports/excess-loss/route.ts) with an explicit column.
  autoSourceCollectionId String?

  payments PaidBill[]
  items    BillItem[]

  // Universal Credit Framework (Phase 1 bridge) — nullable/additive. New bills
  // may tag the resolved credit group + debtor account; existing bills keep
  // classifying via billType/legacyBillTypeCode until backfilled.
  creditGroupId   String?
  creditGroup     CreditGroup?   @relation(fields: [creditGroupId], references: [id])
  creditAccountId String?
  creditAccount   CreditAccount? @relation(fields: [creditAccountId], references: [id])

  @@index([date])
  @@index([billType])
  @@index([status])
  @@index([outletId])
  @@index([personId])
  @@index([creditGroupId])
  @@index([creditAccountId])
}

// Product line items on a signed bill (Customer / Tips / DJ etc.).
model BillItem {
  id           String     @id @default(cuid())
  signedBillId String
  signedBill   SignedBill @relation(fields: [signedBillId], references: [id], onDelete: Cascade)
  productId    String?
  product      Product?   @relation(fields: [productId], references: [id])
  productName  String
  unitPrice    Float      @default(0)
  quantity     Float      @default(0)
  amount       Float      @default(0) // unitPrice * quantity
  createdAt    DateTime   @default(now())

  @@index([signedBillId])
  @@index([productId])
}

model PaidBill {
  id             String      @id @default(cuid())
  date           DateTime    @default(now())
  // Free-text/correlation field — NOT the Bill Reference System's reference.
  // Also doubles as a correlation key ("COL-<collectionId>",
  // "PAYROLL-<periodLabel>") and a report-grouping key
  // (app/api/reports/daily-cashier/route.ts) — left untouched by design.
  billRef        String?
  signedBillId   String?
  signedBill     SignedBill? @relation(fields: [signedBillId], references: [id])
  personId       String?
  person         Person?     @relation(fields: [personId], references: [id])
  payerCategory  String?
  payerName      String
  amountPaid     Float
  paymentMethod  String
  notes          String?
  outletId       String
  outlet         Outlet      @relation(fields: [outletId], references: [id])
  cashierId      String
  cashier        User        @relation(fields: [cashierId], references: [id])
  createdAt      DateTime    @default(now())
  // Finance Platform (Stage 2): set when this receipt is posted to the GL
  // (Dr Cash/Bank / Cr Accounts Receivable) — see lib/finance-ar.ts
  // postReceipt(). Only set when signedBillId resolves to a CREDIT_BILL_TYPES
  // bill; left null for unlinked/unallocated credits (no receivable to
  // clear against yet).
  journalEntryId String?

  // Bill Reference System (see lib/bill-reference.ts / SignedBill above).
  internalBillId   String?         @unique
  displayReference String?         @unique
  legacyReference  String?
  billTypeConfigId String?
  billTypeConfig   BillTypeConfig? @relation(fields: [billTypeConfigId], references: [id])

  @@index([date])
  @@index([outletId])
  @@index([signedBillId])
}

model PettyCash {
  id            String   @id @default(cuid())
  date          DateTime @default(now())
  requestedBy   String
  department    String?
  functionName  String? // e.g. Purchases of | Allowance | Transport
  purpose       String
  amount        Float    @default(0)
  paymentMethod String // CASH | CRDB | STANBIC | MPESA (actual disbursement method)
  payeeName     String?
  payeeAccount  String?
  paymentStatus String?  @default("UNPAID") // PAID | UNPAID — has the cash actually been paid out
  approvedBy    String?
  status        String   @default("PENDING") // PENDING | APPROVED | REJECTED
  outletId      String?
  cashierId     String
  createdAt     DateTime @default(now())

  // Payment module — which fund disburses and the disbursement record.
  pettyType  String    @default("CASHIER") // CASHIER (drawer) | ACCOUNTANT (allocated fund)
  fundId     String? // set when paid from an accountant PettyFund
  paidAt     DateTime?
  paidById   String?
  paidByName String?
  receiptUrl String? // payment receipt (image/pdf data URL or link)

  // Universal Expense & Disbursement Framework bridge (additive, nullable —
  // see docs/expense-disbursement-framework-design.md). Set only once this
  // request's flow has been migrated onto an ExpenseRequest RequestType;
  // null (the default) means this row is still served by the legacy
  // PettyCash screens, unchanged.
  expenseRequestId String?
  expenseRequest   ExpenseRequest? @relation(fields: [expenseRequestId], references: [id])

  items PettyCashItem[]

  @@index([date])
  @@index([status])
  @@index([paymentStatus])
  @@index([pettyType])
  @@index([expenseRequestId])
}

// A management-allocated petty-cash fund operated by an Accountant. Payments
// against approved requests draw down this fund; replenishments top it up.
model PettyFund {
  id             String    @id @default(cuid())
  name           String // e.g. "Accountant Fund — HQ"
  ownerId        String? // accountant who operates the fund
  ownerName      String?
  outletId       String?
  openingBalance Float     @default(0)
  depositDate    DateTime? // date the petty cash was deposited/allocated
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())

  txns PettyFundTxn[]

  @@index([outletId])
}

// Every movement on a PettyFund. amount is signed: + adds (opening/replenish),
// - reduces (payment/adjustment). currentBalance = openingBalance + sum(amount).
model PettyFundTxn {
  id            String    @id @default(cuid())
  fundId        String
  fund          PettyFund @relation(fields: [fundId], references: [id], onDelete: Cascade)
  type          String // REPLENISH | PAYMENT | ADJUST
  amount        Float // signed delta
  pettyCashId   String? // links a PAYMENT to the request it settled
  note          String?
  createdById   String?
  createdByName String?
  createdAt     DateTime  @default(now())

  @@index([fundId])
  @@index([pettyCashId])
}

/// Optional line-item breakdown of a cash request (Detail · Unit · Unit Cost · Total).
/// A request with no items is a simple single-amount request.
model PettyCashItem {
  id          String    @id @default(cuid())
  pettyCashId String
  pettyCash   PettyCash @relation(fields: [pettyCashId], references: [id], onDelete: Cascade)
  detail      String
  unit        Float     @default(1)
  unitCost    Float     @default(0)
  amount      Float     @default(0)
  createdAt   DateTime  @default(now())

  @@index([pettyCashId])
}

// Departments selectable on the cash-request form (managed in /departments).
model Department {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  budgets Budget[]
}

// Functions selectable on the cash-request form (e.g. Purchases of, Allowance, Transport).
model PettyFunction {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

// Product catalogue (managed in /products).
model Product {
  id              String           @id @default(cuid())
  code            String           @unique // auto-generated, human-readable e.g. COC-001
  name            String
  // Legacy free-text category — kept (not dropped) so any reader that hasn't
  // migrated to categoryId still sees a value; scripts/backfill-product-categories.ts
  // is the one-time migration from this string to a real ProductCategory row.
  category        String? // e.g. "Beers", "Spirits", "Soft Drinks"
  categoryId      String?
  productCategory ProductCategory? @relation(fields: [categoryId], references: [id])
  buyingPrice     Float            @default(0)
  sellingPrice    Float            @default(0)
  unitMeasure     String // unit | kg | crate 24 bottle | crate 25 bottle | crate 6 bottle
  isActive        Boolean          @default(true)
  // Counter stock tracking (see StockLevel/StockLedgerEntry below). WEIGHT
  // items (e.g. shisha flavours) are counted in grams; gramsPerServing
  // converts a gram reading into sellable servings, same conversion the
  // business already does by hand on paper stock-take sheets.
  trackingMode    String           @default("UNIT") // UNIT | WEIGHT
  gramsPerServing Float?
  createdAt       DateTime         @default(now())

  cancellations       Cancellation[]
  billItems           BillItem[]
  posOrderItems       PosOrderItem[]
  posBlockedItems     PosBlockedItem[]
  stockLevels         StockLevel[]
  grnItems            GrnItem[]
  stockTransferItems  StockTransferItem[]
  purchaseOrderItems  PurchaseOrderItem[]
  eventProducts       EventProduct[]
  cancellationReasons CancellationReasonProduct[]
  priceListItems      PriceListItem[]

  @@index([name])
  @@index([categoryId])
}

/// Admin-managed product category (managed under Setup → Product Categories).
/// Replaces Product.category's free-text string as the source of truth —
/// see the backfill note on Product.category above.
model ProductCategory {
  id        String   @id @default(cuid())
  code      String   @unique
  label     String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  products                     Product[]
  cancellationReasonCategories CancellationReasonCategory[]
}

/// A central stock location that is not a POS counter — e.g. "Main Store".
/// Kept as its own table (not a hardcoded constant) so a future second
/// warehouse needs no schema change. Single row today.
model Warehouse {
  id        String   @id @default(cuid())
  name      String   @unique // "Main Store"
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  stockLevels   StockLevel[]
  ledgerEntries StockLedgerEntry[]
  grns          Grn[]
  transfersOut  StockTransfer[]
}

/// Current quantity of one product at one location — pieces, or grams when
/// the product's trackingMode is WEIGHT. A row only exists once someone has
/// restocked/received/transferred that product to that location at least
/// once: tracking is opt-in, not pre-created for every Product×Counter×
/// Outlet combination, most of which nobody stocks there.
/// Exactly one of (outletId+counterCode) or warehouseId is set on any given
/// row — never both, never neither — enforced at the application layer in
/// lib/stock.ts, not by the schema.
model StockLevel {
  id          String     @id @default(cuid())
  productId   String
  product     Product    @relation(fields: [productId], references: [id])
  outletId    String?
  outlet      Outlet?    @relation(fields: [outletId], references: [id])
  counterCode String? // MAIN | VIP | SHISHA | KITCHEN
  warehouseId String?
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id])
  quantity    Float      @default(0)
  updatedAt   DateTime   @updatedAt

  @@unique([productId, outletId, counterCode, warehouseId])
  @@index([outletId, counterCode])
  @@index([warehouseId])
}

/// Every stock quantity change, ever — mirrors the "never delete, only
/// reverse" audit principle already used for PosOrder/PosOrderItem history.
/// Exactly one of (outletId+counterCode) or warehouseId is set, mirroring
/// StockLevel — an entry always describes a movement at one location.
model StockLedgerEntry {
  id           String     @id @default(cuid())
  productId    String
  productName  String // snapshot, same pattern as PosOrderItem.productName
  outletId     String?
  counterCode  String?
  warehouseId  String?
  warehouse    Warehouse? @relation(fields: [warehouseId], references: [id])
  type         String // RESTOCK | SALE | ADJUSTMENT | GRN_RECEIVE | TRANSFER_OUT | TRANSFER_IN | BREAKAGE
  quantity     Float // signed — negative for sales/deductions/outflows
  balanceAfter Float
  note         String?
  refType      String? // "PosOrderItem" | "Grn" | "StockTransfer"
  refId        String?
  createdById  String
  createdAt    DateTime   @default(now())

  @@index([productId, outletId, counterCode, createdAt])
  @@index([productId, warehouseId, createdAt])
}

/// A vendor TIPS buys from. Price history lives on PurchaseOrderItem, not
/// here, so "cheapest supplier for X" is a query, not a separate table.
model Supplier {
  id            String   @id @default(cuid())
  name          String   @unique
  contactPerson String?
  phone         String?
  email         String?
  paymentTerms  String? // e.g. "30 days", "Cash on delivery"
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  purchaseOrders PurchaseOrder[]
  invoices       SupplierInvoice[]
  payments       SupplierPayment[]
}

/// A Purchase Order to a supplier. status is the workflow engine: DRAFT ->
/// PENDING_APPROVAL -> APPROVED -> SENT -> PARTIALLY_RECEIVED ->
/// FULLY_RECEIVED, with REJECTED/CANCELLED as terminal off-ramps. Approval
/// and receiving are handled in lib/stock.ts (submitForApproval,
/// decidePurchaseOrder, receiveGrn).
model PurchaseOrder {
  id              String    @id @default(cuid())
  poNumber        String    @unique // "PO-000001"
  supplierId      String
  supplier        Supplier  @relation(fields: [supplierId], references: [id])
  status          String    @default("DRAFT")
  outletIds       String // JSON array — informational, a PO can be for more than one outlet
  orderDate       DateTime  @default(now())
  expectedDate    DateTime?
  subtotal        Float     @default(0)
  vatRate         Float     @default(0.18)
  vatAmount       Float     @default(0)
  total           Float     @default(0)
  paymentTerms    String?
  notes           String?
  createdById     String
  approvedById    String?
  approvedAt      DateTime?
  cancelledReason String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  items PurchaseOrderItem[]
  grns  Grn[]

  @@index([status])
  @@index([supplierId])
}

model PurchaseOrderItem {
  id               String        @id @default(cuid())
  purchaseOrderId  String
  purchaseOrder    PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId        String
  product          Product       @relation(fields: [productId], references: [id])
  productName      String // snapshot, same pattern as PosOrderItem.productName
  purchaseUnit     String // "Carton", "Bottle", "Case" — the unit the supplier sells in
  packSize         Float         @default(1) // pieces per purchase unit
  quantity         Float // quantity in purchaseUnit, e.g. 10 cartons
  unitPrice        Float
  amount           Float
  quantityReceived Float         @default(0) // running total across all GRNs against this line, in purchaseUnit

  @@index([purchaseOrderId])
}

/// A no-PO, free-form goods-received note — records physical receipt of
/// stock into a Warehouse. Supplier is plain text when there's no PO;
/// purchaseOrderId links it to a formal PO instead when receiving against
/// one. One Grn creates one GRN_RECEIVE ledger entry per line and bumps
/// Main Store StockLevel in a single transaction (see lib/stock.ts
/// receiveGrn).
model Grn {
  id              String         @id @default(cuid())
  grnNumber       String         @unique // "GRN-000123"
  warehouseId     String
  warehouse       Warehouse      @relation(fields: [warehouseId], references: [id])
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  supplierName    String
  invoiceRef      String?
  receivedDate    DateTime       @default(now())
  note            String?
  createdById     String
  createdAt       DateTime       @default(now())
  // Finance Platform (Phase 1): companyId is derived at receipt time in
  // receiveGrn() (from the linked PO's outlet, else the default company) so
  // the accrual journal entry can be posted per-company. needsCosting is set
  // when no unitCost/PO price was available on any line — the physical
  // receipt is never blocked, but the GRN surfaces in Finance's "Unposted
  // GRNs" list until someone supplies a cost and it can be posted.
  companyId       String?
  company         Company?       @relation(fields: [companyId], references: [id])
  needsCosting    Boolean        @default(false)
  journalEntryId  String?

  items            GrnItem[]
  supplierInvoices SupplierInvoice[]

  @@index([warehouseId])
  @@index([receivedDate])
  @@index([purchaseOrderId])
  @@index([companyId])
}

/// One line of a Grn. Quantity is entered in a purchase unit (e.g.
/// "Carton") with a packSize (pieces/grams per unit); piecesReceived is the
/// derived, persisted total actually added to stock — same conversion
/// principle as Product.trackingMode/gramsPerServing on the sell side.
/// purchaseOrderItemId is a loose id link (like StockLedgerEntry.refId),
/// not a FK relation, since not every GrnItem receives against a PO line.
model GrnItem {
  id                  String   @id @default(cuid())
  grnId               String
  grn                 Grn      @relation(fields: [grnId], references: [id], onDelete: Cascade)
  purchaseOrderItemId String?
  productId           String
  product             Product  @relation(fields: [productId], references: [id])
  productName         String // snapshot, same convention as StockLedgerEntry.productName
  purchaseUnit        String // e.g. "Carton", "Piece", "Kg"
  packSize            Float    @default(1) // pieces (or grams) per purchaseUnit
  quantityOrdered     Float // quantity in purchaseUnit, e.g. 10 (Cartons)
  piecesReceived      Float // derived: quantityOrdered * packSize, in stock units
  unitCost            Float? // optional, per purchaseUnit — not used by stock math
  createdAt           DateTime @default(now())

  @@index([grnId])
  @@index([productId])
}

/// A single atomic Main Store -> Outlet Counter stock movement, issued by a
/// manager in one action (no separate request/approve/issue steps in this
/// phase — see lib/stock.ts issueTransfer). Always warehouse -> counter;
/// never the reverse (no returns) and never warehouse -> warehouse.
model StockTransfer {
  id             String    @id @default(cuid())
  transferNumber String    @unique // "TRF-000045"
  warehouseId    String
  warehouse      Warehouse @relation(fields: [warehouseId], references: [id])
  outletId       String
  outlet         Outlet    @relation(fields: [outletId], references: [id])
  counterCode    String
  note           String?
  createdById    String
  createdAt      DateTime  @default(now())

  items StockTransferItem[]

  @@index([warehouseId])
  @@index([outletId, counterCode])
}

model StockTransferItem {
  id          String        @id @default(cuid())
  transferId  String
  transfer    StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  productId   String
  product     Product       @relation(fields: [productId], references: [id])
  productName String
  quantity    Float // stock units (pieces/grams) — no pack conversion here
  createdAt   DateTime      @default(now())

  @@index([transferId])
  @@index([productId])
}

/// A physical stock count, comparing what the ledger says should be there
/// against what's actually counted — the loop automatic stock tracking
/// alone can't close (spillage/theft/breakage that never shows up as a
/// recorded sale). Single-step: counted and submitted in one action, no
/// separate review step (see lib/stock.ts submitStockCount). scope
/// distinguishes a daily counter count (outletId+counterCode set) from a
/// monthly Main Store count (warehouseId set) — exactly one of the two is
/// set per row, same convention StockLevel already uses.
model StockCountSession {
  id             String   @id @default(cuid())
  scope          String   @default("COUNTER_DAILY") // COUNTER_DAILY | STORE_MONTHLY
  outletId       String?
  counterCode    String?
  warehouseId    String?
  countDate      DateTime @default(now())
  status         String   @default("IN_PROGRESS") // IN_PROGRESS | SUBMITTED
  conductedById  String
  totalLossValue Float    @default(0)
  createdAt      DateTime @default(now())

  items        StockCountItem[]
  attributions StockLossAttribution[]

  @@index([outletId, counterCode])
  @@index([warehouseId])
  @@index([countDate])
}

/// One product's line in a count. Replays the real stock-take workbook's
/// own columns: B/F + Receivings + TransfersIn − TransfersOut =
/// Closing(System); vs. Closing(Physical) gives ExpectedSales; vs. actual
/// POS sales gives the variance — see lib/stock.ts's reconciliation math.
model StockCountItem {
  id               String            @id @default(cuid())
  sessionId        String
  session          StockCountSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  productId        String
  productName      String // snapshot
  openingBalance   Float
  receivings       Float             @default(0)
  transfersIn      Float             @default(0)
  transfersOut     Float             @default(0) // always 0 today — no counter→store returns yet
  closingSystem    Float // = opening + receivings + transfersIn − transfersOut
  closingPhysical  Float             @default(0) // the actual count — units, or grams if trackingMode=WEIGHT
  posSalesQty      Float             @default(0) // pulled from the SALE ledger entries in the same window
  expectedSalesQty Float             @default(0) // = closingSystem − closingPhysical
  varianceQty      Float             @default(0) // = posSalesQty − expectedSalesQty
  unitCost         Float // Product.buyingPrice at count time
  varianceValue    Float             @default(0) // = (varianceQty − discountQty − breakageQty) * unitCost
  discountQty      Float             @default(0) // authorised discounts, excluded from "loss"
  breakageQty      Float             @default(0)

  @@index([sessionId])
  @@index([productId])
}

/// The workbook's staff loss table, made structural — free-form
/// accountability, not an enforced reconciliation (amounts don't have to
/// sum to the session's totalLossValue).
model StockLossAttribution {
  id        String            @id @default(cuid())
  sessionId String
  session   StockCountSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  staffId   String
  staffName String // snapshot
  amount    Float
  note      String?
  createdAt DateTime          @default(now())

  @@index([sessionId])
}

/// A breakage/expiry/damage report — deducts stock immediately and gives
/// loss an explained reason the moment it happens, rather than waiting for
/// the next stock count to notice it. Exactly one location (counter or
/// warehouse) is set per row, same convention as StockLevel.
model Breakage {
  id           String   @id @default(cuid())
  productId    String
  productName  String // snapshot
  quantity     Float
  reason       String // BROKEN | EXPIRED | DAMAGED | LOST
  outletId     String?
  counterCode  String?
  warehouseId  String?
  unitCost     Float
  valueLost    Float
  photoUrl     String?
  note         String?
  reportedById String
  createdAt    DateTime @default(now())

  // Bill Reference System — Breakage plays the "Loss Record" (LOS) bill
  // type (see lib/bill-reference.ts).
  internalBillId   String?         @unique
  displayReference String?         @unique
  billTypeConfigId String?
  billTypeConfig   BillTypeConfig? @relation(fields: [billTypeConfigId], references: [id])

  @@index([outletId, counterCode])
  @@index([warehouseId])
  @@index([createdAt])
}

// Cancellations recorded against a daily collection (Double Punch / Out of Stock / Wrong Punch).
model Cancellation {
  id           String           @id @default(cuid())
  date         DateTime         @default(now())
  collectionId String?
  collection   DailyCollection? @relation(fields: [collectionId], references: [id])
  reason       String // Double Punch | Out of Stock | Wrong Punch
  staffName    String? // set directly for standalone requests (collection ones use collection.staffName)
  productId    String?
  product      Product?         @relation(fields: [productId], references: [id])
  productName  String
  sellingPrice Float            @default(0)
  quantity     Float            @default(0)
  amount       Float            @default(0) // sellingPrice * quantity
  status       String           @default("PENDING") // PENDING | APPROVED | REJECTED
  approvedBy   String?
  outletId     String?
  cashierId    String
  createdAt    DateTime         @default(now())

  @@index([collectionId])
  @@index([date])
  @@index([status])
}

model CashRecon {
  id               String   @id @default(cuid())
  date             DateTime @default(now())
  outletId         String?
  openingBalance   Float    @default(0) // auto = previous day's closing
  cashDeposited    Float    @default(0)
  excessAmountPaid Float    @default(0) // sum of excessItems; reduces cash balance the same way cashDeposited does
  closingBalance   Float    @default(0) // computed & stored so next day can auto-open
  verifiedAmount   Float? // physical cash verified by an officer
  verifiedBy       String?
  variance         Float? // verifiedAmount − closingBalance once verified: >0 = cash over, <0 = short (null = not yet verified)
  varianceClass    String? // RECEIVABLE (short) | PAYABLE (over→refundable) | ADJUSTMENT (investigate) — classification of the over/short
  notes            String?
  cashierId        String
  createdAt        DateTime @default(now())

  excessItems CashReconExcess[]

  @@index([date])
  @@index([outletId])
}

// One line item of "excess amount paid" within a day's cash reconciliation —
// a day can have several, each with its own reason and (if applicable)
// staff/customer. CashRecon.excessAmountPaid stores their sum for fast reads.
model CashReconExcess {
  id                    String    @id @default(cuid())
  cashReconId           String
  cashRecon             CashRecon @relation(fields: [cashReconId], references: [id], onDelete: Cascade)
  amount                Float
  reason                String // KITCHEN_SALES | STAFF_TIP | CUSTOMER_EXCESS | OTHERS | SIGNED_BILL | CANCELLATION | DISCOUNT | COMPLIMENTARY | CUSTOMER_WALK_AWAY | TRANSFER_ERROR | UNASSIGNED
  category              String    @default("NON_PAYABLE") // PAYABLE_EXCESS | NON_PAYABLE | STAFF_LOSS — snapshot of ExcessReason.category at creation time
  accountingClass       String? // RECEIVABLE | PAYABLE | ADJUSTMENT — snapshot of the accounting class at creation (see lib/reconciliation-classification.ts)
  notes                 String? // optional free-text explanation entered alongside the reason
  channelCode           String? // payment channel auto-inherited from the parent DailyCollection/CashRecon, no re-entry
  staffId               String? // set when reason = STAFF_TIP
  staffName             String?
  personId              String? // set when reason = CUSTOMER_EXCESS (Person, type=CUSTOMER)
  personName            String?
  paidAmount            Float     @default(0) // settled via Excess Recon; balance = amount - paidAmount. Always 0 here — D10 blocks settling a CASH_RECON row directly (already disbursed at recon time)
  paidAt                DateTime? // when the most recent payment was recorded (Excess Payment §5's "Paid Date")
  settledAsSourceAmount Float     @default(0) // portion of THIS row's own amount that the auto-settlement engine (lib/excess-settlement.ts) has redirected to pay down older outstanding CollectionExcess rows of the same reason, instead of standing as its own new balance. Excess Recon's displayed paid/balance for this row folds this in (paid = paidAmount + settledAsSourceAmount).
  createdAt             DateTime  @default(now())

  // Bill Reference System — plays the "Excess Payment" (EXS) bill type
  // alongside CollectionExcess (see lib/bill-reference.ts).
  internalBillId   String?         @unique
  displayReference String?         @unique
  billTypeConfigId String?
  billTypeConfig   BillTypeConfig? @relation(fields: [billTypeConfigId], references: [id])

  @@index([cashReconId])
}

// Excess recorded during a Daily Collection (staff collected more than the
// formula required). A collection can have several — mirrors CashReconExcess's
// shape/cardinality so Excess Recon can merge both sources into a single
// Paid/Balance ledger.
model CollectionExcess {
  id              String          @id @default(cuid())
  collectionId    String
  collection      DailyCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  amount          Float
  reason          String // KITCHEN_SALES | STAFF_TIP | CUSTOMER_EXCESS | OTHERS | SIGNED_BILL | CANCELLATION | DISCOUNT | COMPLIMENTARY | CUSTOMER_WALK_AWAY | TRANSFER_ERROR | UNASSIGNED
  category        String          @default("NON_PAYABLE") // PAYABLE_EXCESS | NON_PAYABLE | STAFF_LOSS — snapshot of ExcessReason.category at creation time
  accountingClass String? // RECEIVABLE | PAYABLE | ADJUSTMENT — snapshot of the accounting class at creation (see lib/reconciliation-classification.ts)
  notes           String? // optional free-text explanation entered alongside the reason
  channelCode     String? // payment channel auto-inherited from the parent DailyCollection, no re-entry
  staffId         String? // set when reason = STAFF_TIP
  staffName       String?
  personId        String? // set when reason = CUSTOMER_EXCESS (Person, type=CUSTOMER)
  personName      String?
  paidAmount      Float           @default(0) // settled via Excess Recon; balance = amount - paidAmount
  paidAt          DateTime? // when the most recent payment was recorded (Excess Payment §5's "Paid Date")
  createdAt       DateTime        @default(now())

  // Bill Reference System — plays the "Excess Payment" (EXS) bill type
  // alongside CashReconExcess (see lib/bill-reference.ts).
  internalBillId   String?         @unique
  displayReference String?         @unique
  billTypeConfigId String?
  billTypeConfig   BillTypeConfig? @relation(fields: [billTypeConfigId], references: [id])

  @@index([collectionId])
}

// Digital Payment Reconciliation — one row per digital channel per day+outlet.
model BankRecon {
  id              String   @id @default(cuid())
  date            DateTime @default(now())
  outletId        String?
  channel         String? // digital channel code (CRDB | STANBIC | MPESA | …); null = legacy total
  reportedAmount  Float    @default(0) // auto: collections + paid bills for this channel (system "collected")
  openingBalance  Float? // account opening balance (cashier)
  closingBalance  Float? // account closing balance (cashier) — required = closing − opening
  verifiedAmount  Float? // verified collected amount by an officer (null = not yet verified)
  verifiedOpening Float? // opening balance verified by an officer
  verifiedClosing Float? // closing balance verified by an officer
  reason          String? // reason for variance
  reportedBy      String?
  verifiedBy      String?
  cashierId       String
  createdAt       DateTime @default(now())

  @@index([date])
  @@index([outletId])
}

model Setting {
  key   String  @id
  value String?
}

// Configurable person/bill categories (managed under Persons). code is the
// canonical key used as Person.type / SignedBill.billType; label is for display.
model PersonCategory {
  id        String   @id @default(cuid())
  code      String   @unique
  label     String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

// Configurable payment channels (managed under Outlets). Used by Paid Bills,
// Petty Cash, and Daily Collections amount boxes (see DailyCollectionChannel).
model PaymentChannel {
  id          String   @id @default(cuid())
  code        String   @unique
  label       String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  // Finance Platform (Stage 1): a simple, single default GL Cash/Bank/
  // Mobile-Money account for this channel — kept as the fallback for a
  // business that never sets up Company Payment Accounts (Stage 3). Once a
  // channel has one or more CompanyPaymentAccount rows, that account's
  // default row wins over this field (see lib/finance-mapping.ts
  // resolveChannelAccountId's cascade).
  glAccountId String?
  glAccount   Account? @relation(fields: [glAccountId], references: [id])

  supplierPayments SupplierPayment[]
  companyAccounts  CompanyPaymentAccount[]
}

// Configurable cancellation reasons (managed under Setup). Cancellation.reason
// stores the label as free text — this table only drives the picker options.
model CancellationReason {
  id           String   @id @default(cuid())
  code         String   @unique
  label        String
  isActive     Boolean  @default(true)
  // true (the default) = this reason is offered for every product, exactly
  // today's behavior. When false, it's only offered for the specifically
  // mapped categories/products below — an admin opt-in, not a regression.
  appliesToAll Boolean  @default(true)
  createdAt    DateTime @default(now())

  categories CancellationReasonCategory[]
  products   CancellationReasonProduct[]
}

/// Restricts a CancellationReason (with appliesToAll = false) to one product category.
model CancellationReasonCategory {
  id         String             @id @default(cuid())
  reasonId   String
  reason     CancellationReason @relation(fields: [reasonId], references: [id], onDelete: Cascade)
  categoryId String
  category   ProductCategory    @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([reasonId, categoryId])
  @@index([categoryId])
}

/// Restricts a CancellationReason (with appliesToAll = false) to one specific product.
model CancellationReasonProduct {
  id        String             @id @default(cuid())
  reasonId  String
  reason    CancellationReason @relation(fields: [reasonId], references: [id], onDelete: Cascade)
  productId String
  product   Product            @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([reasonId, productId])
  @@index([productId])
}

/// Reasons for an "excess amount" (Cash Recon / Collections excess pickers).
/// Seeded once with the four defaults (see lib/excess-reasons.ts). Two codes
/// are permanently wired into the picker UI/validation — STAFF_TIP unlocks a
/// staff picker, CUSTOMER_EXCESS a customer picker — that behavior is fixed
/// engine logic and doesn't change if a company renames or adds reasons.
/// Difference Reasons (rebranded from a pure "excess reason" list) — the single
/// admin-configurable registry Collection form/Excess Recon share (see
/// lib/excess-reasons.ts). `category` decides the workflow: PAYABLE_EXCESS
/// creates a CollectionExcess/CashReconExcess record settled via Excess
/// Payment; NON_PAYABLE is audit-only; STAFF_LOSS (single reserved code,
/// like STAFF_TIP/CUSTOMER_EXCESS) drives the existing auto-SignedBill debt
/// path unchanged.
model ExcessReason {
  id                 String   @id @default(cuid())
  code               String   @unique
  label              String
  category           String   @default("NON_PAYABLE") // PAYABLE_EXCESS | NON_PAYABLE | STAFF_LOSS (legacy: also drives form placement)
  accountingClass    String? // RECEIVABLE | PAYABLE | ADJUSTMENT — accounting treatment, derived from code (see lib/reconciliation-classification.ts); drift-proof
  allocationStrategy String   @default("FIFO") // FIFO | LIFO — order the auto-settlement engine (lib/excess-settlement.ts) applies a Cash Recon payment against this reason's outstanding CollectionExcess balances
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
}

// ─── Bill Reference System ───────────────────────────────────────────────────
// A fully configurable, metadata-driven bill-numbering engine (see
// lib/bill-reference.ts). Scope is deliberately limited to "bills": SignedBill,
// PaidBill, CashReconExcess/CollectionExcess (Excess Payment), Breakage (Loss
// Record), and ExcessRefund. PO/GRN/Transfer/Booking/PosOrder numbering is a
// separate, untouched system.
//   BillReferenceConfig.dateFormat:          YYMMDD | DDMMYY | YYYYMMDD | DD-MM-YYYY | MM-YYYY | CUSTOM
//   BillReferenceConfig.separator:           "-" | "/" | "_" | "." | NONE
//   BillReferenceConfig.personNumberingMode: AUTO | MANUAL | EMPLOYEE_NUMBER | CUSTOMER_NUMBER | MEMBERSHIP_NUMBER | SUPPLIER_CODE
//   BillReferenceConfig.sequenceResetRule:   NEVER | DAILY | MONTHLY | YEARLY | PER_PERSON | PER_BILL_TYPE
//   BillReferenceComponent.type:             DATE | BILL_TYPE_CODE | PERSON_CODE | SEQUENCE | COMPANY_CODE | BRANCH_CODE | DEPARTMENT_CODE | COUNTER_CODE | OUTLET_CODE | STATIC_TEXT
//   BillTypeConfig.category:                 SIGNED_BILL | PAID_BILL | EXCESS_PAYMENT | EXCESS_REFUND | LOSS_RECORD

/// Singleton settings row (id is always the literal "default" — enforced by
/// application code, never by end users).
model BillReferenceConfig {
  id                  String   @id @default("default")
  dateFormat          String   @default("YYMMDD")
  customDateFormat    String? // date-fns token string, used when dateFormat = CUSTOM
  separator           String   @default("-")
  numberPadding       Int      @default(3) // 3 -> 001, 4 -> 0001, 5 -> 00001
  personNumberingMode String   @default("AUTO")
  sequenceResetRule   String   @default("NEVER")
  updatedById         String?
  updatedAt           DateTime @updatedAt
  createdAt           DateTime @default(now())

  components BillReferenceComponent[]
}

/// One row per component slot. `order` drives the admin drag-and-drop
/// position; `label` is the admin-renameable display name.
model BillReferenceComponent {
  id          String              @id @default(cuid())
  configId    String              @default("default")
  config      BillReferenceConfig @relation(fields: [configId], references: [id])
  type        String // DATE | BILL_TYPE_CODE | PERSON_CODE | SEQUENCE | COMPANY_CODE | BRANCH_CODE | DEPARTMENT_CODE | COUNTER_CODE | OUTLET_CODE | STATIC_TEXT
  label       String
  order       Int
  isEnabled   Boolean             @default(true)
  staticValue String? // only used when type = STATIC_TEXT
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@unique([configId, type])
  @@index([configId, order])
}

/// The seeded bill types (15 defaults — see lib/bill-reference-defaults.ts).
/// `prefix`/`name` are freely admin-editable. `legacyBillTypeCode` bridges to
/// the OLD SignedBill.billType vocabulary (ADMIN | DIRECTOR | CUSTOMER |
/// STAFF_LOSS | TIPS | DJ) so the one-time backfill can resolve historical rows.
model BillTypeConfig {
  id                 String   @id @default(cuid())
  code               String   @unique // SBA|SBD|SBS|SBC|SBJ|SBT|PBA|PBD|PBS|PBC|PBJ|PBT|EXS|EXR|LOS
  name               String
  prefix             String
  category           String // SIGNED_BILL | PAID_BILL | EXCESS_PAYMENT | EXCESS_REFUND | LOSS_RECORD
  legacyBillTypeCode String? // ADMIN | DIRECTOR | CUSTOMER | STAFF_LOSS | TIPS | DJ | null
  isActive           Boolean  @default(true)
  sortOrder          Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  signedBills        SignedBill[]
  paidBills          PaidBill[]
  cashReconExcesses  CashReconExcess[]
  collectionExcesses CollectionExcess[]
  breakages          Breakage[]
  excessRefunds      ExcessRefund[]
}

/// Generic atomic counter keyed by a single opaque scopeKey string built by
/// lib/bill-reference.ts (e.g. "BT:<billTypeId>:ALL", "BT:<billTypeId>:D:20260716",
/// "INTERNAL:20260716", "PERSONCODE:CUSTOMER"). No FK — the internal-bill-id
/// and person-code counters share this same table via their own scopeKey
/// prefixes, so no fake "bill type" rows are needed for them.
model BillSequenceCounter {
  id        String   @id @default(cuid())
  scopeKey  String   @unique
  lastValue Int      @default(0)
  updatedAt DateTime @updatedAt
}

/// Cross-table registry — every issued reference gets one row here, written
/// in the SAME transaction as the source record. This gives TRUE global
/// uniqueness across all 6 source tables (each also keeps its own @unique as
/// defense-in-depth) and is the single collision point the generation
/// engine's retry loop uses to "auto-advance to the next sequence" on conflict.
model BillReferenceRegistry {
  id               String   @id @default(cuid())
  internalBillId   String   @unique
  displayReference String   @unique
  sourceModel      String // SignedBill | PaidBill | CashReconExcess | CollectionExcess | Breakage | ExcessRefund
  sourceId         String
  billTypeId       String
  createdAt        DateTime @default(now())

  @@index([sourceModel, sourceId])
}

/// Minimal Excess Refund (EXR) record — nothing plays this role today. Mirrors
/// CashReconExcess/CollectionExcess's shape enough to hold a reference and
/// participate in reporting, without their settle-batch machinery (a refund is
/// a one-shot outward payment, not a receivable to collect against).
model ExcessRefund {
  id               String          @id @default(cuid())
  date             DateTime        @default(now())
  internalBillId   String          @unique
  displayReference String          @unique
  billTypeConfigId String?
  billTypeConfig   BillTypeConfig? @relation(fields: [billTypeConfigId], references: [id])
  amount           Float
  personId         String?
  person           Person?         @relation(fields: [personId], references: [id])
  personName       String
  reason           String // OVERPAYMENT | DUPLICATE_PAYMENT | OTHER
  outletId         String
  outlet           Outlet          @relation(fields: [outletId], references: [id])
  refundedById     String
  refundedBy       User            @relation(fields: [refundedById], references: [id])
  approvalStatus   String          @default("PENDING") // PENDING | APPROVED | REJECTED
  approvedBy       String?
  paidAmount       Float           @default(0) // cash actually refunded to the customer; balance = amount − paidAmount (settlement/GL wired in a later phase)
  paidAt           DateTime? // when the refund payout was recorded
  journalEntryId   String? // GL entry posted when the refund is paid (later phase)
  notes            String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([date])
  @@index([outletId])
  @@index([personId])
}

/// Granular settlement ledger for the Excess Recon auto-settlement engine
/// (lib/excess-settlement.ts) and the existing manual Pay/batch-pay routes —
/// one row per allocation of money against a specific outstanding excess row,
/// independent of the free-text AuditLog. sourceType/sourceId identify what
/// funded the allocation (a CashReconExcess payment row, or a manual payment
/// with no backing record); targetType/targetId identify the CollectionExcess
/// (or, for manual settlements only, CashReconExcess) row that got settled.
model ExcessSettlement {
  id          String   @id @default(cuid())
  reason      String
  method      String   @default("AUTO_FIFO") // AUTO_FIFO | AUTO_LIFO | MANUAL
  sourceType  String // CASH_RECON_PAYMENT | MANUAL_PAYMENT
  sourceId    String? // CashReconExcess.id that funded this allocation (null for a manual lump-sum payment with no backing row)
  targetType  String // CASH_RECON | COLLECTION — which ledger the settled row belongs to
  targetId    String // the CashReconExcess/CollectionExcess id that was settled
  amount      Float
  outletId    String?
  createdById String?
  createdAt   DateTime @default(now())

  @@index([sourceId])
  @@index([targetId])
  @@index([reason])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  details   String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entity])
  @@index([createdAt])
}

// ─── MyPos Module ─────────────────────────────────────────────────────────────
// NOTE: Status/type values are enforced at the application layer (no native enums in SQLite).
//   PosOrder.status:      OPEN | SENT | CLOSED | CANCELLED | VOID
//   PosOrderItem.status:  PENDING | SENT | CANCELLED
//   PosShift.name:        KWANZA | PILI | TATU | NNE
//   PosCounter.code:      MAIN | BAR | SHISHA | KITCHEN
//   PosOrderItem.counterCode: MAIN | BAR | SHISHA | KITCHEN

// Physical tables on the venue floor.
model PosTable {
  id        String   @id @default(cuid())
  outletId  String
  outlet    Outlet   @relation(fields: [outletId], references: [id])
  number    Int
  label     String? // e.g. "VIP 1", "Outside 3"
  capacity  Int      @default(4)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  orders PosOrder[]

  @@unique([outletId, number])
  @@index([outletId])
}

// One shift per outlet per day — KWANZA, PILI, TATU, NNE.
model PosShift {
  id       String    @id @default(cuid())
  outletId String
  outlet   Outlet    @relation(fields: [outletId], references: [id])
  name     String // KWANZA | PILI | TATU | NNE
  date     DateTime
  openedAt DateTime  @default(now())
  closedAt DateTime?
  openedBy String // userId
  closedBy String? // userId

  orders         PosOrder[]
  waiterSessions PosWaiterSession[]

  @@index([outletId])
  @@index([date])
}

// One counter/station per outlet (matches the 4-counter setup).
model PosCounter {
  id           String   @id @default(cuid())
  outletId     String
  outlet       Outlet   @relation(fields: [outletId], references: [id])
  code         String // MAIN | BAR | SHISHA | KITCHEN
  label        String // "Main Counter" | "Bar" | "Shisha" | "Kitchen"
  printerName  String? // default printer assigned to this counter
  // PREP   → kitchen/VIP model: items queue at the counter, are prepared, and
  //          the waiter is notified to collect (order goes READY).
  // DIRECT → counter-service model (Main Bar): seller serves immediately, so
  //          sent items skip the queue and are marked PREPARED at once.
  serviceModel String   @default("PREP") // PREP | DIRECT
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@unique([outletId, code])
  @@index([outletId])
}

// One bill per table per visit. Closing it feeds into DailyCollection.
model PosOrder {
  id              String    @id @default(cuid())
  orderNo         String    @unique // ORD-20260619-001
  outletId        String
  outlet          Outlet    @relation(fields: [outletId], references: [id])
  tableId         String?
  table           PosTable? @relation(fields: [tableId], references: [id])
  eventId         String? // set when this order was rung up against an event's authorized-products menu
  event           Event?    @relation(fields: [eventId], references: [id])
  shiftId         String
  shift           PosShift  @relation(fields: [shiftId], references: [id])
  waiterId        String
  waiter          User      @relation(fields: [waiterId], references: [id])
  status          String    @default("OPEN") // OPEN | SENT | READY | CLOSED | CANCELLED | VOID
  // CUSTOMER → prints "CUSTOMER'S BILL"; the rest are in-house → "IN-HOUSE BILL".
  billType        String    @default("CUSTOMER") // CUSTOMER | ADMIN | DIRECTOR | DJ | TIPS | STAFF
  discount        Float     @default(0)
  discountReason  String? // why the discount was applied — captured for reporting
  totalAmount     Float     @default(0)
  paidAmount      Float     @default(0)
  paymentMethod   String? // CASH | CRDB | STANBIC | MPESA | SIGNED
  signedBillId    String? // set when paymentMethod = SIGNED → links to cashier SignedBill
  closedAt        DateTime?
  closedBy        String? // userId
  voidReason      String? // why the order was cancelled/voided
  notes           String?
  // Offline-queue idempotency key (see lib/offline-queue.ts) — lets a retried
  // "create order" sync request return the already-created row instead of
  // making a duplicate if the first attempt actually succeeded but its
  // response never reached the client. Null for orders created while online.
  clientRequestId String?   @unique
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  items     PosOrderItem[]
  printLogs PosPrintLog[]
  payments  PosPayment[]

  @@index([outletId])
  @@index([shiftId])
  @@index([waiterId])
  @@index([eventId])
  @@index([status])
  @@index([createdAt])
}

/// A (possibly partial) payment received against a POS order. Supports the
/// "Paid 324k / Balance 81k" pattern: multiple payments until the bill settles.
/// The recorder is the verifier — receiving staff confirm cash/digital receipt.
model PosPayment {
  id             String   @id @default(cuid())
  orderId        String
  order          PosOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount         Float
  method         String // CASH | CRDB | STANBIC | MPESA
  receivedById   String // userId of staff who received & verified the payment
  receivedByName String
  note           String?
  createdAt      DateTime @default(now())

  @@index([orderId])
}

// Individual items on an order. counterCode tells the system which printer to use.
model PosOrderItem {
  id              String    @id @default(cuid())
  orderId         String
  order           PosOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId       String
  product         Product   @relation(fields: [productId], references: [id])
  productName     String // snapshot at time of order (price may change later)
  unitPrice       Float
  quantity        Float     @default(1)
  amount          Float // unitPrice * quantity
  extras          String? // JSON array e.g. ["Barafu","Straw"]
  counterCode     String? // MAIN | BAR | SHISHA | KITCHEN — which counter prints this
  status          String    @default("PENDING") // PENDING | SENT | PREPARED | CANCELLED
  sentAt          DateTime?
  preparedAt      DateTime? // when the counter marked it ready/served
  preparedBy      String? // userId of counter staff who marked it ready
  cancelledBy     String? // userId
  cancelReason    String? // why the item was cancelled — captured for reporting
  // Offline-queue idempotency key — see PosOrder.clientRequestId.
  clientRequestId String?   @unique
  createdAt       DateTime  @default(now())

  @@index([orderId])
  @@index([productId])
}

/// VIP Counter staff requesting drinks from the Main Drinks Counter (or vice
/// versa) when their own counter is out of stock of a product — physical
/// hand-off between staff, this just carries the notification/queue.
model PosStockRequest {
  id              String    @id @default(cuid())
  outletId        String
  outlet          Outlet    @relation(fields: [outletId], references: [id])
  fromCounter     String // VIP | MAIN — counter that's out of stock and asking
  toCounter       String // MAIN | VIP — counter being asked to supply
  productId       String
  productName     String // snapshot at request time (price/name may change later)
  quantity        Float     @default(1)
  note            String?
  status          String    @default("PENDING") // PENDING | FULFILLED
  requestedById   String
  requestedByName String
  fulfilledById   String?
  fulfilledAt     DateTime?
  createdAt       DateTime  @default(now())

  @@index([outletId])
  @@index([status])
}

// Tracks every receipt/ticket sent to a counter printer.
model PosPrintLog {
  id          String   @id @default(cuid())
  orderId     String
  order       PosOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  counterCode String // BAR | SHISHA | KITCHEN | CASHIER
  printedAt   DateTime @default(now())
  printedBy   String // userId
  items       String // JSON snapshot of items on this print job

  @@index([orderId])
}

// Waiter signs in/out per shift — matches POSTERMINAL SignInForm/SignOutForm.
model PosWaiterSession {
  id          String    @id @default(cuid())
  waiterId    String
  waiter      User      @relation(fields: [waiterId], references: [id])
  shiftId     String
  shift       PosShift  @relation(fields: [shiftId], references: [id])
  signedInAt  DateTime  @default(now())
  signedOutAt DateTime?

  @@index([waiterId])
  @@index([shiftId])
}

// Add-ons selectable per order item (e.g. Barafu, Straw, Lemon).
model PosProductExtra {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

// Items blocked per outlet by a manager (out of stock / not available today).
// Does not affect the global product catalogue — only the POS menu for that outlet.
model PosBlockedItem {
  id        String   @id @default(cuid())
  outletId  String
  outlet    Outlet   @relation(fields: [outletId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  blockedBy String // userId
  reason    String?
  createdAt DateTime @default(now())

  @@unique([outletId, productId])
  @@index([outletId])
}

/// Staff scheduling: a rostered shift assignment for one staff member on one
/// day at one outlet. This is the planning layer — distinct from PosShift,
/// which is the operational till-open record. Two scheduling shifts per day:
/// MORNING (09:00–16:00) and EVENING (16:00–05:00 next day).
model ScheduleAssignment {
  id          String   @id @default(cuid())
  date        DateTime // the calendar day the shift starts
  shiftType   String // MORNING | EVENING
  outletId    String
  outlet      Outlet   @relation(fields: [outletId], references: [id])
  staffId     String
  staff       User     @relation(fields: [staffId], references: [id])
  staffName   String // denormalized for fast display & export
  role        String   @default("WAITER") // WAITER | SUPERVISOR | BARTENDER | CASHIER | HOSTESS
  source      String   @default("AUTO") // AUTO | MANUAL (manager override)
  note        String? // e.g. auto-scheduler reasoning, or override note
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // A staff member can hold only one slot per shift per day (prevents double-booking).
  @@unique([date, shiftType, staffId])
  @@index([outletId])
  @@index([date])
  @@index([staffId])
}

/// Exception to the default "every active service staff is available" rule.
/// shiftType null = unavailable the whole day; otherwise only that shift.
model StaffUnavailability {
  id          String   @id @default(cuid())
  staffId     String
  staff       User     @relation(fields: [staffId], references: [id])
  staffName   String
  date        DateTime
  shiftType   String? // null = whole day | MORNING | EVENING
  reason      String   @default("OTHER") // LEAVE | ABSENT | OTHER
  note        String?
  createdById String?
  createdAt   DateTime @default(now())

  @@index([staffId])
  @@index([date])
}

/// Per-outlet knobs for the auto-scheduler (expected-traffic weighting and
/// rest-day policy). One row per outlet; sensible defaults if absent.
model OutletScheduleConfig {
  id                String   @id @default(cuid())
  outletId          String   @unique
  outlet            Outlet   @relation(fields: [outletId], references: [id])
  morningWeight     Float    @default(1) // expected traffic weight — Morning
  eveningWeight     Float    @default(1.6) // Evening is usually busier (nightlife)
  weekendMultiplier Float    @default(1.4) // Fri/Sat uplift on both shifts
  daysOffPerWeek    Int      @default(1) // rest days per staff per week
  updatedAt         DateTime @updatedAt
}

/// An external event or special function staffed temporarily from the
/// "Tips Events" outlet. Staff assigned here are pulled off their regular
/// weekly roster for the event day (see /api/events/[id]/staff).
model Event {
  id             String   @id @default(cuid())
  name           String
  description    String?
  eventType      String? // e.g. Wedding, Corporate, Concert, Private Party, Product Launch, Other
  clientName     String?
  location       String?
  date           DateTime // event day
  startTime      String? // "18:00"
  endTime        String? // "23:00"
  expectedGuests Int      @default(0)
  status         String   @default("PLANNED") // PLANNED | CONFIRMED | COMPLETED | CANCELLED
  salesTotal     Float    @default(0) // event revenue
  notes          String?
  outletId       String?
  outlet         Outlet?  @relation(fields: [outletId], references: [id])
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  staff         EventStaff[]
  expenses      EventExpense[]
  sponsors      EventSponsor[]
  products      EventProduct[]
  priceLists    PriceList[]
  targets       EventTarget[]
  ticketTypes   EventTicketType[]
  tickets       TicketBooking[]
  tables        EventTable[]
  tableBookings TableBooking[]
  posOrders     PosOrder[]
  budgets       Budget[]

  @@index([date])
  @@index([status])
}

/// A staff member assigned to work an event, with their role, attendance and
/// performance (sales attributed) during the event.
model EventStaff {
  id              String   @id @default(cuid())
  eventId         String
  event           Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  staffId         String
  staff           User     @relation(fields: [staffId], references: [id])
  staffName       String
  role            String   @default("WAITER") // SUPERVISOR | WAITER | BARTENDER | CASHIER | HOSTESS
  attended        Boolean  @default(false)
  salesAttributed Float    @default(0)
  performanceNote String?
  createdAt       DateTime @default(now())

  @@unique([eventId, staffId])
  @@index([staffId])
}

/// A budget/cost line on an event (transport, equipment, hire, etc.).
/// `amount` is the actual cost; `estimatedCost` is the planned budget for the
/// same line, so variance = estimatedCost - amount.
model EventExpense {
  id            String   @id @default(cuid())
  eventId       String
  event         Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  category      String
  description   String?
  estimatedCost Float    @default(0)
  amount        Float    @default(0) // actual cost
  supplier      String?
  paymentStatus String   @default("UNPAID") // UNPAID | PARTIAL | PAID
  createdById   String?
  createdAt     DateTime @default(now())

  @@index([eventId])
}

/// A sponsor backing an event, with the value/items they're contributing.
model EventSponsor {
  id               String   @id @default(cuid())
  eventId          String
  event            Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  sponsorName      String
  contactPerson    String?
  phone            String?
  email            String?
  sponsorshipType  String   @default("CASH") // CASH | IN_KIND | MEDIA | OTHER
  sponsorshipValue Float    @default(0)
  itemsProvided    String?
  agreementStatus  String   @default("PENDING") // PENDING | SIGNED | FULFILLED
  notes            String?
  createdById      String?
  createdAt        DateTime @default(now())

  @@index([eventId])
}

/// A product from the shared catalog authorized to be sold at an event, with
/// event-specific pricing and planning quantities. Stock fields are planning
/// inputs here — real stock movement wiring lands with the event POS phase.
model EventProduct {
  id                  String   @id @default(cuid())
  eventId             String
  event               Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  productId           String
  product             Product  @relation(fields: [productId], references: [id])
  productName         String // snapshot at time of authorization
  eventPrice          Float? // override; null = use Product.sellingPrice
  expectedQuantity    Float    @default(0)
  procurementQuantity Float    @default(0)
  stockAllocated      Float    @default(0)
  stockReturned       Float    @default(0)
  quantitySold        Float    @default(0)
  createdAt           DateTime @default(now())

  @@unique([eventId, productId])
  @@index([eventId])
}

/// A sales or procurement target set for an event, compared against a
/// (manually tracked or, where derivable, auto-suggested) actual value.
model EventTarget {
  id          String   @id @default(cuid())
  eventId     String
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  type        String // SALES | PROCUREMENT
  name        String // e.g. "Revenue Target", "Required Beer Stock"
  targetValue Float    @default(0)
  actualValue Float    @default(0)
  unit        String? // e.g. "TZS", "bottles", "crates", "guests"
  notes       String?
  createdAt   DateTime @default(now())

  @@index([eventId])
}

/// A ticket type a manager defines for an event (Regular/VIP/VVIP or custom),
/// with an optional capacity. Bookings against it are public (see
/// TicketBooking) — capacity is enforced transactionally in lib/bookings.ts.
model EventTicketType {
  id                String   @id @default(cuid())
  eventId           String
  event             Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name              String
  price             Float    @default(0)
  quantityAvailable Int? // null = unlimited
  createdAt         DateTime @default(now())

  bookings TicketBooking[]

  @@index([eventId])
}

/// A customer's ticket booking, created either publicly (app/book/[eventId])
/// or by a manager (walk-in/phone booking). Payment is tracked manually —
/// there is no payment gateway integration.
model TicketBooking {
  id            String          @id @default(cuid())
  eventId       String
  event         Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ticketTypeId  String
  ticketType    EventTicketType @relation(fields: [ticketTypeId], references: [id])
  bookingNumber String          @unique
  fullName      String
  phone         String
  email         String?
  quantity      Int             @default(1)
  totalAmount   Float           @default(0)
  paymentStatus String          @default("UNPAID") // UNPAID | PARTIAL | PAID
  bookingStatus String          @default("PENDING") // PENDING | CONFIRMED | CANCELLED
  checkedIn     Boolean         @default(false)
  checkedInAt   DateTime?
  createdAt     DateTime        @default(now())

  @@index([eventId])
  @@index([ticketTypeId])
}

/// A physical table a manager defines for an event (venue/layout varies per
/// event, so tables are per-event, not a reusable outlet-wide registry).
/// `status` doubles as the at-a-glance availability shown on the booking
/// page and can be flipped manually (e.g. a walk-in occupies a table with no
/// online booking).
model EventTable {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name      String // "Table 1", "VIP Table A"
  tableType String?
  capacity  Int      @default(4)
  price     Float    @default(0)
  status    String   @default("AVAILABLE") // AVAILABLE | RESERVED | OCCUPIED
  createdAt DateTime @default(now())

  bookings TableBooking[]

  @@index([eventId])
}

/// A customer's table reservation. Creating one flips the table's status to
/// RESERVED (see lib/bookings.ts); cancelling frees it back to AVAILABLE.
model TableBooking {
  id              String     @id @default(cuid())
  eventId         String
  event           Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  tableId         String
  table           EventTable @relation(fields: [tableId], references: [id])
  bookingNumber   String     @unique
  name            String
  phone           String
  guests          Int        @default(1)
  totalAmount     Float      @default(0)
  depositPaid     Float      @default(0) // balance = totalAmount - depositPaid, computed not stored
  specialRequests String?
  bookingStatus   String     @default("PENDING") // PENDING | CONFIRMED | CANCELLED
  createdAt       DateTime   @default(now())

  @@index([eventId])
  @@index([tableId])
}

// ─── Finance Platform (Phase 1: Chart of Accounts, General Ledger, AP) ─────
// Foundation layer only — see docs/finance-platform.md. Journals are
// system-generated only in this phase (posted from Grn/SupplierInvoice/
// SupplierPayment/DailyCollection); there is no manual/draft journal UI yet.
// A posted entry is never edited, only reversed (reverseJournalEntry in
// lib/ledger.ts posts an equal-and-opposite entry and links reversalOfId) —
// same "never delete, only reverse" audit principle as StockLedgerEntry.
//   Account.type:            ASSET | LIABILITY | EQUITY | INCOME | EXPENSE
//   FinancialPeriod.status:   OPEN | LOCKED
//   JournalEntry.sourceModule: PROCUREMENT | INVENTORY | SALES | COLLECTIONS | MANUAL
//   JournalEntry.status:      POSTED | REVERSED
//   FinanceAccountMapping.scope: GLOBAL | COMPANY | OUTLET (same shape as CollectionModeConfig)
//   SupplierInvoice.status:   OPEN | PARTIALLY_PAID | PAID | CANCELLED

/// One company's Chart of Accounts. Seeded with a starter set (Cash, Bank,
/// Mobile Money Clearing, Inventory Asset, AP Accrual, AP Control, VAT
/// Input/Output, Sales Revenue, COGS, Purchases Expense, Rounding/Variance)
/// on first access — see lib/finance-accounts-defaults.ts, same
/// "seed defaults on first GET" convention as PaymentChannel. isSystemAccount
/// protects the seeded/auto-mapped accounts from deletion.
model Account {
  id              String    @id @default(cuid())
  companyId       String
  company         Company   @relation(fields: [companyId], references: [id])
  code            String
  name            String
  type            String // ASSET | LIABILITY | EQUITY | INCOME | EXPENSE
  parentId        String?
  parent          Account?  @relation("AccountHierarchy", fields: [parentId], references: [id])
  children        Account[] @relation("AccountHierarchy")
  isSystemAccount Boolean   @default(false)
  isActive        Boolean   @default(true)
  sortOrder       Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  journalLines          JournalLine[]
  mappings              FinanceAccountMapping[]
  paymentChannels       PaymentChannel[]
  companyPaymentAccount CompanyPaymentAccount?
  budgets               Budget[]
  expenseCategories     ExpenseCategory[]

  @@unique([companyId, code])
  @@index([companyId, type])
}

/// A company's accounting calendar. Journal posting (lib/ledger.ts) requires
/// the entry date fall inside an OPEN period for that company; LOCKED blocks
/// further posting into it (reopening is a plain status flip + audit log —
/// no separate approval workflow in this phase).
model FinancialPeriod {
  id             String            @id @default(cuid())
  companyId      String
  company        Company           @relation(fields: [companyId], references: [id])
  name           String // e.g. "2026-07"
  startDate      DateTime
  endDate        DateTime
  status         String            @default("OPEN") // OPEN | LOCKED
  lockedAt       DateTime?
  lockedById     String?
  // Finance Platform (Stage 4): periods can now nest — a MONTHLY period
  // sits inside its QUARTERLY and ANNUAL periods, all covering the same
  // dates. postJournalEntry()'s period check (lib/ledger.ts
  // assertPeriodOpen) already checks every covering period, not just one,
  // so locking at any level blocks posting. parentPeriodId is informational
  // (drives the Financial Year view's nesting), not required for the lock
  // check itself. Generated in bulk by lib/finance-periods.ts
  // generateFinancialYearPeriods() ("Financial Year Management").
  periodType     String            @default("MONTHLY") // DAILY | WEEKLY | MONTHLY | QUARTERLY | ANNUAL
  parentPeriodId String?
  parentPeriod   FinancialPeriod?  @relation("PeriodHierarchy", fields: [parentPeriodId], references: [id])
  childPeriods   FinancialPeriod[] @relation("PeriodHierarchy")
  // Reopening a LOCKED period is restricted to DIRECTOR/ADMIN (see
  // app/api/finance/periods/route.ts) — "Reopen with Authorization" — and
  // the reason is recorded here for the audit trail alongside the standard
  // AuditLog entry.
  reopenReason   String?

  @@unique([companyId, name])
  @@index([companyId, status])
}

/// A balanced double-entry posting. The single choke point every module goes
/// through is postJournalEntry() in lib/ledger.ts — it validates the period
/// is OPEN, validates debits=credits, and writes header+lines in one
/// transaction. sourceType/sourceId are a loose ref (same convention as
/// StockLedgerEntry.refType/refId), not a FK, since the source varies by
/// module (Grn, SupplierInvoice, SupplierPayment, DailyCollection, ...).
model JournalEntry {
  id           String        @id @default(cuid())
  entryNumber  String        @unique // "JE-000001"
  companyId    String
  company      Company       @relation(fields: [companyId], references: [id])
  entryDate    DateTime
  sourceModule String // PROCUREMENT | INVENTORY | SALES | COLLECTIONS | MANUAL
  sourceType   String? // "Grn" | "SupplierInvoice" | "SupplierPayment" | "DailyCollection"
  sourceId     String?
  description  String?
  status       String        @default("POSTED") // POSTED | REVERSED
  createdById  String
  reversalOfId String?       @unique
  reversalOf   JournalEntry? @relation("JournalReversal", fields: [reversalOfId], references: [id])
  reversedBy   JournalEntry? @relation("JournalReversal")
  reversedById String?
  reversedAt   DateTime?
  createdAt    DateTime      @default(now())

  lines JournalLine[]

  @@index([companyId, entryDate])
  @@index([sourceType, sourceId])
}

/// One debit or credit line of a JournalEntry. App-layer invariant (like
/// StockLevel's "never both" comment): exactly one of debit/credit is > 0 per
/// line; the entry-level invariant sum(debit)==sum(credit) is enforced by
/// postJournalEntry(), not by the schema. outletId is an optional reporting
/// dimension (branch/cost-centre), not a scoping field.
model JournalLine {
  id             String       @id @default(cuid())
  journalEntryId String
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  accountId      String
  account        Account      @relation(fields: [accountId], references: [id])
  outletId       String?
  debit          Float        @default(0)
  credit         Float        @default(0)
  description    String?

  @@index([journalEntryId])
  @@index([accountId])
}

/// Configuration-driven mapping of a business event to a GL account —
/// identical scope/scopeId shape to CollectionModeConfig, resolved narrowest
/// wins (OUTLET > COMPANY > GLOBAL) in lib/finance-mapping.ts, falling back
/// to the company's seeded system account for that key if unconfigured — so
/// an unconfigured company still posts correctly on day one. key examples:
/// INVENTORY_ASSET | AP_ACCRUAL | AP_CONTROL | SALES_REVENUE | VAT_INPUT |
/// VAT_OUTPUT | ROUNDING.
model FinanceAccountMapping {
  id        String   @id @default(cuid())
  scope     String // GLOBAL | COMPANY | OUTLET
  scopeId   String? // null only for GLOBAL; else a Company.id or Outlet.id
  key       String
  accountId String
  account   Account  @relation(fields: [accountId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([scope, scopeId, key])
}

/// A supplier's formal invoice, raised against a received Grn. Creating one
/// reverses the GRN's provisional accrual (Dr AP Accrual / Cr AP Control,
/// posting any cost variance to the Rounding/Variance account) — see
/// lib/finance.ts createSupplierInvoice().
model SupplierInvoice {
  id                 String    @id @default(cuid())
  invoiceNumber      String    @unique // "INV-000001", internal
  supplierId         String
  supplier           Supplier  @relation(fields: [supplierId], references: [id])
  companyId          String
  company            Company   @relation(fields: [companyId], references: [id])
  grnId              String?
  grn                Grn?      @relation(fields: [grnId], references: [id])
  supplierInvoiceRef String? // the supplier's own invoice number
  invoiceDate        DateTime
  dueDate            DateTime?
  subtotal           Float
  vatAmount          Float     @default(0)
  total              Float
  amountPaid         Float     @default(0)
  status             String    @default("OPEN") // OPEN | PARTIALLY_PAID | PAID | CANCELLED
  createdById        String
  journalEntryId     String?
  createdAt          DateTime  @default(now())

  allocations SupplierPaymentAllocation[]

  @@index([supplierId, status])
  @@index([companyId])
}

/// A payment run to a supplier — may cover one or many open invoices
/// (SupplierPaymentAllocation), including partial amounts. Posts
/// Dr AP Control / Cr Cash-Bank (via paymentChannel's mapped GL account).
model SupplierPayment {
  id               String         @id @default(cuid())
  paymentNumber    String         @unique // "PAY-000001"
  supplierId       String
  supplier         Supplier       @relation(fields: [supplierId], references: [id])
  companyId        String
  company          Company        @relation(fields: [companyId], references: [id])
  paymentChannelId String
  paymentChannel   PaymentChannel @relation(fields: [paymentChannelId], references: [id])
  amount           Float
  paymentDate      DateTime       @default(now())
  reference        String?
  note             String?
  createdById      String
  journalEntryId   String?
  createdAt        DateTime       @default(now())

  allocations SupplierPaymentAllocation[]

  @@index([supplierId])
  @@index([companyId])
}

/// Splits one SupplierPayment across one or more SupplierInvoices (and one
/// invoice can be paid across several payments) — the many-to-many needed for
/// "partial payments / multiple payments" in the spec.
model SupplierPaymentAllocation {
  id                String          @id @default(cuid())
  paymentId         String
  payment           SupplierPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  supplierInvoiceId String
  supplierInvoice   SupplierInvoice @relation(fields: [supplierInvoiceId], references: [id])
  amount            Float

  @@index([paymentId])
  @@index([supplierInvoiceId])
}

// ─── Finance Platform (Stage 2 — Accounts Receivable) ──────────────────────
// AR deliberately does NOT introduce a new "CustomerInvoice" model — SignedBill
// already IS the customer/credit invoice (see SignedBill above) and PaidBill
// already IS the receipt. Stage 2 only adds GL posting (lib/finance-ar.ts)
// on top of that existing data, plus this one new model for write-offs,
// which SignedBill/PaidBill have no room to express (a write-off is neither
// a bill nor a cash receipt).

/// Bad-debt write-off of a SignedBill's remaining (unpaid) balance. Posts
/// Dr Bad Debt Expense / Cr Accounts Receivable — see lib/finance-ar.ts
/// writeOffSignedBill(). Multiple partial write-offs against one bill are
/// allowed (e.g. a partial recovery followed by writing off the rest).
model SignedBillWriteOff {
  id             String     @id @default(cuid())
  signedBillId   String
  signedBill     SignedBill @relation(fields: [signedBillId], references: [id])
  amount         Float
  reason         String?
  createdById    String
  journalEntryId String?
  createdAt      DateTime   @default(now())

  @@index([signedBillId])
}

// ─── Finance Platform (Stage 3 — Banking & Cash Management) ────────────────
// A PaymentChannel (Stage 1) is a payment TYPE ("Bank Transfer", "M-Pesa") —
// a business only needs one glAccountId per channel if it has a single bank
// account. CompanyPaymentAccount is the actual account INSTANCE under that
// type: unlimited accounts, multiple accounts in the same bank, multiple
// currencies, optional branch (outlet) assignment, one designated default
// per (company, channel[, outlet]) scope. Each account gets its own GL
// Account (via glAccountId) so its running balance is just that GL account's
// ledger balance — no separate balance column to keep in sync.
//   CompanyPaymentAccount.currency: ISO 4217 code, e.g. "TZS" | "USD"
//   BankTransaction.type: TRANSFER | DEPOSIT | WITHDRAWAL | BANK_CHARGE | INTEREST

/// One real bank/mobile-money/cash account a company holds, under a
/// PaymentChannel "type". outletId scopes it to one branch (e.g. a
/// branch-specific till); null means company-wide / any branch can use it.
/// isDefault marks the account a channel resolves to when nothing more
/// specific is configured — see lib/finance-mapping.ts
/// resolveChannelAccountId() and lib/finance-banking.ts
/// resolveDefaultCompanyAccountId().
model CompanyPaymentAccount {
  id               String         @id @default(cuid())
  companyId        String
  company          Company        @relation(fields: [companyId], references: [id])
  paymentChannelId String
  paymentChannel   PaymentChannel @relation(fields: [paymentChannelId], references: [id])
  outletId         String?
  outlet           Outlet?        @relation(fields: [outletId], references: [id])
  bankName         String?
  accountName      String
  accountNumber    String?
  currency         String         @default("TZS")
  glAccountId      String         @unique
  glAccount        Account        @relation(fields: [glAccountId], references: [id])
  isDefault        Boolean        @default(false)
  isActive         Boolean        @default(true)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  transfersOut    BankTransaction[]       @relation("BankTxnFrom")
  transfersIn     BankTransaction[]       @relation("BankTxnTo")
  reconciliations AccountReconciliation[]
  fundingSources  FundingSource[]

  @@index([companyId, paymentChannelId])
  @@index([outletId])
}

/// A manual cash-management movement between/against Company Payment
/// Accounts — see lib/finance-banking.ts postBankTransaction() for the
/// Dr/Cr rule per type:
///   TRANSFER      Dr toAccount / Cr fromAccount (both required)
///   DEPOSIT       Dr toAccount (bank) / Cr fromAccount (e.g. Cash) — moving
///                 physical cash into the bank
///   WITHDRAWAL    Dr toAccount (e.g. Cash) / Cr fromAccount (bank)
///   BANK_CHARGE   Dr Bank Charges Expense / Cr fromAccount
///   INTEREST      Dr toAccount / Cr Interest Income
model BankTransaction {
  id              String                 @id @default(cuid())
  companyId       String
  company         Company                @relation(fields: [companyId], references: [id])
  type            String
  fromAccountId   String?
  fromAccount     CompanyPaymentAccount? @relation("BankTxnFrom", fields: [fromAccountId], references: [id])
  toAccountId     String?
  toAccount       CompanyPaymentAccount? @relation("BankTxnTo", fields: [toAccountId], references: [id])
  amount          Float
  transactionDate DateTime               @default(now())
  reference       String?
  note            String?
  createdById     String
  journalEntryId  String?
  createdAt       DateTime               @default(now())

  @@index([companyId, transactionDate])
}

// ─── Finance Platform (Stage 4 — Budgeting & Forecasting) ──────────────────
// A budget targets one GL Account over one period, at a scope of company,
// optionally narrowed to an outlet (branch). department/eventId are stored
// as organizational tags on the budget itself — useful for grouping/
// filtering budgets in the UI — but the "Actual" figure (lib/finance-budget.ts
// computeActual()) is always computed from account + outlet + date range,
// the only dimensions JournalLine actually carries; it is NOT further split
// by department/event, since no posting site in this app tags journal lines
// with either today. Two departments budgeting the same account/outlet/
// period will therefore see the same Actual number — an honest limitation,
// not a bug, until journal lines carry those tags too.
//   Budget.periodType: DAILY | WEEKLY | MONTHLY | QUARTERLY | ANNUAL
model Budget {
  id           String      @id @default(cuid())
  companyId    String
  company      Company     @relation(fields: [companyId], references: [id])
  outletId     String?
  outlet       Outlet?     @relation(fields: [outletId], references: [id])
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  eventId      String?
  event        Event?      @relation(fields: [eventId], references: [id])
  accountId    String
  account      Account     @relation(fields: [accountId], references: [id])
  periodType   String      @default("MONTHLY")
  periodStart  DateTime
  periodEnd    DateTime
  amount       Float
  note         String?
  createdById  String
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([companyId, accountId, periodStart, periodEnd])
  @@index([outletId])
}

// ─── Finance Platform (Stage 5 — Reconciliation) ───────────────────────────
// GL-based reconciliation of a Company Payment Account (Stage 3) against an
// external bank/mobile-money statement — distinct from the pre-existing,
// pre-Finance-Platform CashRecon/BankRecon models, which reconcile a daily
// cash drawer and Daily Collection digital-channel totals respectively and
// are NOT GL-based. This is the "does our ledger match the bank statement"
// reconciliation the spec asks for; Supplier/Customer "reconciliation" is
// already covered by the AP/AR aging + Payment Story views built in Stages
// 1-2 (every invoice/bill's full payment history is already visible there),
// so no separate model was added for those.
//   AccountReconciliation.status: DRAFT | PENDING_APPROVAL | APPROVED
//   ReconciliationItem.source: SYSTEM | STATEMENT
//   ReconciliationItem.matchStatus: MATCHED | UNMATCHED | MISSING | DUPLICATE

/// One reconciliation run for one Company Payment Account over one period.
/// glBalance is a snapshot (the account's GL balance at creation time, via
/// lib/finance-banking.ts companyAccountBalance) — frozen so a later
/// transaction back-dated into this period doesn't silently change a
/// reconciliation that's already been approved. Approval is a separate
/// step from submission (lib/finance-reconciliation.ts), matching this
/// app's existing "entry role vs. verifier role" separation of duties
/// convention (see lib/cash-verify.ts canVerifyCash()).
model AccountReconciliation {
  id                      String                @id @default(cuid())
  companyPaymentAccountId String
  companyPaymentAccount   CompanyPaymentAccount @relation(fields: [companyPaymentAccountId], references: [id])
  periodStart             DateTime
  periodEnd               DateTime
  statementBalance        Float
  glBalance               Float
  status                  String                @default("DRAFT")
  createdById             String
  submittedById           String?
  submittedAt             DateTime?
  approvedById            String?
  approvedAt              DateTime?
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt

  items ReconciliationItem[]

  @@index([companyPaymentAccountId, periodStart])
}

/// One line on one side of a reconciliation — either a SYSTEM line (a real
/// JournalLine on the account, snapshotted at match time via
/// sourceJournalLineId) or a STATEMENT line (typed in by the user from the
/// bank/mobile-money statement). matchGroupId links a matched pair (or
/// group, for a split) together; null means still unresolved. amount is
/// signed the same way the statement itself would show it: positive =
/// money in, negative = money out.
model ReconciliationItem {
  id                  String                @id @default(cuid())
  reconciliationId    String
  reconciliation      AccountReconciliation @relation(fields: [reconciliationId], references: [id], onDelete: Cascade)
  source              String
  transactionDate     DateTime
  description         String?
  amount              Float
  matchStatus         String                @default("UNMATCHED")
  matchGroupId        String?
  sourceJournalLineId String?
  createdAt           DateTime              @default(now())

  @@index([reconciliationId, matchStatus])
}

// ─── Reconciliation Workflow Engine ────────────────────────────────────────
// Configurable Business Day -> Cashier Reconciliation -> Finance Reconciliation
// -> Financial Close -> Archived pipeline. Generalizes BusinessDay (which
// keeps meaning "stage = BUSINESS_DAY", untouched, so every existing
// screen/report/API keeps working) into a 5-stage per-(company[,outlet],date)
// lock unit, each independently configurable (window, close mode, required
// permissions/checks) rather than hardcoded. See
// docs/reconciliation-workflow-engine-design.md for the full design.
//   ReconciliationStage.stageKey: BUSINESS_DAY | CASHIER_RECON | FINANCE_RECON |
//                                 FINANCIAL_CLOSE | ARCHIVED
//   ReconciliationStage.status:   PENDING | OPEN | INCOMPLETE | CLOSED | REOPENED |
//                                 SKIPPED | ARCHIVED
//   ReconciliationStage.lastReminderTier: 0=none | 1=first reminder sent |
//                                 2=second/supervisor reminder sent | 3=escalated
// BUSINESS_DAY and CASHIER_RECON are per-OUTLET (outletId set). FINANCE_RECON
// and FINANCIAL_CLOSE default to COMPANY-wide (outletId null) — Finance owns
// the whole company's position, including receipts that never touch an
// outlet (sponsor payments, direct bank deposits, head-office receipts);
// drill-down to outlet/department/counter/cashier/channel/business day is a
// read query joining back to the child CASHIER_RECON stages and their
// DailyCollection/CashRecon/BankRecon records, not a separate storage layer.
// A company that wants Finance Recon signed off per outlet instead sets an
// OUTLET-scope ReconciliationStageConfig override for that stageKey.
model ReconciliationStage {
  id                String    @id @default(cuid())
  companyId         String
  company           Company   @relation(fields: [companyId], references: [id])
  outletId          String? // null for company-wide stages (FINANCE_RECON, FINANCIAL_CLOSE by default)
  outlet            Outlet?   @relation(fields: [outletId], references: [id])
  date              DateTime
  stageKey          String
  status            String    @default("PENDING")
  openedAt          DateTime?
  closedAt          DateTime?
  closedById        String?
  closedByName      String?
  autoClosed        Boolean   @default(false) // true only when ForceAutoClose policy actually closed it
  gracePeriodEndsAt DateTime? // endTime + graceMinutes — after this, escalation fires
  lastReminderTier  Int       @default(0)
  escalatedAt       DateTime?
  escalatedToRoles  String? // JSON array of role strings notified on escalation
  result            String? // MATCHED | SHORTAGE | EXCESS | MISSING_TRANSACTION (Cashier/Finance Recon only)
  resultDetail      String? // JSON — variance breakdown by outlet/channel/counter/cashier
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  unlockRequests   ReconciliationStageUnlockRequest[]
  auditLogs        ReconciliationStageAuditLog[]
  checkResults     ReconciliationCheckResult[]
  writeOffRequests WriteOffRequest[]

  @@unique([companyId, outletId, date, stageKey])
  @@index([companyId, stageKey, status])
  @@index([outletId, stageKey, status])
  @@index([date])
}

/// Request -> Approval -> Reopen workflow for any stage, generalizing
/// BusinessDayUnlockRequest. Plain string actor fields (no User relation),
/// matching BusinessDayAuditLog's convention rather than adding new User
/// relations.
model ReconciliationStageUnlockRequest {
  id                String              @id @default(cuid())
  stageId           String
  stage             ReconciliationStage @relation(fields: [stageId], references: [id])
  requestedById     String
  requestedByName   String
  reason            String
  requestedDuration String? // "15m" | "30m" | "1h" | "CUSTOM"
  requestedMinutes  Int?
  status            String              @default("PENDING") // PENDING | APPROVED | REJECTED | COMPLETED | EXPIRED
  approverId        String?
  approverName      String?
  approverComment   String?
  resolvedAt        DateTime?
  completedAt       DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([stageId, status])
}

/// Immutable field-diff + approval audit trail for ReconciliationStage
/// actions — INSERT-ONLY by convention, same as BusinessDayAuditLog.
model ReconciliationStageAuditLog {
  id             String              @id @default(cuid())
  stageId        String
  stage          ReconciliationStage @relation(fields: [stageId], references: [id])
  action         String // OPEN | CLOSE | REOPEN | LOCK | AUTO_LOCK | UNLOCK_REQUESTED |
  // UNLOCK_APPROVED | UNLOCK_REJECTED | UNLOCK_EXPIRED | ARCHIVE |
  // REMINDER_SENT | ESCALATED | RECONCILE_MATCHED | RECONCILE_VARIANCE
  field          String?
  previousValue  String?
  newValue       String?
  reason         String?
  approvedById   String?
  approvedByName String?
  userId         String?
  userName       String?
  createdAt      DateTime            @default(now())

  @@index([stageId, createdAt])
  @@index([action])
}

/// Per-scope, per-stage config — window, close mode, required permission,
/// validation strictness, auto-close policy, notification channels. Same
/// GLOBAL->COMPANY->OUTLET shape as BusinessDayPolicyConfig/
/// CollectionModeConfig, narrowest wins. `scope` also picks the grain a
/// stage instance is created at (see ReconciliationStage comment above).
model ReconciliationStageConfig {
  id                   String  @id @default(cuid())
  scope                String // GLOBAL | COMPANY | OUTLET
  scopeId              String?
  stageKey             String // BUSINESS_DAY | CASHIER_RECON | FINANCE_RECON | FINANCIAL_CLOSE
  startTime            String? // "HH:mm" — when the stage becomes eligible to open; null = opens on prior stage close
  endTime              String? // "HH:mm" — deadline before escalation/auto-close validation runs
  closeMode            String  @default("MANUAL") // MANUAL | AUTO
  requiredRoles        String? // JSON array of role strings allowed to close/approve this stage
  validationStrictness String  @default("BLOCK_ON_MISSING") // BLOCK_ON_MISSING | WARN_ON_MISSING | ALLOW
  graceMinutes         Int     @default(0) // window after endTime before escalation fires
  isEnabled            Boolean @default(true) // lets a company skip Finance Recon / Financial Close entirely

  // Auto-close policy: the engine only NOTIFIES + ESCALATES on a missed
  // deadline by default — it never silently locks a stage with unresolved
  // discrepancies. forceAutoClose must be explicitly turned on for
  // closeMode=AUTO to actually transition OPEN/INCOMPLETE -> CLOSED once
  // graceMinutes elapses; escalationRoles are notified either way.
  forceAutoClose  Boolean @default(false)
  escalationRoles String? // JSON array of role strings notified when grace period expires

  // Notification channels for Level 1 reminders (JSON array, e.g. ["IN_APP"]
  // or ["IN_APP","EMAIL"]); escalation (Level 2) always sends EMAIL in
  // addition to IN_APP regardless of this setting — see lib/reconciliation-notify.ts.
  notifyChannels String? @default("[\"IN_APP\"]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([scope, scopeId, stageKey])
}

/// Configurable reminder/escalation cadence — same GLOBAL->COMPANY->OUTLET
/// scope shape, optionally narrowed further to one stageKey (null = applies
/// to all stages at this scope). Default values (used when no row exists at
/// any scope) match the brief's example cadence: 30 min / 2 hours / end of
/// window. Fired lazily on read (see checkGraceAndEscalate in
/// lib/reconciliation-stage.ts), same "no per-minute cron" pattern as
/// autoLockExpiredBusinessDays.
model ReconciliationReminderPolicy {
  id                      String   @id @default(cuid())
  scope                   String // GLOBAL | COMPANY | OUTLET
  scopeId                 String?
  stageKey                String?
  reminderAnchor          String   @default("STAGE_OPEN") // STAGE_OPEN | END_TIME
  firstReminderMinutes    Int      @default(30) // -> notify responsible user (Level 1)
  secondReminderMinutes   Int      @default(120) // -> notify supervisor (Level 1, escalated recipient)
  escalationAtEndOfWindow Boolean  @default(true) // Level 2 fires at endTime+graceMinutes regardless of the above
  generateExceptionReport Boolean  @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@unique([scope, scopeId, stageKey])
}

/// Plugin-style required-check registry — which reconciliation checks must
/// be COMPLETE before a given stage instance can close, configured per
/// scope+stageKey rather than hardcoded. A new check type is a new row here
/// plus a resolver function registered in lib/reconciliation-checks.ts's
/// CHECK_REGISTRY — the stage engine itself never changes.
///   checkType: CASH_RECON | BANK_RECON | MOBILE_MONEY_RECON | SPONSOR_RECON |
///              INVENTORY_RECON | PAYMENT_VERIFICATION | <custom>
model ReconciliationRequirement {
  id         String   @id @default(cuid())
  scope      String // GLOBAL | COMPANY | OUTLET
  scopeId    String?
  stageKey   String
  checkType  String
  isRequired Boolean  @default(true) // false = informational only, doesn't block close
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([scope, scopeId, stageKey, checkType])
}

/// One row per (stage instance, checkType) — the evaluated result of running
/// a ReconciliationRequirement's resolver against that stage's data.
/// Recomputed each time the stage's close-validation runs; kept (not
/// deleted) so the audit trail shows exactly what passed/failed at close
/// time.
model ReconciliationCheckResult {
  id          String              @id @default(cuid())
  stageId     String
  stage       ReconciliationStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  checkType   String
  status      String              @default("PENDING") // PENDING | COMPLETE | FAILED | SKIPPED
  detail      String? // JSON — e.g. { missingOutlets: [...], variance: 12000 }
  sourceModel String? // e.g. "CashRecon", "BankRecon" — which existing table this check read
  sourceId    String? // id of the specific record checked, when applicable
  evaluatedAt DateTime            @default(now())

  @@unique([stageId, checkType])
}

/// Real-time payment verification, independent of which stage is currently
/// open — a payment can be verified the moment it's received, ahead of
/// Cashier Recon. Sourced from an internal system event (Cash/Bank/Mobile
/// Money/POS — this app's own CashRecon/BankRecon/PosPayment rows,
/// source=SYSTEM_GENERATED), a file import (source=IMPORT), a live API/
/// webhook connector (source=API), or manual entry (source=MANUAL, the
/// fallback). Ingestion priority on a conflicting match (same channel +
/// reference + amount): API > IMPORT > MANUAL — a later lower-priority
/// arrival for an already-VERIFIED reference is written as DUPLICATE with
/// duplicateOfId set, never silently overwriting the earlier record.
model PaymentVerification {
  id             String    @id @default(cuid())
  outletId       String? // null for company-level receipts not tied to an outlet (sponsor/head-office)
  outlet         Outlet?   @relation(fields: [outletId], references: [id])
  companyId      String
  company        Company   @relation(fields: [companyId], references: [id])
  date           DateTime
  reference      String? // payment reference/code (bank ref, MoMo txn id, till slip no.)
  channel        String // CASH | CRDB | STANBIC | MPESA | ... (same channel codes as BankRecon)
  amount         Float
  customerName   String?
  paidAt         DateTime?
  status         String    @default("PENDING") // PENDING | VERIFIED | FAILED | DUPLICATE
  source         String    @default("MANUAL") // API | IMPORT | MANUAL | SYSTEM_GENERATED
  sourceRef      String? // integration connector id, import batch id, or origin record id (e.g. a CashRecon/PosPayment id)
  matchedStageId String? // links to the ReconciliationStage it was verified against, once matched
  verifiedById   String?
  verifiedAt     DateTime?
  failureReason  String?
  duplicateOfId  String? // self-reference when status = DUPLICATE
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([companyId, date, status])
  @@index([outletId, date, status])
  @@index([reference])
}

/// One row per configured inbound integration (bank/MoMo/gateway webhook, or
/// a scheduled file-import connector) that can create PaymentVerification
/// rows with source=API or source=IMPORT. Kept generic (name + kind + config
/// JSON) so adding a new provider is a data row, not a schema change. Phase 1
/// ships zero rows here — the internal Cash/Bank/MobileMoney/POS pilot flow
/// writes PaymentVerification directly with source=SYSTEM_GENERATED; this
/// table is the extension point for a real external connector later.
model PaymentIntegrationConnector {
  id         String    @id @default(cuid())
  companyId  String
  company    Company   @relation(fields: [companyId], references: [id])
  name       String // e.g. "CRDB Bank Webhook", "M-Pesa API", "Monthly Bank Statement Import"
  kind       String // API_WEBHOOK | FILE_IMPORT
  channel    String // CRDB | STANBIC | MPESA | ...
  config     String? // JSON — connector-specific settings (endpoint, mapping, credentials ref)
  isActive   Boolean   @default(true)
  lastSyncAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([companyId, isActive])
}

/// A controlled, non-destructive write-off of a reconciliation discrepancy.
/// Never edits the original CashRecon/BankRecon/DailyCollection/Excess row —
/// the raw discrepancy stays exactly as recorded; this is a separate
/// approved adjustment that references it. Requires evidence + a Finance
/// Manager approval (WRITE_OFF_RESOURCES.APPROVE); on approval,
/// lib/write-off.ts posts a JournalEntry adjustment and stamps
/// journalEntryId back onto the request.
model WriteOffRequest {
  id                    String               @id @default(cuid())
  companyId             String
  company               Company              @relation(fields: [companyId], references: [id])
  reconciliationStageId String?
  reconciliationStage   ReconciliationStage? @relation(fields: [reconciliationStageId], references: [id])
  sourceModel           String // "CashRecon" | "BankRecon" | "CollectionExcess" | "CashReconExcess" | ...
  sourceId              String // id of the specific discrepancy record being written off
  channelKey            String               @default("CASH") // FinanceAccountMapping key for the asset account being reduced (CASH | BANK | MOBILE_MONEY)
  outletId              String?
  expectedAmount        Float
  receivedAmount        Float
  amount                Float // expectedAmount - receivedAmount, the amount being written off
  reason                String
  evidenceUrl           String? // uploaded evidence attachment (receipt, screenshot, statement excerpt)
  status                String               @default("PENDING") // PENDING | APPROVED | REJECTED | CANCELLED
  requestedById         String
  requestedByName       String
  approverId            String?
  approverName          String?
  approverComment       String?
  resolvedAt            DateTime?
  journalEntryId        String? // set once approved — the accounting adjustment entry created
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  auditLogs WriteOffAuditLog[]

  @@index([status])
  @@index([sourceModel, sourceId])
}

/// Immutable audit trail for WriteOffRequest actions — INSERT-ONLY by
/// convention, same shape as ReconciliationStageAuditLog.
model WriteOffAuditLog {
  id         String          @id @default(cuid())
  writeOffId String
  writeOff   WriteOffRequest @relation(fields: [writeOffId], references: [id])
  action     String // REQUESTED | APPROVED | REJECTED | CANCELLED | JOURNAL_ENTRY_CREATED
  reason     String?
  userId     String?
  userName   String?
  createdAt  DateTime        @default(now())

  @@index([writeOffId, createdAt])
}

// ─── Universal Credit Management Framework (Phase 1 — config + classification) ─
// A configuration & classification layer that turns the app's existing,
// working Accounts-Receivable core into an industry-agnostic, admin-configurable
// credit module WITHOUT forking the transactional core. Nothing here replaces
// SignedBill (the credit invoice), PaidBill (the receipt), SignedBillWriteOff,
// WorkflowApproval, or the GL posting in lib/finance-ar.ts — those remain the
// single source of truth for credit money. Instead these models generalize the
// currently-hardcoded billType groupings in lib/bill-types.ts
// (CREDIT_BILL_TYPES / REQUEST_BILL_TYPES / PAYROLL_ELIGIBLE_BILL_TYPES /
// CREDIT_LIMIT_BILL_TYPES) into admin-defined records, so "Signed Bills" /
// "House Accounts" / "Accounts Receivable" and their groups become
// configuration, not code. See docs/credit-management-framework-design.md.
//
// Design decisions (Phase 1 scope):
//   • Invoice/payment/write-off = existing SignedBill/PaidBill/SignedBillWriteOff.
//     An append-only CreditTransaction ledger is a later phase; not forked now.
//   • Approval = existing WorkflowApproval + role-based gating. A first-class
//     WorkflowDefinition/Step graph is a later phase; CreditGroup carries
//     approverRoles JSON in the meantime.
//   • Bridge FKs on SignedBill (creditGroupId/creditAccountId) and the 1:1
//     CreditAccount↔Person link are all NULLABLE — purely additive, zero
//     behavior change until app code opts in.

/// Module identity + global switches for the credit module — what "credit" is
/// CALLED and how it behaves, per scope. Same GLOBAL→COMPANY→OUTLET, narrowest-
/// wins shape as CollectionModeConfig/FinanceAccountMapping (resolved in
/// lib/credit-config.ts). Zero rows anywhere ⇒ module disabled / today's
/// hardcoded billType behavior, unchanged.
///   scope:         GLOBAL | COMPANY | OUTLET
///   allowOverLimit: BLOCK | WARN | APPROVE
model CreditModuleConfig {
  id                        String   @id @default(cuid())
  scope                     String
  // Null only for GLOBAL; else a Company.id or Outlet.id depending on scope.
  scopeId                   String?
  moduleName                String   @default("Signed Bills") // "House Accounts", "Accounts Receivable", ...
  // JSON map of generic label → tenant label, e.g.
  // {"account":"Person","invoice":"Signed Bill","payment":"Paid Bill","group":"Bill Type"}.
  terminology               String?
  enabled                   Boolean  @default(true)
  defaultCurrency           String   @default("TZS")
  approvalRequiredDefault   Boolean  @default(false)
  allowPartialPayments      Boolean  @default(true)
  allowOverLimit            String   @default("WARN")
  requireAttachmentsDefault Boolean  @default(false)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  @@unique([scope, scopeId])
}

/// A reusable, versioned rule bundle referenced by credit groups — separating
/// policy from group so "Standard Net-30 + 1.5%/mo" can be shared across many
/// groups. parameters holds the method-specific config as JSON (rate, period,
/// tiers, caps). effectiveFrom/To version a policy so re-pricing an old period
/// reproduces the rule in force then.
///   policyType: INTEREST | PENALTY | LIMIT | SETTLEMENT | WRITEOFF
///   method:     NONE | FLAT | PERCENT_PER_PERIOD | TIERED | COMPOUND | ...
model CreditPolicy {
  id            String    @id @default(cuid())
  companyId     String
  company       Company   @relation(fields: [companyId], references: [id])
  code          String
  name          String
  policyType    String
  method        String    @default("NONE")
  parameters    String? // JSON: {rate, periodDays, tiers[], cap, ...}
  effectiveFrom DateTime?
  effectiveTo   DateTime?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  interestGroups CreditGroup[] @relation("GroupInterestPolicy")
  penaltyGroups  CreditGroup[] @relation("GroupPenaltyPolicy")
  limitGroups    CreditGroup[] @relation("GroupLimitPolicy")

  @@unique([companyId, code])
  @@index([companyId, policyType])
}

/// The configurable classifier — the admin-defined "Admin / Director / Customer
/// / Tips Bills / DJ Bills / Insurance / Corporate …" records. This table is
/// why nothing is hardcoded: each generalizes one entry of the fixed billType
/// vocabulary + its groupings. legacyBillTypeCode bridges a group to the
/// existing SignedBill.billType so today's bills classify without a data
/// migration. Deletion is soft (status=INACTIVE) — historical bills reference it.
///   status:      ACTIVE | INACTIVE
///   riskRating:  LOW | MEDIUM | HIGH (or admin-defined)
model CreditGroup {
  id          String  @id @default(cuid())
  companyId   String
  company     Company @relation(fields: [companyId], references: [id])
  code        String // stable machine key, e.g. "TIPS_BILLS"
  name        String // display, e.g. "Tips Bills"
  description String?
  status      String  @default("ACTIVE")

  // Bridge to the existing fixed vocabulary (lib/bill-types.ts): ADMIN |
  // DIRECTOR | CUSTOMER | TIPS | DJ | STAFF_LOSS | null. Lets the resolver map
  // an existing SignedBill.billType to its group with no data migration.
  legacyBillTypeCode String?

  // Generalizes the hardcoded arrays in lib/bill-types.ts:
  isCreditBearing  Boolean @default(true) // = CREDIT_BILL_TYPES membership (real receivable, not an internal marker like STAFF_LOSS)
  requiresApproval Boolean @default(false) // = REQUEST_BILL_TYPES (formal request awaiting sign-off before it counts as debt)

  // Settlement — "Both (configurable)": allowed methods is a JSON array; the
  // default is picked from it. PAYROLL_DEDUCTION | CASH | BANK | MOBILE_MONEY.
  settlementMethods       String @default("[\"CASH\",\"BANK\",\"MOBILE_MONEY\"]")
  defaultSettlementMethod String @default("CASH")

  // Limits & terms (0 maxCredit = no group-level ceiling; per-account override
  // on CreditAccount still applies). Aging/grace ride the Business Period
  // Engine's Credit Cycle (BusinessPeriodVersion.credit*Day) when set.
  maxCredit        Float @default(0)
  paymentTermsDays Int   @default(0)
  gracePeriodDays  Int   @default(0)

  interestPolicyId String?
  interestPolicy   CreditPolicy? @relation("GroupInterestPolicy", fields: [interestPolicyId], references: [id])
  penaltyPolicyId  String?
  penaltyPolicy    CreditPolicy? @relation("GroupPenaltyPolicy", fields: [penaltyPolicyId], references: [id])
  limitPolicyId    String?
  limitPolicy      CreditPolicy? @relation("GroupLimitPolicy", fields: [limitPolicyId], references: [id])

  // Approval routing (Phase 1: role-based, reusing WorkflowApproval). JSON
  // array of role strings, e.g. ["MANAGER","DIRECTOR"]. A first-class
  // WorkflowDefinition graph replaces this in a later phase.
  approverRoles String?

  riskRating              String  @default("LOW")
  priority                Int     @default(0)
  documentsRequired       String? // JSON array of required doc-type labels
  // Allowed-scope restrictions kept as JSON id-arrays in Phase 1 (graduate to
  // child tables when the admin UI needs relational queries over them).
  allowedOutletIds        String?
  allowedProductIds       String?
  allowedCustomerGroupIds String?
  attributes              String? // extensibility escape hatch (industry-specific fields)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accountLinks CreditAccountGroup[]
  signedBills  SignedBill[]

  @@unique([companyId, code])
  @@index([companyId, status])
  @@index([legacyBillTypeCode])
}

/// The debtor — a thin wrapper over the existing Person (1:1) that adds a
/// materialized balance, credit status, and many-to-many group membership.
/// personId is the primary bridge; userId links staff accounts (payroll-
/// deduction settlement). currentBalance is a maintained projection of the
/// SignedBill/PaidBill A/R (reconciled by a scheduled self-diagnostic, never
/// the authoritative figure); balanceVersion guards concurrent limit checks.
///   accountType: INDIVIDUAL | COMPANY | STAFF | GOVERNMENT | GROUP
///   status:      ACTIVE | SUSPENDED | CLOSED | BLACKLISTED
model CreditAccount {
  id          String  @id @default(cuid())
  companyId   String
  company     Company @relation(fields: [companyId], references: [id])
  accountType String  @default("INDIVIDUAL")
  displayName String

  // 1:1 bridge to the existing customer/staff master. Nullable so a company/
  // government account with no Person row can still exist.
  personId String? @unique
  person   Person? @relation(fields: [personId], references: [id])
  userId   String? // staff account → User (payroll settlement); no relation to keep User model untouched

  status              String  @default("ACTIVE")
  creditLimitOverride Float? // beats the group limit when set
  currentBalance      Float   @default(0) // materialized; A/R remains source of truth
  balanceVersion      Int     @default(0)
  currency            String  @default("TZS")
  riskRating          String  @default("LOW")
  notes               String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  groupLinks   CreditAccountGroup[]
  signedBills  SignedBill[]
  transactions CreditTransaction[]

  @@index([companyId, status])
  @@index([userId])
}

/// The credit ledger (Phase 4) — a DERIVED, reconcilable projection over the
/// authoritative SignedBill / PaidBill / SignedBillWriteOff A/R, one row per
/// source record. It is NOT the canonical store (those three remain the source
/// of truth for credit money); it exists so an account's outstanding balance
/// and aging can be read/aggregated fast, and so CreditAccount.currentBalance
/// can be materialized and drift-checked. Rebuilt from source per account by
/// lib/credit-ledger.ts (delete-then-recreate), so it can never permanently
/// drift — a full reconcile always reproduces it exactly.
///   txnType:      INVOICE (+owed) | PAYMENT (−) | WRITEOFF (−)
///   signedAmount: + increases what the account owes, − reduces it
///   sourceType:   SignedBill | PaidBill | SignedBillWriteOff
model CreditTransaction {
  id              String        @id @default(cuid())
  accountId       String
  account         CreditAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  txnType         String
  signedAmount    Float
  currency        String        @default("TZS")
  // Snapshot of the source bill's classification, so reports can split trade
  // receivable (isCreditBearing) from internal markers (e.g. staff loss)
  // without re-joining to the group.
  billType        String?
  isCreditBearing Boolean       @default(true)
  sourceType      String
  sourceId        String
  // Economic date (bill/payment/write-off date) — the basis for aging buckets.
  entryDate       DateTime
  createdAt       DateTime      @default(now())

  @@unique([sourceType, sourceId])
  @@index([accountId])
  @@index([entryDate])
}

/// M:N membership — "one account may belong to multiple credit groups"
/// (effective-dated so limit/terms re-resolve without rewriting history). When
/// an account is in several groups, limit resolution is config-driven
/// (default: min of the group limits); see lib/credit-config.ts.
model CreditAccountGroup {
  id            String        @id @default(cuid())
  accountId     String
  account       CreditAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  groupId       String
  group         CreditGroup   @relation(fields: [groupId], references: [id])
  effectiveFrom DateTime      @default(now())
  effectiveTo   DateTime?
  createdAt     DateTime      @default(now())

  @@index([accountId])
  @@index([groupId])
}

// ─── Universal Payroll Management Framework (Phase 1 — foundation) ────────────
// The compensation domain the app lacks today. Until this, "payroll" meant only
// the deduction-recovery report (lib/payroll.ts) over SignedBill/Person — no one
// was ever paid, and User (login) and Person (party) were not linked by any FK.
//
// Phase 1 is FOUNDATION ONLY and ships DISABLED (PayrollModuleConfig.enabled =
// false): the Employee master that unifies User + Person, the module config
// (scoped like CreditModuleConfig / CollectionModeConfig), employee categories
// and pay groups. It computes no pay and posts no GL — later phases add
// PayComponent + the formula engine (Phase 2), PayrollRun + payslips + GL
// posting (Phase 3, which also closes Credit-framework Phase 5), statutory packs
// + attendance/leave (Phase 4). Additive & reversible: with the module disabled
// and nothing reading these tables, behaviour is byte-identical to before.
// Periods are NOT modelled here — payroll reuses BusinessPeriodVersion's
// payroll* fields via lib/business-periods.ts. See docs/payroll-framework-design.md.

/// Module identity + global switches for payroll — what "payroll" is CALLED and
/// how it behaves, per scope. Same GLOBAL→COMPANY→OUTLET narrowest-wins shape as
/// CreditModuleConfig (resolved in lib/payroll-config.ts). Ships enabled = false
/// so installing this framework changes nothing until an admin turns it on.
///   scope:                    GLOBAL | COMPANY | OUTLET
///   exchangeRatePolicy:       RUN_DATE | PERIOD_END | MANUAL
///   roundingPolicy:           NONE | NEAREST_0_01 | NEAREST_1 | NEAREST_5 | NEAREST_10
///   negativeNetPolicy:        BLOCK | CARRY_FORWARD | CAP (deductions > gross)
///   payElementVisibilityDefault: SUMMARY | FULL | MASKED (field-level salary confidentiality)
model PayrollModuleConfig {
  id                          String   @id @default(cuid())
  scope                       String
  // Null only for GLOBAL; else a Company.id or Outlet.id depending on scope.
  scopeId                     String?
  moduleName                  String   @default("Payroll") // "Wage Advice", "Salaries", ...
  // JSON map of generic label → tenant label, e.g.
  // {"module":"Payroll","employee":"Staff","payslip":"Payslip","run":"Pay Run","earning":"Earning","deduction":"Deduction"}.
  terminology                 String?
  enabled                     Boolean  @default(false) // DISABLED on install — zero behaviour change
  defaultCurrency             String   @default("TZS")
  exchangeRatePolicy          String   @default("RUN_DATE")
  approvalRequiredDefault     Boolean  @default(true)
  roundingPolicy              String   @default("NEAREST_1")
  negativeNetPolicy           String   @default("CARRY_FORWARD")
  payElementVisibilityDefault String   @default("SUMMARY")
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  @@unique([scope, scopeId])
}

/// Configurable employee classification — Permanent / Casual / Contract /
/// Consultant / Intern / Director / Seasonal / Part-time, unlimited & admin-
/// defined. Generalizes today's single boolean User.isCasual into first-class
/// rows. Soft-deleted (status = INACTIVE) — historical employees reference it.
model EmployeeCategory {
  id                  String   @id @default(cuid())
  companyId           String
  code                String // stable machine key, e.g. "PERMANENT"
  name                String // display, e.g. "Permanent"
  description         String?
  status              String   @default("ACTIVE")
  defaultPayFrequency String   @default("MONTHLY")
  // Some categories (e.g. short-term casuals, foreign consultants) may be exempt
  // from some statutory deductions — the flag is read by the Phase-4 statutory
  // engine; ignored in Phase 1.
  isStatutoryExempt   Boolean  @default(false)
  priority            Int      @default(0)
  attributes          String? // JSON extensibility escape hatch
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  employees Employee[]

  @@unique([companyId, code])
  @@index([companyId, status])
}

/// The configurable payroll rule bundle (the payroll analogue of CreditGroup):
/// which components apply, at what cadence, under whose approval. In Phase 1 it
/// is mostly identity + approver routing; componentSet / policy FKs are consumed
/// by later phases. approverRoles mirrors CreditGroup.approverRoles (Phase-1
/// role-based approval, reusing WorkflowApproval). Soft-deleted (INACTIVE).
model PayGroup {
  id          String  @id @default(cuid())
  companyId   String
  code        String // stable machine key, e.g. "FLOOR_STAFF"
  name        String // display, e.g. "Floor Staff"
  description String?
  status      String  @default("ACTIVE")

  // Null = follow the period cycle from BusinessPeriodVersion; set only to
  // override the cadence for this group (MONTHLY | FORTNIGHTLY | WEEKLY | DAILY | HOURLY).
  payFrequency String?

  // JSON array of default PayComponent codes for this group (consumed in Phase 2).
  componentSet String?

  // Approval routing (Phase 1: role-based, reusing WorkflowApproval). JSON array
  // of role strings, e.g. ["MANAGER","DIRECTOR"]. A first-class WorkflowDefinition
  // graph (shared with Credit) replaces this in a later phase.
  approverRoles String?

  // Reserved FKs, wired in Phase 4 (kept as loose ids to avoid forward-declaring
  // models that don't exist yet).
  overtimePolicyId   String?
  leaveSchemeId      String?
  statutoryProfileId String?

  priority    Int      @default(0)
  terminology String?
  attributes  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employees            Employee[]
  componentAssignments ComponentAssignment[]

  @@unique([companyId, code])
  @@index([companyId, status])
}

/// THE MISSING MASTER — one compensation identity per staff member, unifying the
/// two records that exist today but have no FK between them: a login (User) and
/// a party record (Person). Both links are nullable & unique and AT LEAST ONE is
/// required (enforced in app code, not the schema): floor staff exist only as a
/// User (no Person), directors/admins often only as a Person, some staff as both.
/// personId carries a relation (Person is the identity master, cf. CreditAccount);
/// userId is a bare unique scalar with NO relation, to leave the large User model
/// untouched — exactly as CreditAccount.userId does. Tenant scope (companyId /
/// outletId) and departmentId are bare scalars for the same reason.
///   status:        ACTIVE | PROBATION | SUSPENDED | ON_LEAVE | TERMINATED
///   paymentMethod: BANK | MOBILE_MONEY | CASH
model Employee {
  id String @id @default(cuid())

  personId String? @unique
  person   Person? @relation(fields: [personId], references: [id])
  userId   String? @unique // login link; no relation, to keep the User model untouched

  // Reuses Person.code EMPLOYEE_NUMBER mode when present; free to differ.
  employeeNumber String?

  categoryId String
  category   EmployeeCategory @relation(fields: [categoryId], references: [id])
  payGroupId String
  payGroup   PayGroup         @relation(fields: [payGroupId], references: [id])

  componentAssignments ComponentAssignment[]
  attendanceRecords    AttendanceRecord[]
  leaveBalances        LeaveBalance[]
  leaveRequests        LeaveRequest[]

  // Cost-centre dimensions. departmentId is a bare scalar in Phase 1 (Department
  // is a lookup used only by budgets today); a formal FK arrives with cost-centre
  // reporting in a later phase.
  departmentId String?
  costCenter   String?

  // Tenant scope — bare indexed scalars (a Company.id / Outlet.id), no relation,
  // resolved the same way scoped-config scopeId is.
  companyId String?
  outletId  String?

  hireDate         DateTime?
  probationEndDate DateTime?
  terminationDate  DateTime?
  status           String    @default("ACTIVE")

  baseCurrency   String  @default("TZS")
  // Base periodic pay in baseCurrency. The formula engine (Phase 2) reads this
  // as the `base` variable; 0 until set. Not itself a payslip line.
  baseSalary     Float   @default(0)
  paymentMethod  String  @default("BANK")
  // Opaque payout handles (bank account / mobile-money number). Never widen the
  // confidentiality surface beyond what today's Outlet/User fields already hold.
  bankRef        String?
  mobileMoneyRef String?
  notes          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, status])
  @@index([categoryId])
  @@index([payGroupId])
  @@index([userId])
}

// ─── Universal Payroll Framework (Phase 2 — components + formula engine) ──────
// PayComponent is ONE table for every payslip line kind (earning / allowance /
// benefit / deduction / employer contribution / statutory), discriminated by
// componentType + calcMethod — generalizing the hardcoded bill-type/payroll math
// into admin data, exactly as CreditGroup generalized billType. ComponentAssignment
// attaches a component to a pay group or a single employee (employee overrides
// group). PayrollFormula is the reusable expression registry evaluated by the
// SAFE evaluator in lib/payroll-formula.ts (a whitelisted DSL — never JS eval).
// Read-only in Phase 2: lib/payroll-calc.ts computes a DRAFT payslip preview;
// nothing is persisted and no GL posts (that is Phase 3). See docs/payroll-framework-design.md.

/// A reusable, versioned formula referenced by FORMULA-method components — its
/// expression is evaluated against a per-employee variable namespace (base,
/// prior component amounts by code, aggregates like gross/taxable/pensionable,
/// and attendance inputs) by lib/payroll-formula.ts. NOT eval: a fixed grammar
/// (arithmetic, comparisons, min/max/round/if/clamp/prorate/…) over named vars.
///   returnType: NUMBER | BOOLEAN
model PayrollFormula {
  id            String    @id @default(cuid())
  companyId     String
  code          String
  name          String
  description   String?
  // The safe expression string, e.g. "max(0, taxable * 0.1 - 50000)".
  expression    String
  // JSON array of the variable names the expression reads (declared inputs, for
  // dependency ordering + write-time validation), e.g. ["base","taxable"].
  variables     String?
  returnType    String    @default("NUMBER")
  effectiveFrom DateTime?
  effectiveTo   DateTime?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  components PayComponent[]

  @@unique([companyId, code])
}

/// The configurable payslip-line definition — the heart of "nothing hardcoded".
/// Basic Salary, Housing, Tips, Overtime, PAYE, Staff Purchases are all ROWS.
/// parameters holds the calcMethod-specific config as JSON:
///   FIXED:      {"amount": 500000}
///   PERCENTAGE: {"percent": 20, "of": "base"}          (of = a variable name)
///   RATE_QTY:   {"rate": 5000, "qtyVar": "overtimeHours"}
///   TABLE:      {"var": "taxable", "bands": [[0,0],[270000,0.09],...]}  (progressive)
///   SOURCED:    {"source": "CREDIT_BALANCE"|"LOAN_SCHEDULE"|"ADVANCE"|"MANUAL"|"STATUTORY"}
///   FORMULA:    (uses formulaId)
/// Soft-deleted (status = INACTIVE) — historical payslips reference it.
model PayComponent {
  id            String          @id @default(cuid())
  companyId     String
  code          String // stable machine key, e.g. "BASIC_SALARY"
  name          String // display, e.g. "Basic Salary"
  description   String?
  status        String          @default("ACTIVE")
  componentType String
  calcMethod    String
  parameters    String?
  formulaId     String?
  formula       PayrollFormula? @relation(fields: [formulaId], references: [id])

  taxable              Boolean @default(false)
  pensionable          Boolean @default(false)
  frequency            String  @default("PER_RUN")
  priority             Int     @default(0) // calc-order tiebreak within the dependency order
  proratable           Boolean @default(false)
  minLimit             Float?
  maxLimit             Float?
  // Per-component rounding; null = follow PayrollModuleConfig.roundingPolicy.
  roundingRule         String?
  // → FinanceAccountMapping key for the GL line this component posts (Phase 3).
  glMappingKey         String?
  // JSON: cost-centre split, e.g. {"OUTLET_A":0.6,"OUTLET_B":0.4}.
  costCenterAllocation String?
  requiresApproval     Boolean @default(false)

  effectiveFrom DateTime?
  effectiveTo   DateTime?
  terminology   String?
  attributes    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  assignments ComponentAssignment[]

  @@unique([companyId, code])
  @@index([companyId, status])
  @@index([componentType])
}

/// Attaches a component to EITHER a pay group OR a single employee (mutually
/// exclusive; exactly one set, enforced in app code). Effective-dated so the set
/// of components a person earns can change without rewriting history. Resolution
/// (lib/payroll-components.ts): employee-level assignment overrides group-level;
/// an override may replace the component's parameters and/or pin a flat amount.
model ComponentAssignment {
  id          String       @id @default(cuid())
  componentId String
  component   PayComponent @relation(fields: [componentId], references: [id])

  payGroupId String?
  payGroup   PayGroup? @relation(fields: [payGroupId], references: [id])
  employeeId String?
  employee   Employee? @relation(fields: [employeeId], references: [id])

  // Null = inherit the component default. parametersOverride is the same JSON
  // shape as PayComponent.parameters; amountOverride pins a flat result.
  parametersOverride String?
  amountOverride     Float?

  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([componentId])
  @@index([payGroupId])
  @@index([employeeId])
}

// ─── Universal Payroll Framework (Phase 3 — runs, payslips, GL posting) ───────
// The first phase that writes real financial records. A PayrollRun is an
// IMMUTABLE batch moved through an explicit state machine (see the header enum);
// a locked run is never edited — corrections are a CORRECTION run + a GL reversal
// (reverse-never-edit, exactly like lib/ledger.ts and the Credit ledger). On
// POST the run emits ONE balanced JournalEntry via lib/ledger.ts postJournalEntry
// (Dr salary/employer expense; Cr net-pay-payable, statutory/other payables, and
// — for staff-purchase recovery — Cr ACCOUNTS_RECEIVABLE, writing the matching
// PaidBill{PAYROLL} subledger rows). That A/R credit CLOSES Credit-framework
// Phase 5. Payslip/PayslipLine are per-employee snapshots taken at calc time.
// Run creation/posting is gated on PayrollModuleConfig.enabled (unlike the
// read-only Phase-2 preview). See docs/payroll-framework-design.md §9.

/// An immutable payroll batch for a period + scope, moved through the lifecycle
/// state machine. Totals are materialized (Σ payslips); PayslipLine is the
/// detail of record. Period fields are resolved from the Business Period Engine
/// (BusinessPeriodVersion payroll cycle) at creation and then frozen on the run.
model PayrollRun {
  id         String  @id @default(cuid())
  companyId  String
  outletId   String? // null = company-wide
  payGroupId String? // null = all pay groups in scope
  runType    String  @default("REGULAR")
  status     String  @default("DRAFT")

  periodKey      String // end-month key, e.g. "2026-07"
  periodStart    DateTime
  periodEnd      DateTime
  processingDate DateTime
  paymentDate    DateTime
  lockDate       DateTime
  currency       String   @default("TZS")

  totalGross        Float @default(0)
  totalDeductions   Float @default(0)
  totalNet          Float @default(0)
  totalEmployerCost Float @default(0)
  employeeCount     Int   @default(0)

  paymentBatches PaymentBatch[]

  // GL + lifecycle linkage. journalEntryId is the posted entry; reversalOfId
  // points to the run this one corrects (a CORRECTION run).
  journalEntryId String?
  reversalOfId   String?
  notes          String?
  createdById    String?
  approvedById   String?
  approvedAt     DateTime?
  lockedById     String?
  lockedAt       DateTime?
  postedAt       DateTime?
  reversedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  payslips Payslip[]

  @@index([companyId, status])
  @@index([periodKey])
}

/// A per-employee snapshot within a run: the employee's classification and
/// computed totals as they were at calc time (so a locked payslip is a faithful
/// historical record even after the employee/components later change).
model Payslip {
  id             String     @id @default(cuid())
  runId          String
  run            PayrollRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  employeeId     String
  employeeNumber String?
  categoryId     String?
  payGroupId     String?
  personId       String? // the identity this payslip settles credit against, if linked

  currency        String   @default("TZS")
  gross           Float    @default(0)
  taxable         Float    @default(0)
  pensionable     Float    @default(0)
  totalDeductions Float    @default(0)
  net             Float    @default(0)
  employerCost    Float    @default(0)
  status          String   @default("CALCULATED")
  warnings        String? // JSON array captured at calc time
  createdAt       DateTime @default(now())

  lines               PayslipLine[]
  paymentInstructions PaymentInstruction[]

  @@unique([runId, employeeId])
  @@index([employeeId])
}

/// An APPEND-ONLY line on a payslip — one per computed component, snapshotting
/// the component's code/name/type and the audit of the calc. Never edited.
model PayslipLine {
  id        String  @id @default(cuid())
  payslipId String
  payslip   Payslip @relation(fields: [payslipId], references: [id], onDelete: Cascade)

  componentCode String
  componentName String
  componentType String
  bucket        String // EARNING | DEDUCTION | EMPLOYER
  amount        Float
  taxable       Boolean  @default(false)
  pensionable   Boolean  @default(false)
  glMappingKey  String?
  // Free-text ref back to what a SOURCED line settled (e.g. "SignedBill x3"),
  // for the audit trail. Not an FK (a line can settle several bills).
  sourceRef     String?
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())

  @@index([payslipId])
}

/// Insert-only field-diff audit for payroll runs — the house pattern
/// (cf. BusinessDayAuditLog / WriteOffAuditLog). Coarse events are also emitted
/// to the global AuditLog for the supervisor audit viewer.
model PayrollAuditLog {
  id            String   @id @default(cuid())
  runId         String?
  action        String
  field         String?
  previousValue String?
  newValue      String?
  reason        String?
  userId        String?
  userName      String?
  createdAt     DateTime @default(now())

  @@index([runId])
}

// ─── Universal Payroll Framework (Phase 4 — statutory engine) ─────────────────
// Effective-dated tax / pension / social-security config — the COMPLIANCE PACK.
// Rates are NEVER in code: PAYE bands, PSSSF/NSSF, NHIF, WCF, SDL, etc. are
// StatutoryRule rows an authorized person seeds and keeps current, resolved by
// date so re-running an old period reproduces the rule in force then (the same
// historical-accuracy guarantee BusinessPeriodVersion gives periods). A
// PayComponent with calcMethod = SOURCED, parameters.source = "STATUTORY",
// parameters.statutoryCode = "PAYE" pulls its amount from the resolved rule
// (lib/payroll-statutory.ts); the component still owns classification (taxable /
// glMappingKey / EARNING-DEDUCTION-EMPLOYER bucket). The framework guarantees the
// MECHANISM (correct rule for the run's date); the RATES are the organisation's
// responsibility — this is not tax advice. See docs/payroll-framework-design.md §11.

/// One effective-dated statutory rule version. Resolve with the newest version
/// whose effectiveFrom <= target date (and effectiveTo null or >= date).
///   ruleType: TAX_BAND (progressive marginal bands) | FLAT_RATE | CAP | THRESHOLD
model StatutoryRule {
  id            String    @id @default(cuid())
  companyId     String
  code          String // e.g. "PAYE" | "PSSSF_EE" | "PSSSF_ER" | "NHIF" | "WCF" | "SDL"
  name          String
  jurisdiction  String    @default("TZ")
  authority     String?
  ruleType      String
  // The variable the rule reads from the payslip namespace (taxable | pensionable | gross | base).
  baseVar       String    @default("taxable")
  // Method-specific config as JSON:
  //   TAX_BAND:  {"bands": [[0,0],[270000,0.08],[520000,0.20],...]}  (marginal)
  //   FLAT_RATE: {"rate": 0.10}  (or use employeeRate/employerRate below)
  parameters    String?
  // Convenience flat rates (used when parameters.rate is absent).
  employeeRate  Float?
  employerRate  Float?
  ceiling       Float? // cap the base before applying the rate
  floor         Float? // no charge below this base
  // Where this line posts (FinanceAccountMapping key, e.g. PAYE_PAYABLE).
  glMappingKey  String?
  isEmployer    Boolean   @default(false) // employer contribution vs employee deduction
  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([companyId, code, effectiveFrom])
  @@index([companyId, code])
}

// ─── Universal Payroll Framework (Phase 4b — attendance & leave) ──────────────
// The inputs that feed the calc's attendance variables. AttendanceRecord is the
// single source of truth for a period's overtime + unpaid absences; the
// aggregator (lib/payroll-attendance.ts) turns it into overtimeHours / unpaidDays
// / daysWorked, which drive RATE_QTY overtime and the PRORATION of proratable
// earnings (an unpaid day reduces basic pay). Leave requests route through a
// role-gated approval; approving a request decrements the balance and writes the
// leave days as AttendanceRecord rows (PAID_LEAVE counts as worked; UNPAID_LEAVE
// prorates pay down) — one source, no dual-counting. See docs/payroll-framework-design.md §8.

/// One day of attendance for an employee (the pluggable capture point —
/// `source` records where it came from). @@unique([employeeId, date]) = one row
/// per day; the latest write wins (upsert).
model AttendanceRecord {
  id            String   @id @default(cuid())
  employeeId    String
  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date          DateTime // date-only (midnight); one row per calendar day
  source        String   @default("MANUAL")
  status        String   @default("PRESENT")
  hoursWorked   Float    @default(0)
  overtimeHours Float    @default(0)
  outletId      String?
  note          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([employeeId, date])
  @@index([employeeId, date])
}

/// Configurable leave scheme — Annual / Sick / Unpaid / Maternity / … . `paid`
/// decides the payroll impact: paid leave doesn't reduce pay; unpaid leave
/// prorates it down. Soft-deleted (status = INACTIVE).
model LeaveType {
  id                  String   @id @default(cuid())
  companyId           String
  code                String
  name                String
  description         String?
  status              String   @default("ACTIVE")
  paid                Boolean  @default(true)
  accrualDaysPerMonth Float    @default(0)
  maxCarryForward     Float? // cap on accrued balance carried across periods; null = uncapped
  encashable          Boolean  @default(false)
  requiresApproval    Boolean  @default(true)
  approverRoles       String? // JSON role array; falls back to the default approvers
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  balances LeaveBalance[]
  requests LeaveRequest[]

  @@unique([companyId, code])
  @@index([companyId, status])
}

/// Per-employee, per-type running balance. balance = accrued − taken (computed;
/// not stored, to avoid a third figure that can drift).
model LeaveBalance {
  id          String    @id @default(cuid())
  employeeId  String
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveTypeId String
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id])
  accrued     Float     @default(0)
  taken       Float     @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([employeeId, leaveTypeId])
  @@index([employeeId])
}

/// A leave request moved through PENDING → APPROVED/REJECTED (or CANCELLED).
/// Approving decrements the balance and writes the days as AttendanceRecord rows.
model LeaveRequest {
  id            String    @id @default(cuid())
  employeeId    String
  employee      Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveTypeId   String
  leaveType     LeaveType @relation(fields: [leaveTypeId], references: [id])
  startDate     DateTime
  endDate       DateTime
  days          Float // requested leave days (may differ from calendar span, e.g. excluding weekends)
  status        String    @default("PENDING")
  reason        String?
  requestedById String?
  approvedById  String?
  approvedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([employeeId, status])
  @@index([leaveTypeId])
}

// ─── Universal Payroll Framework (Phase 5 — payout & settlement) ──────────────
// The final step of the money loop. A POSTED run left a NET_PAY_PAYABLE liability
// (Cr) on the GL; a PaymentBatch exports the payout file (bank / mobile-money /
// cash) and, when marked PAID, posts the settlement entry (Dr NET_PAY_PAYABLE /
// Cr Cash-Bank-MobileMoney) that clears it — then the run becomes PAID. Reversing
// a PAID run also reverses this settlement. See docs/payroll-framework-design.md §9-10.

/// One payout batch per posted run. Materialized total + the settlement JE.
model PaymentBatch {
  id             String     @id @default(cuid())
  runId          String
  run            PayrollRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  companyId      String
  status         String     @default("PENDING")
  method         String     @default("BANK") // dominant/mixed method across instructions
  totalAmount    Float      @default(0)
  employeeCount  Int        @default(0)
  journalEntryId String? // the settlement entry, set when marked PAID
  createdById    String?
  exportedAt     DateTime?
  paidAt         DateTime?
  reversedAt     DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  instructions PaymentInstruction[]

  @@index([runId])
  @@index([companyId, status])
}

/// One payee line in a batch — an employee's net pay and how it's paid.
model PaymentInstruction {
  id         String       @id @default(cuid())
  batchId    String
  batch      PaymentBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  payslipId  String
  payslip    Payslip      @relation(fields: [payslipId], references: [id], onDelete: Cascade)
  employeeId String
  payeeName  String
  method     String       @default("BANK")
  payeeRef   String? // bank account / mobile-money handle (opaque)
  amount     Float
  status     String       @default("PENDING")
  createdAt  DateTime     @default(now())

  @@index([batchId])
}

// ─── Universal Expense & Disbursement Framework (Phase 1 — config + core workflow) ─
// A configuration & classification layer that turns the app's existing, working
// PettyCash/PettyFund flow into an industry-agnostic, admin-configurable expense
// module WITHOUT forking the Finance Platform. Nothing here replaces Account,
// JournalEntry/JournalLine, FinanceAccountMapping, CompanyPaymentAccount, Budget,
// AccountReconciliation, or PaymentVerification — those remain the single source
// of truth for money and GL posting. Instead these models generalize the
// currently-hardcoded PettyFunction / PettyFund / PettyCash.paymentMethod
// vocabulary into admin-defined records, so "Petty Cash Request", "Fuel",
// "M-Pesa" become configuration, not code. See
// docs/expense-disbursement-framework-design.md.
//
// Design decisions (Phase 1 scope, locked 2026-07-23):
//   • Rollout is side-by-side: PettyCash keeps working unmodified; the bridge FK
//     (PettyCash.expenseRequestId) is set only once a flow is migrated onto a
//     RequestType, one at a time.
//   • FundingSource balance: CASH types materialize currentBalance (same shape
//     as PettyFund); BANK/MOBILE_MONEY/CARD types store none — every read
//     computes it live from the wrapped CompanyPaymentAccount's GL balance
//     (lib/finance-banking.ts companyAccountBalance()), so the GL stays the
//     single source of truth for anything already backed by a real account.
//   • Budget scope is company-level only for Phase 1 — the existing Budget
//     model's outletId is already nullable, so per-outlet budgets are a later
//     config row, not a later schema change.
//   • Approval = existing WorkflowApproval (bridge FK expenseRequestId) + role-
//     based gating via RequestType.approverRoles JSON, mirroring CreditGroup.
//     approverRoles. A first-class WorkflowDefinition/Step graph is a later
//     phase, shared with Credit and Payroll once built — not forked now.
//   • No append-only ledger yet — FundingSource(CASH).currentBalance is a
//     maintained projection (lib/expense-payments.ts), same trust level as
//     CreditAccount.currentBalance.

/// Module identity + global switches — what "expense/disbursement" is CALLED
/// and how it behaves, per scope. Same GLOBAL→COMPANY→OUTLET, narrowest-wins
/// shape as CreditModuleConfig/CollectionModeConfig (resolved in
/// lib/expense-config.ts). Zero rows anywhere ⇒ module disabled / today's
/// PettyCash behavior, unchanged.
///   scope:           GLOBAL | COMPANY | OUTLET
///   allowOverBudget:  BLOCK | WARN | APPROVE
model ExpenseModuleConfig {
  id                    String   @id @default(cuid())
  scope                 String
  scopeId               String? // null only for GLOBAL; else a Company.id or Outlet.id
  moduleName            String   @default("Expense & Disbursement")
  terminology           String? // JSON map of generic label → tenant label
  enabled               Boolean  @default(true)
  defaultCurrency       String   @default("TZS")
  requireReceiptDefault Boolean  @default(true)
  allowMixedPayment     Boolean  @default(true)
  allowOverBudget       String   @default("WARN")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([scope, scopeId])
}

/// Admin-defined request type ("Petty Cash Request", "Site Expense Request",
/// "Activity Funding Request", ...). requiredFields/requiredAttachments/
/// allowed*Ids kept as JSON in Phase 1 (graduate to child tables when the admin
/// UI needs relational queries over them) — same trade-off CreditGroup already
/// made. approverRoles is a JSON array of role strings, e.g.
/// ["MANAGER","DIRECTOR"]; a first-class WorkflowDefinition graph replaces this
/// in a later phase. Soft-deleted (isActive) — historical requests reference it.
///   budgetValidation: NONE | WARN | BLOCK
model RequestType {
  id          String  @id @default(cuid())
  companyId   String
  company     Company @relation(fields: [companyId], references: [id])
  code        String // stable machine key, e.g. "PETTY_CASH_REQUEST"
  name        String // display, e.g. "Petty Cash Request"
  description String?
  isActive    Boolean @default(true)

  requiredFields             String? // JSON array of field keys
  requiredAttachments        String? // JSON array of doc-type labels
  allowedCategoryIds         String? // JSON id-array; empty/null = all categories
  allowedFundingSourceIds    String? // JSON id-array; empty/null = all funding sources
  budgetValidation           String  @default("WARN")
  approverRoles              String? // JSON array of role strings, ordered
  // M5 (verification workflow): JSON array of VerificationRecord.stage values
  // this request type requires before VALIDATED can advance PAID → VERIFIED.
  // null/empty = no stages required — VALIDATED alone is enough (see
  // lib/expense-verification.ts). RECEIPT_UPLOADED | RECEIPT_VERIFIED |
  // GOODS_CONFIRMED | VALIDATED.
  requiredVerificationStages String?
  attributes                 String? // extensibility escape hatch

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  requests ExpenseRequest[]
  fields   RequestTypeField[]

  @@unique([companyId, code])
  @@index([companyId, isActive])
}

/// Generalizes PettyFunction into an admin-defined expense category, mapped to
/// a real GL Account so Budget and FinanceAccountMapping work immediately with
/// no separate expense-specific mapping table. legacyFunctionName bridges to
/// existing PettyCash.functionName values with no data migration. Soft-deleted
/// (isActive) — historical requests reference it.
model ExpenseCategory {
  id                 String   @id @default(cuid())
  companyId          String
  company            Company  @relation(fields: [companyId], references: [id])
  code               String
  name               String // e.g. "Fuel", "Marketing"
  legacyFunctionName String? // bridges to PettyCash.functionName / PettyFunction.name
  budgetAccountId    String?
  budgetAccount      Account? @relation(fields: [budgetAccountId], references: [id])
  spendingLimit      Float    @default(0) // 0 = no category-level ceiling
  costCenter         String? // free-text tag; not an enforced relation (mirrors PettyCash.department)
  departmentId       String?
  eventId            String?
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  requests ExpenseRequest[]

  @@unique([companyId, code])
  @@index([companyId, isActive])
  @@index([legacyFunctionName])
}

/// Generalizes PettyFund + gives bank/mobile-money/card a first-class row
/// (today only a free-text PettyCash.paymentMethod). A CASH source has no GL
/// account behind it and materializes its own currentBalance (same shape as
/// PettyFund today). A BANK/MOBILE_MONEY/CARD source wraps a
/// CompanyPaymentAccount and stores NO materialized balance — every read
/// computes it live from that account's GL balance (lib/finance-banking.ts
/// companyAccountBalance()), so the ledger stays the single source of truth.
/// currentBalance is therefore only meaningful when sourceType = CASH; see
/// docs/expense-disbursement-framework-design.md Stage 16 decision 2.
/// CASHIER_DRAWER is a further sourceType: a cashier's own till, whose balance
/// is never materialized either — it is always computed live from that
/// cashier's current cash-recon position (lib/expense-ledger.ts
/// getFundingSourceBalance(), reusing app/api/cash-recon/route.ts's formula),
/// so scenario A ("cashier as custodian") needs no manual opening balance.
///   sourceType: CASH | BANK | MOBILE_MONEY | CARD | CASHIER_DRAWER | OTHER
model FundingSource {
  id                      String                 @id @default(cuid())
  companyId               String
  company                 Company                @relation(fields: [companyId], references: [id])
  code                    String
  name                    String // e.g. "Petty Cash", "CRDB Bank", "M-Pesa"
  sourceType              String                 @default("CASH")
  companyPaymentAccountId String? // set for BANK | MOBILE_MONEY | CARD; null for CASH/OTHER
  companyPaymentAccount   CompanyPaymentAccount? @relation(fields: [companyPaymentAccountId], references: [id])
  outletId                String?
  openingBalance          Float                  @default(0) // CASH only
  currentBalance          Float                  @default(0) // CASH only — see model doc above
  dailyLimit              Float                  @default(0) // 0 = no limit
  responsibleUserId       String? // no relation — mirrors CreditAccount.userId, keeps User untouched
  currency                String                 @default("TZS")
  isActive                Boolean                @default(true)
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt

  payments   ExpensePayment[]
  txns       FundingSourceTxn[]
  custodians FundingSourceCustodian[]

  @@unique([companyId, code])
  @@index([companyId, isActive])
  @@index([companyPaymentAccountId])
}

/// The Petty Cash Ledger — one signed-amount row per balance-affecting event on
/// a CASH/CASHIER_DRAWER FundingSource, mirroring PettyFundTxn's shape (which
/// this graduates from a materialized-only balance, per Stage 16's documented
/// "ledger is the scale-out path" deferral). expensePaymentId links PAYMENT
/// rows back to the disbursement that created them; it is a loose ref (no FK)
/// since not every txn type has one.
///   type: OPEN | REPLENISH | PAYMENT | ADJUST
model FundingSourceTxn {
  id               String        @id @default(cuid())
  fundingSourceId  String
  fundingSource    FundingSource @relation(fields: [fundingSourceId], references: [id])
  type             String
  amount           Float // signed: + for OPEN/REPLENISH, - for PAYMENT/negative ADJUST
  reference        String?
  note             String?
  expensePaymentId String?
  createdById      String?
  createdByName    String?
  createdAt        DateTime      @default(now())

  @@index([fundingSourceId, createdAt])
}

/// Admin-assigned Petty Cash / Digital Payment custodians — a many-to-many
/// so a FundingSource can have more than one responsible user, generalizing
/// the single optional FundingSource.responsibleUserId field.
model FundingSourceCustodian {
  id              String        @id @default(cuid())
  fundingSourceId String
  fundingSource   FundingSource @relation(fields: [fundingSourceId], references: [id])
  userId          String // no relation — mirrors CreditAccount.userId
  createdAt       DateTime      @default(now())

  @@unique([fundingSourceId, userId])
}

/// Generalizes PettyCash. One request may span many ExpenseItem lines and many
/// ExpensePayment disbursements (via PaymentAllocation) — fixing PettyCash's
/// 1:1 request→payment assumption. legacyPettyCashId is intentionally absent:
/// the bridge lives on PettyCash.expenseRequestId (see that model), so a
/// request created through this engine never needs a reverse pointer.
///   status: DRAFT | PENDING_APPROVAL | APPROVED | REJECTED | PARTIALLY_PAID |
///           PAID | VERIFIED | CLOSED | CANCELLED
model ExpenseRequest {
  id            String          @id @default(cuid())
  companyId     String
  company       Company         @relation(fields: [companyId], references: [id])
  requestTypeId String
  requestType   RequestType     @relation(fields: [requestTypeId], references: [id])
  categoryId    String
  category      ExpenseCategory @relation(fields: [categoryId], references: [id])
  requestedById String // no relation — mirrors CreditAccount.userId
  amount        Float           @default(0)
  currency      String          @default("TZS")
  purpose       String
  status        String          @default("DRAFT")
  outletId      String?
  departmentId  String?
  eventId       String?
  dueDate       DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  items              ExpenseItem[]
  paymentAllocations PaymentAllocation[]
  verifications      VerificationRecord[]
  workflowApprovals  WorkflowApproval[]
  legacyPettyCash    PettyCash[]
  fieldValues        ExpenseRequestFieldValue[]

  @@index([companyId, status])
  @@index([requestTypeId])
  @@index([categoryId])
  @@index([outletId])
}

/// Optional line-item breakdown of an ExpenseRequest — identical shape to
/// PettyCashItem (Detail · Unit · Unit Cost · Total). A request with no items
/// is a simple single-amount request.
model ExpenseItem {
  id               String         @id @default(cuid())
  expenseRequestId String
  expenseRequest   ExpenseRequest @relation(fields: [expenseRequestId], references: [id], onDelete: Cascade)
  detail           String
  unit             Float          @default(1)
  unitCost         Float          @default(0)
  amount           Float          @default(0)
  createdAt        DateTime       @default(now())

  @@index([expenseRequestId])
}

/// One disbursement against one FundingSource. Generalizes PettyFundTxn's
/// PAYMENT type into its own table so a single payment can be split across
/// PaymentAllocation rows against more than one ExpenseRequest, and a single
/// request can be paid by more than one ExpensePayment (part cash, part bank).
/// journalEntryId/verificationId are loose refs (same convention as
/// SupplierPayment.journalEntryId / JournalEntry.sourceId) — not relations —
/// since the source table varies and neither JournalEntry nor
/// PaymentVerification needs to know about this module.
model ExpensePayment {
  id              String        @id @default(cuid())
  fundingSourceId String
  fundingSource   FundingSource @relation(fields: [fundingSourceId], references: [id])
  amount          Float
  paymentMethod   String // CASH | CRDB | STANBIC | MPESA | ... (mirrors PaymentChannel.code)
  payeeName       String?
  payeeAccount    String?
  reference       String? // bank/MoMo txn id, cheque no.
  paidAt          DateTime      @default(now())
  paidById        String? // no relation — mirrors CreditAccount.userId
  journalEntryId  String? // loose ref to JournalEntry.id
  verificationId  String? // loose ref to PaymentVerification.id, set for digital payments
  createdAt       DateTime      @default(now())

  allocations PaymentAllocation[]

  @@index([fundingSourceId])
  @@index([reference])
}

/// One ExpensePayment → one ExpenseRequest, with amount — the join that makes
/// partial + mixed-source + installment payment possible. Sum of allocations
/// for a request, compared to ExpenseRequest.amount, drives the
/// PARTIALLY_PAID/PAID status transition (lib/expense-payments.ts).
model PaymentAllocation {
  id               String         @id @default(cuid())
  expensePaymentId String
  expensePayment   ExpensePayment @relation(fields: [expensePaymentId], references: [id], onDelete: Cascade)
  expenseRequestId String
  expenseRequest   ExpenseRequest @relation(fields: [expenseRequestId], references: [id], onDelete: Cascade)
  amount           Float
  createdAt        DateTime       @default(now())

  @@index([expensePaymentId])
  @@index([expenseRequestId])
}

/// One row per verification stage reached for an ExpenseRequest. Payment alone
/// never advances status past PAID — reaching VERIFIED/CLOSED requires the
/// stages the request's RequestType marks mandatory.
///   stage: RECEIPT_UPLOADED | RECEIPT_VERIFIED | GOODS_CONFIRMED | VALIDATED
model VerificationRecord {
  id               String         @id @default(cuid())
  expenseRequestId String
  expenseRequest   ExpenseRequest @relation(fields: [expenseRequestId], references: [id], onDelete: Cascade)
  stage            String
  verifiedById     String? // no relation — mirrors CreditAccount.userId
  verifiedAt       DateTime       @default(now())
  note             String?
  attachmentId     String? // loose ref to Attachment.id

  @@index([expenseRequestId, stage])
}

/// Generic file/receipt/proof record. entityType+entityId is a loose ref (same
/// convention as JournalEntry.sourceType/sourceId) rather than a relation per
/// entity kind, since Phase 1 only needs it for ExpenseRequest/ExpensePayment/
/// VerificationRecord but the shape should not need a schema change to attach
/// to a new entity kind later.
///   docType: RECEIPT | INVOICE | PROOF_OF_PAYMENT | SCREENSHOT | OTHER
model Attachment {
  id           String   @id @default(cuid())
  entityType   String
  entityId     String
  url          String
  docType      String   @default("RECEIPT")
  uploadedById String? // no relation — mirrors CreditAccount.userId
  createdAt    DateTime @default(now())

  @@index([entityType, entityId])
}

/// Admin-defined custom field for a RequestType — graduates the Phase 1
/// requiredFields JSON escape hatch to a real child table (the trade-off the
/// design doc explicitly flagged: "graduate to child tables when the admin UI
/// needs relational queries over them"). Powers the Digital Expense Request
/// form: isSystem=true rows are the seeded defaults (Date, Payee Name,
/// Account/Wallet Number, Phone Number, Payment Reason) which admins can
/// relabel/reorder/require but not delete; admins can freely add further
/// isSystem=false fields on top, with zero code changes.
///   fieldType: TEXT | NUMBER | DATE | PHONE | TEXTAREA | SELECT
model RequestTypeField {
  id            String      @id @default(cuid())
  requestTypeId String
  requestType   RequestType @relation(fields: [requestTypeId], references: [id])
  fieldKey      String // stable machine key, e.g. "payeeAccount"
  label         String
  fieldType     String      @default("TEXT")
  required      Boolean     @default(false)
  options       String? // JSON array of option strings, SELECT only
  sortOrder     Int         @default(0)
  isSystem      Boolean     @default(false)
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())

  @@unique([requestTypeId, fieldKey])
  @@index([requestTypeId, isActive])
}

/// The data for RequestTypeField-defined custom fields on one ExpenseRequest.
/// Values are always strings (dates/numbers/phones stored as their text
/// representation) — same "typed columns for the 80%, generic rows for the
/// long tail" trade-off as CollectionFieldValue.
model ExpenseRequestFieldValue {
  id               String         @id @default(cuid())
  expenseRequestId String
  expenseRequest   ExpenseRequest @relation(fields: [expenseRequestId], references: [id], onDelete: Cascade)
  fieldKey         String
  value            String

  @@unique([expenseRequestId, fieldKey])
}
