generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// NOTE: SQLite does not support native enums. The following values are
// enforced at the application layer:
//   Role:          CASHIER | ACCOUNTANT | MANAGER | DIRECTOR | ADMIN | WAITER
//   PaymentMethod: CASH | CRDB | STANBIC | MPESA
//   BillType:      ADMIN | DIRECTOR | CUSTOMER | TIPS | DJ | STAFF_LOSS
//   BillStatus:    UNPAID | PARTIAL | PAID
//   ShiftType:     MORNING (09:00–16:00) | EVENING (16:00–05:00)
//   ScheduleRole:  WAITER | SUPERVISOR | BARTENDER | CASHIER | HOSTESS
//   AssignSource:  AUTO | MANUAL
//   AbsenceReason: LEAVE | ABSENT | OTHER
//   EventExpense.paymentStatus: UNPAID | PARTIAL | PAID (same vocabulary as BillStatus)
//   EventSponsor.sponsorshipType:   CASH | IN_KIND | MEDIA | OTHER
//   EventSponsor.agreementStatus:   PENDING | SIGNED | FULFILLED
//   EventTarget.type:               SALES | PROCUREMENT
//   TicketBooking.paymentStatus:    UNPAID | PARTIAL | PAID
//   TicketBooking.bookingStatus:    PENDING | CONFIRMED | CANCELLED
//   EventTable.status:              AVAILABLE | RESERVED | OCCUPIED
//   TableBooking.bookingStatus:     PENDING | CONFIRMED | CANCELLED
//   Person.codeMode:                          AUTO | MANUAL | EMPLOYEE_NUMBER | CUSTOMER_NUMBER | MEMBERSHIP_NUMBER | SUPPLIER_CODE
//   BillReferenceConfig.dateFormat:            YYMMDD | DDMMYY | YYYYMMDD | DD-MM-YYYY | MM-YYYY | CUSTOM
//   BillReferenceConfig.separator:             "-" | "/" | "_" | "." | NONE
//   BillReferenceConfig.personNumberingMode:   AUTO | MANUAL | EMPLOYEE_NUMBER | CUSTOMER_NUMBER | MEMBERSHIP_NUMBER | SUPPLIER_CODE
//   BillReferenceConfig.sequenceResetRule:     NEVER | DAILY | MONTHLY | YEARLY | PER_PERSON | PER_BILL_TYPE
//   BillReferenceComponent.type:               DATE | BILL_TYPE_CODE | PERSON_CODE | SEQUENCE | COMPANY_CODE | BRANCH_CODE | DEPARTMENT_CODE | COUNTER_CODE | OUTLET_CODE | STATIC_TEXT
//   BillTypeConfig.category:                   SIGNED_BILL | PAID_BILL | EXCESS_PAYMENT | EXCESS_REFUND | LOSS_RECORD
//   ExcessRefund.reason:                       OVERPAYMENT | DUPLICATE_PAYMENT | OTHER
//   ExcessRefund.approvalStatus:                PENDING | APPROVED | REJECTED

model User {
  id                String    @id @default(cuid())
  name              String
  email             String    @unique
  password          String
  role              String
  outletId          String?
  outlet            Outlet?   @relation(fields: [outletId], references: [id])
  isActive          Boolean   @default(true)
  // Forgot-password flow: a hashed, single-use token with a short expiry.
  // Never store the raw token — only its SHA-256 hash (see lib/auth.ts).
  resetToken        String?   @unique
  resetTokenExpiry  DateTime?
  // Streamlined MyPOS staff login: WAITER accounts sign in by tapping their
  // name and entering a short numeric PIN instead of email+password. `pin`
  // is a bcrypt hash (same as `password`), never the raw digits. `position`
  // is the floor role shown on the picker tile (OUTSIDE STAFF | BAR LADY |
  // VIP BAR) — informational only, not enforced by the system.
  pin               String?
  position          String?
  pinFailedAttempts Int       @default(0)
  pinLockedUntil    DateTime?
  // Casual/temporary worker (event day labour, outlet cover) — a real User
  // record so scheduling/event-assignment logic works unchanged, but excluded
  // from auto-rostering and from the permanent staff list by default.
  isCasual          Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  dailyCollections    DailyCollection[]
  signedBills         SignedBill[]
  paidBills           PaidBill[]
  auditLogs           AuditLog[]
  posOrders           PosOrder[]
  posWaiterSessions   PosWaiterSession[]
  scheduleAssignments ScheduleAssignment[]
  unavailabilities    StaffUnavailability[]
  eventStaff          EventStaff[]
  pushSubscriptions   PushSubscription[]
  permissions         UserPermission[]
  excessRefunds       ExcessRefund[]
}

/// Per-user, per-resource grant of Add/Edit/Delete(/Settle/Unsettle for
/// EXCESS_RECON), set only by the system owner (see lib/rbac.ts). Additive on
/// top of existing role/email checks — the owner always has full access
/// regardless of rows here. canSettle/canUnsettle are only meaningful for the
/// EXCESS_RECON resource; other resources leave them false/unused.
model UserPermission {
  id          String   @id @default(cuid())
  userId      String
  resource    String // 'PAID_BILLS' | 'SIGNED_BILLS' | 'PERSONS' | 'PRODUCTS' | 'EXCESS_RECON'
  canAdd      Boolean  @default(false)
  canEdit     Boolean  @default(false)
  canDelete   Boolean  @default(false)
  canSettle   Boolean  @default(false)
  canUnsettle Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, resource])
}

/// A browser's Web Push subscription for one user's device. Lets the server
/// send a real OS-level notification (works even if the tab is backgrounded
/// or closed) -- used for "order ready to collect" alerts on MyPos, where an
/// in-page beep is unreliable once a phone's tab isn't the active one.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

model Outlet {
  id           String   @id @default(cuid())
  name         String   @unique
  location     String?
  isActive     Boolean  @default(true)
  // Events-only outlets (e.g. "Tips Events") are NOT included in the automatic
  // weekly roster — staff are only assigned temporarily when an event is created.
  isEventsOnly Boolean  @default(false)
  // Printed-bill header details (company legal name + tax IDs). Shown on the
  // customer/in-house bill; the outlet name appears in parentheses beside them.
  legalName    String?
  tin          String?
  vrn          String?
  // Optional code backing the BRANCH_CODE/COMPANY_CODE bill-reference
  // components (see lib/bill-reference.ts). Falls back to a slugified
  // Outlet.name when unset.
  branchCode   String?
  createdAt    DateTime @default(now())

  users               User[]
  dailyCollections    DailyCollection[]
  signedBills         SignedBill[]
  paidBills           PaidBill[]
  posTables           PosTable[]
  posShifts           PosShift[]
  posCounters         PosCounter[]
  posStockRequests    PosStockRequest[]
  stockLevels         StockLevel[]
  stockTransfers      StockTransfer[]
  posOrders           PosOrder[]
  posBlockedItems     PosBlockedItem[]
  dayClosures         DayClosure[]
  salesMetrics        SalesMetric[]
  scheduleAssignments ScheduleAssignment[]
  scheduleConfig      OutletScheduleConfig?
  events              Event[]
  excessRefunds       ExcessRefund[]
  salesTargets        SalesTarget[]
}

/// Uploaded per-staff sales figures that the POS/collections don't capture
/// directly — Shisha (count) for Mikocheni and Food (TZS) for Coco. Used to
/// measure actuals against the Targets.
model SalesMetric {
  id          String   @id @default(cuid())
  date        DateTime
  outletId    String?
  outlet      Outlet?  @relation(fields: [outletId], references: [id])
  department  String // SHISHA | FOOD
  staffName   String
  value       Float    @default(0) // shisha count, or food sales amount (TZS)
  createdById String?
  createdAt   DateTime @default(now())

  @@index([date])
  @@index([department])
  @@index([outletId])
}

/// Admin-managed sales/KPI targets — replaces the old hard-coded TARGETS
/// array in lib/targets.ts. weeklyTarget stores a 7-day figure; daily/monthly
/// levels derive from it (see lib/targets.ts targetLevels). Seeded once with
/// the previous hard-coded values on first read (see lib/sales-targets.ts).
///   scope: Per Staff | Per Outlet | Per Manager
///   unit:  TZS (currency) | COUNT (unitLabel names the thing counted)
model SalesTarget {
  id           String   @id @default(cuid())
  outletId     String
  outlet       Outlet   @relation(fields: [outletId], references: [id])
  scope        String
  department   String // e.g. "Total Collection", "Shisha Sales", "Food Sales"
  unit         String   @default("TZS")
  unitLabel    String? // e.g. "shisha" when unit = COUNT
  weeklyTarget Float    @default(0)
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([outletId])
  @@index([isActive])
}

/// Locks an uploaded sales day (outlet + department + date) so its SalesMetric
/// rows can't be deleted/re-uploaded. Any uploader can lock; only an Admin
/// (super user) can unlock.
model SalesMetricLock {
  id         String   @id @default(cuid())
  outletId   String?
  department String
  date       DateTime
  lockedBy   String
  lockedById String?
  lockedAt   DateTime @default(now())

  @@unique([outletId, department, date])
  @@index([department])
}

/// Locks a single outlet's day. Once a (outlet, date) is closed, cashiers can no
/// longer create/edit/delete that day's collections. Reopening is supervisor-only.
model DayClosure {
  id         String   @id @default(cuid())
  outletId   String
  outlet     Outlet   @relation(fields: [outletId], references: [id])
  date       DateTime
  closedBy   String
  closedById String?
  closedAt   DateTime @default(now())

  @@unique([outletId, date])
  @@index([outletId])
}

model DailyCollection {
  id               String   @id @default(cuid())
  date             DateTime @default(now())
  cash             Float    @default(0)
  crdb             Float    @default(0)
  stanbic          Float    @default(0)
  mpesa            Float    @default(0)
  total            Float    @default(0)
  staffName        String?
  systemSales      Float    @default(0)
  creditSales      Float    @default(0)
  paymentsReceived Float    @default(0)
  discount         Float    @default(0) // authorized discount — reduces staff loss
  discountReason   String?
  notes            String?
  outletId         String
  outlet           Outlet   @relation(fields: [outletId], references: [id])
  cashierId        String
  cashier          User     @relation(fields: [cashierId], references: [id])
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  cancellations Cancellation[]
  channels      DailyCollectionChannel[]
  excessItems   CollectionExcess[]

  @@index([date])
  @@index([outletId])
}

// Per-channel amounts for a Daily Collection — lets Setup > Payment Channels
// add new digital channels (e.g. "CRDB Lipa Hapa") without a code change.
// The fixed crdb/stanbic/mpesa columns above are still dual-written for the
// 3 default channels so older read paths keep working unmodified; readers
// that want the full dynamic list should prefer these rows, falling back to
// the fixed columns only when a collection has none (pre-migration rows).
model DailyCollectionChannel {
  id           String          @id @default(cuid())
  collectionId String
  collection   DailyCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  channelCode  String // matches PaymentChannel.code (CRDB, STANBIC, MPESA, CRDB_LIPA_HAPA, ...)
  amount       Float           @default(0)
  createdAt    DateTime        @default(now())

  @@unique([collectionId, channelCode])
  @@index([collectionId])
}

model Person {
  id          String   @id @default(cuid())
  name        String
  phone       String?
  email       String?
  type        String
  creditLimit Float    @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  // Bill Reference System — the "Person Code/Number" component (see
  // lib/bill-reference.ts). codeMode governs how `code` was/should be
  // populated: AUTO (assigned by the shared sequence engine) | MANUAL |
  // EMPLOYEE_NUMBER | CUSTOMER_NUMBER | MEMBERSHIP_NUMBER | SUPPLIER_CODE.
  // Scoped unique per `type` (not globally) so e.g. customer #14 and staff
  // #14 can coexist without forcing one to skip ahead.
  code     String?
  codeMode String  @default("AUTO")

  signedBills   SignedBill[]
  paidBills     PaidBill[]
  excessRefunds ExcessRefund[]

  @@unique([type, code])
  @@index([type])
}

model SignedBill {
  id             String    @id @default(cuid())
  date           DateTime  @default(now())
  // Legacy voucher — kept (not dropped) because it's overloaded today as a
  // deterministic idempotency key for auto-generated bills (see
  // lib/staff-loss.ts, app/api/collections/route.ts). New auto-created bills
  // use `autoKey` for that role instead; `voucherNumber` becomes read-only
  // legacy/display data once a bill has been migrated (see legacyReference).
  voucherNumber  String?   @unique
  // Idempotency key for auto-generated bills (e.g. "SL-<collectionId>",
  // "VCH-<collectionId>-<i>") — replaces voucherNumber's old lookup role.
  autoKey        String?   @unique
  billType       String
  personId       String?
  person         Person?   @relation(fields: [personId], references: [id])
  personName     String
  amount         Float
  serviceStaff   String?
  description    String?
  dueDate        DateTime?
  status         String    @default("UNPAID")
  approvalStatus String    @default("PENDING") // PENDING | APPROVED | REJECTED (used for Tips/DJ bill requests)
  approvedBy     String?
  outletId       String
  outlet         Outlet    @relation(fields: [outletId], references: [id])
  cashierId      String
  cashier        User      @relation(fields: [cashierId], references: [id])
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Bill Reference System (see lib/bill-reference.ts). internalBillId is the
  // permanent, never-changing system id ("B-YYYYMMDD-NNNNNN");
  // displayReference is the admin-configurable, human-facing reference.
  // Nullable until the one-time backfill (scripts/backfill-bill-references.ts
  // / the Bill Reference Settings page's Data Migration panel) completes in
  // each environment, then tightened to NOT NULL in a follow-up deploy.
  // legacyReference preserves the old voucherNumber value verbatim so an
  // already-printed paper bill stays searchable after migration.
  internalBillId         String?         @unique
  displayReference       String?         @unique
  legacyReference        String?
  billTypeConfigId       String?
  billTypeConfig         BillTypeConfig? @relation(fields: [billTypeConfigId], references: [id])
  // Replaces the fragile `voucherNumber.startsWith('SL-')` string-parse
  // (see app/api/reports/excess-loss/route.ts) with an explicit column.
  autoSourceCollectionId String?

  payments PaidBill[]
  items    BillItem[]

  @@index([date])
  @@index([billType])
  @@index([status])
  @@index([outletId])
  @@index([personId])
}

// Product line items on a signed bill (Customer / Tips / DJ etc.).
model BillItem {
  id           String     @id @default(cuid())
  signedBillId String
  signedBill   SignedBill @relation(fields: [signedBillId], references: [id], onDelete: Cascade)
  productId    String?
  product      Product?   @relation(fields: [productId], references: [id])
  productName  String
  unitPrice    Float      @default(0)
  quantity     Float      @default(0)
  amount       Float      @default(0) // unitPrice * quantity
  createdAt    DateTime   @default(now())

  @@index([signedBillId])
  @@index([productId])
}

model PaidBill {
  id            String      @id @default(cuid())
  date          DateTime    @default(now())
  // Free-text/correlation field — NOT the Bill Reference System's reference.
  // Also doubles as a correlation key ("COL-<collectionId>",
  // "PAYROLL-<periodLabel>") and a report-grouping key
  // (app/api/reports/daily-cashier/route.ts) — left untouched by design.
  billRef       String?
  signedBillId  String?
  signedBill    SignedBill? @relation(fields: [signedBillId], references: [id])
  personId      String?
  person        Person?     @relation(fields: [personId], references: [id])
  payerCategory String?
  payerName     String
  amountPaid    Float
  paymentMethod String
  notes         String?
  outletId      String
  outlet        Outlet      @relation(fields: [outletId], references: [id])
  cashierId     String
  cashier       User        @relation(fields: [cashierId], references: [id])
  createdAt     DateTime    @default(now())

  // Bill Reference System (see lib/bill-reference.ts / SignedBill above).
  internalBillId   String?         @unique
  displayReference String?         @unique
  legacyReference  String?
  billTypeConfigId String?
  billTypeConfig   BillTypeConfig? @relation(fields: [billTypeConfigId], references: [id])

  @@index([date])
  @@index([outletId])
  @@index([signedBillId])
}

model PettyCash {
  id            String   @id @default(cuid())
  date          DateTime @default(now())
  requestedBy   String
  department    String?
  functionName  String? // e.g. Purchases of | Allowance | Transport
  purpose       String
  amount        Float    @default(0)
  paymentMethod String // CASH | CRDB | STANBIC | MPESA (actual disbursement method)
  payeeName     String?
  payeeAccount  String?
  paymentStatus String?  @default("UNPAID") // PAID | UNPAID — has the cash actually been paid out
  approvedBy    String?
  status        String   @default("PENDING") // PENDING | APPROVED | REJECTED
  outletId      String?
  cashierId     String
  createdAt     DateTime @default(now())

  // Payment module — which fund disburses and the disbursement record.
  pettyType  String    @default("CASHIER") // CASHIER (drawer) | ACCOUNTANT (allocated fund)
  fundId     String? // set when paid from an accountant PettyFund
  paidAt     DateTime?
  paidById   String?
  paidByName String?
  receiptUrl String? // payment receipt (image/pdf data URL or link)

  items PettyCashItem[]

  @@index([date])
  @@index([status])
  @@index([paymentStatus])
  @@index([pettyType])
}

// A management-allocated petty-cash fund operated by an Accountant. Payments
// against approved requests draw down this fund; replenishments top it up.
model PettyFund {
  id             String    @id @default(cuid())
  name           String // e.g. "Accountant Fund — HQ"
  ownerId        String? // accountant who operates the fund
  ownerName      String?
  outletId       String?
  openingBalance Float     @default(0)
  depositDate    DateTime? // date the petty cash was deposited/allocated
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())

  txns PettyFundTxn[]

  @@index([outletId])
}

// Every movement on a PettyFund. amount is signed: + adds (opening/replenish),
// - reduces (payment/adjustment). currentBalance = openingBalance + sum(amount).
model PettyFundTxn {
  id            String    @id @default(cuid())
  fundId        String
  fund          PettyFund @relation(fields: [fundId], references: [id], onDelete: Cascade)
  type          String // REPLENISH | PAYMENT | ADJUST
  amount        Float // signed delta
  pettyCashId   String? // links a PAYMENT to the request it settled
  note          String?
  createdById   String?
  createdByName String?
  createdAt     DateTime  @default(now())

  @@index([fundId])
  @@index([pettyCashId])
}

/// Optional line-item breakdown of a cash request (Detail · Unit · Unit Cost · Total).
/// A request with no items is a simple single-amount request.
model PettyCashItem {
  id          String    @id @default(cuid())
  pettyCashId String
  pettyCash   PettyCash @relation(fields: [pettyCashId], references: [id], onDelete: Cascade)
  detail      String
  unit        Float     @default(1)
  unitCost    Float     @default(0)
  amount      Float     @default(0)
  createdAt   DateTime  @default(now())

  @@index([pettyCashId])
}

// Departments selectable on the cash-request form (managed in /departments).
model Department {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

// Functions selectable on the cash-request form (e.g. Purchases of, Allowance, Transport).
model PettyFunction {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

// Product catalogue (managed in /products).
model Product {
  id              String   @id @default(cuid())
  code            String   @unique // auto-generated, human-readable e.g. COC-001
  name            String
  category        String? // e.g. "Beers", "Spirits", "Soft Drinks"
  buyingPrice     Float    @default(0)
  sellingPrice    Float    @default(0)
  unitMeasure     String // unit | kg | crate 24 bottle | crate 25 bottle | crate 6 bottle
  isActive        Boolean  @default(true)
  // Counter stock tracking (see StockLevel/StockLedgerEntry below). WEIGHT
  // items (e.g. shisha flavours) are counted in grams; gramsPerServing
  // converts a gram reading into sellable servings, same conversion the
  // business already does by hand on paper stock-take sheets.
  trackingMode    String   @default("UNIT") // UNIT | WEIGHT
  gramsPerServing Float?
  createdAt       DateTime @default(now())

  cancellations      Cancellation[]
  billItems          BillItem[]
  posOrderItems      PosOrderItem[]
  posBlockedItems    PosBlockedItem[]
  stockLevels        StockLevel[]
  grnItems           GrnItem[]
  stockTransferItems StockTransferItem[]
  purchaseOrderItems PurchaseOrderItem[]
  eventProducts      EventProduct[]

  @@index([name])
}

/// A central stock location that is not a POS counter — e.g. "Main Store".
/// Kept as its own table (not a hardcoded constant) so a future second
/// warehouse needs no schema change. Single row today.
model Warehouse {
  id        String   @id @default(cuid())
  name      String   @unique // "Main Store"
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  stockLevels   StockLevel[]
  ledgerEntries StockLedgerEntry[]
  grns          Grn[]
  transfersOut  StockTransfer[]
}

/// Current quantity of one product at one location — pieces, or grams when
/// the product's trackingMode is WEIGHT. A row only exists once someone has
/// restocked/received/transferred that product to that location at least
/// once: tracking is opt-in, not pre-created for every Product×Counter×
/// Outlet combination, most of which nobody stocks there.
/// Exactly one of (outletId+counterCode) or warehouseId is set on any given
/// row — never both, never neither — enforced at the application layer in
/// lib/stock.ts, not by the schema.
model StockLevel {
  id          String     @id @default(cuid())
  productId   String
  product     Product    @relation(fields: [productId], references: [id])
  outletId    String?
  outlet      Outlet?    @relation(fields: [outletId], references: [id])
  counterCode String? // MAIN | VIP | SHISHA | KITCHEN
  warehouseId String?
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id])
  quantity    Float      @default(0)
  updatedAt   DateTime   @updatedAt

  @@unique([productId, outletId, counterCode, warehouseId])
  @@index([outletId, counterCode])
  @@index([warehouseId])
}

/// Every stock quantity change, ever — mirrors the "never delete, only
/// reverse" audit principle already used for PosOrder/PosOrderItem history.
/// Exactly one of (outletId+counterCode) or warehouseId is set, mirroring
/// StockLevel — an entry always describes a movement at one location.
model StockLedgerEntry {
  id           String     @id @default(cuid())
  productId    String
  productName  String // snapshot, same pattern as PosOrderItem.productName
  outletId     String?
  counterCode  String?
  warehouseId  String?
  warehouse    Warehouse? @relation(fields: [warehouseId], references: [id])
  type         String // RESTOCK | SALE | ADJUSTMENT | GRN_RECEIVE | TRANSFER_OUT | TRANSFER_IN | BREAKAGE
  quantity     Float // signed — negative for sales/deductions/outflows
  balanceAfter Float
  note         String?
  refType      String? // "PosOrderItem" | "Grn" | "StockTransfer"
  refId        String?
  createdById  String
  createdAt    DateTime   @default(now())

  @@index([productId, outletId, counterCode, createdAt])
  @@index([productId, warehouseId, createdAt])
}

/// A vendor TIPS buys from. Price history lives on PurchaseOrderItem, not
/// here, so "cheapest supplier for X" is a query, not a separate table.
model Supplier {
  id            String   @id @default(cuid())
  name          String   @unique
  contactPerson String?
  phone         String?
  email         String?
  paymentTerms  String? // e.g. "30 days", "Cash on delivery"
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  purchaseOrders PurchaseOrder[]
}

/// A Purchase Order to a supplier. status is the workflow engine: DRAFT ->
/// PENDING_APPROVAL -> APPROVED -> SENT -> PARTIALLY_RECEIVED ->
/// FULLY_RECEIVED, with REJECTED/CANCELLED as terminal off-ramps. Approval
/// and receiving are handled in lib/stock.ts (submitForApproval,
/// decidePurchaseOrder, receiveGrn).
model PurchaseOrder {
  id              String    @id @default(cuid())
  poNumber        String    @unique // "PO-000001"
  supplierId      String
  supplier        Supplier  @relation(fields: [supplierId], references: [id])
  status          String    @default("DRAFT")
  outletIds       String // JSON array — informational, a PO can be for more than one outlet
  orderDate       DateTime  @default(now())
  expectedDate    DateTime?
  subtotal        Float     @default(0)
  vatRate         Float     @default(0.18)
  vatAmount       Float     @default(0)
  total           Float     @default(0)
  paymentTerms    String?
  notes           String?
  createdById     String
  approvedById    String?
  approvedAt      DateTime?
  cancelledReason String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  items PurchaseOrderItem[]
  grns  Grn[]

  @@index([status])
  @@index([supplierId])
}

model PurchaseOrderItem {
  id               String        @id @default(cuid())
  purchaseOrderId  String
  purchaseOrder    PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId        String
  product          Product       @relation(fields: [productId], references: [id])
  productName      String // snapshot, same pattern as PosOrderItem.productName
  purchaseUnit     String // "Carton", "Bottle", "Case" — the unit the supplier sells in
  packSize         Float         @default(1) // pieces per purchase unit
  quantity         Float // quantity in purchaseUnit, e.g. 10 cartons
  unitPrice        Float
  amount           Float
  quantityReceived Float         @default(0) // running total across all GRNs against this line, in purchaseUnit

  @@index([purchaseOrderId])
}

/// A no-PO, free-form goods-received note — records physical receipt of
/// stock into a Warehouse. Supplier is plain text when there's no PO;
/// purchaseOrderId links it to a formal PO instead when receiving against
/// one. One Grn creates one GRN_RECEIVE ledger entry per line and bumps
/// Main Store StockLevel in a single transaction (see lib/stock.ts
/// receiveGrn).
model Grn {
  id              String         @id @default(cuid())
  grnNumber       String         @unique // "GRN-000123"
  warehouseId     String
  warehouse       Warehouse      @relation(fields: [warehouseId], references: [id])
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  supplierName    String
  invoiceRef      String?
  receivedDate    DateTime       @default(now())
  note            String?
  createdById     String
  createdAt       DateTime       @default(now())

  items GrnItem[]

  @@index([warehouseId])
  @@index([receivedDate])
  @@index([purchaseOrderId])
}

/// One line of a Grn. Quantity is entered in a purchase unit (e.g.
/// "Carton") with a packSize (pieces/grams per unit); piecesReceived is the
/// derived, persisted total actually added to stock — same conversion
/// principle as Product.trackingMode/gramsPerServing on the sell side.
/// purchaseOrderItemId is a loose id link (like StockLedgerEntry.refId),
/// not a FK relation, since not every GrnItem receives against a PO line.
model GrnItem {
  id                  String   @id @default(cuid())
  grnId               String
  grn                 Grn      @relation(fields: [grnId], references: [id], onDelete: Cascade)
  purchaseOrderItemId String?
  productId           String
  product             Product  @relation(fields: [productId], references: [id])
  productName         String // snapshot, same convention as StockLedgerEntry.productName
  purchaseUnit        String // e.g. "Carton", "Piece", "Kg"
  packSize            Float    @default(1) // pieces (or grams) per purchaseUnit
  quantityOrdered     Float // quantity in purchaseUnit, e.g. 10 (Cartons)
  piecesReceived      Float // derived: quantityOrdered * packSize, in stock units
  unitCost            Float? // optional, per purchaseUnit — not used by stock math
  createdAt           DateTime @default(now())

  @@index([grnId])
  @@index([productId])
}

/// A single atomic Main Store -> Outlet Counter stock movement, issued by a
/// manager in one action (no separate request/approve/issue steps in this
/// phase — see lib/stock.ts issueTransfer). Always warehouse -> counter;
/// never the reverse (no returns) and never warehouse -> warehouse.
model StockTransfer {
  id             String    @id @default(cuid())
  transferNumber String    @unique // "TRF-000045"
  warehouseId    String
  warehouse      Warehouse @relation(fields: [warehouseId], references: [id])
  outletId       String
  outlet         Outlet    @relation(fields: [outletId], references: [id])
  counterCode    String
  note           String?
  createdById    String
  createdAt      DateTime  @default(now())

  items StockTransferItem[]

  @@index([warehouseId])
  @@index([outletId, counterCode])
}

model StockTransferItem {
  id          String        @id @default(cuid())
  transferId  String
  transfer    StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  productId   String
  product     Product       @relation(fields: [productId], references: [id])
  productName String
  quantity    Float // stock units (pieces/grams) — no pack conversion here
  createdAt   DateTime      @default(now())

  @@index([transferId])
  @@index([productId])
}

/// A physical stock count, comparing what the ledger says should be there
/// against what's actually counted — the loop automatic stock tracking
/// alone can't close (spillage/theft/breakage that never shows up as a
/// recorded sale). Single-step: counted and submitted in one action, no
/// separate review step (see lib/stock.ts submitStockCount). scope
/// distinguishes a daily counter count (outletId+counterCode set) from a
/// monthly Main Store count (warehouseId set) — exactly one of the two is
/// set per row, same convention StockLevel already uses.
model StockCountSession {
  id             String   @id @default(cuid())
  scope          String   @default("COUNTER_DAILY") // COUNTER_DAILY | STORE_MONTHLY
  outletId       String?
  counterCode    String?
  warehouseId    String?
  countDate      DateTime @default(now())
  status         String   @default("IN_PROGRESS") // IN_PROGRESS | SUBMITTED
  conductedById  String
  totalLossValue Float    @default(0)
  createdAt      DateTime @default(now())

  items        StockCountItem[]
  attributions StockLossAttribution[]

  @@index([outletId, counterCode])
  @@index([warehouseId])
  @@index([countDate])
}

/// One product's line in a count. Replays the real stock-take workbook's
/// own columns: B/F + Receivings + TransfersIn − TransfersOut =
/// Closing(System); vs. Closing(Physical) gives ExpectedSales; vs. actual
/// POS sales gives the variance — see lib/stock.ts's reconciliation math.
model StockCountItem {
  id               String            @id @default(cuid())
  sessionId        String
  session          StockCountSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  productId        String
  productName      String // snapshot
  openingBalance   Float
  receivings       Float             @default(0)
  transfersIn      Float             @default(0)
  transfersOut     Float             @default(0) // always 0 today — no counter→store returns yet
  closingSystem    Float // = opening + receivings + transfersIn − transfersOut
  closingPhysical  Float             @default(0) // the actual count — units, or grams if trackingMode=WEIGHT
  posSalesQty      Float             @default(0) // pulled from the SALE ledger entries in the same window
  expectedSalesQty Float             @default(0) // = closingSystem − closingPhysical
  varianceQty      Float             @default(0) // = posSalesQty − expectedSalesQty
  unitCost         Float // Product.buyingPrice at count time
  varianceValue    Float             @default(0) // = (varianceQty − discountQty − breakageQty) * unitCost
  discountQty      Float             @default(0) // authorised discounts, excluded from "loss"
  breakageQty      Float             @default(0)

  @@index([sessionId])
  @@index([productId])
}

/// The workbook's staff loss table, made structural — free-form
/// accountability, not an enforced reconciliation (amounts don't have to
/// sum to the session's totalLossValue).
model StockLossAttribution {
  id        String            @id @default(cuid())
  sessionId String
  session   StockCountSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  staffId   String
  staffName String // snapshot
  amount    Float
  note      String?
  createdAt DateTime          @default(now())

  @@index([sessionId])
}

/// A breakage/expiry/damage report — deducts stock immediately and gives
/// loss an explained reason the moment it happens, rather than waiting for
/// the next stock count to notice it. Exactly one location (counter or
/// warehouse) is set per row, same convention as StockLevel.
model Breakage {
  id           String   @id @default(cuid())
  productId    String
  productName  String // snapshot
  quantity     Float
  reason       String // BROKEN | EXPIRED | DAMAGED | LOST
  outletId     String?
  counterCode  String?
  warehouseId  String?
  unitCost     Float
  valueLost    Float
  photoUrl     String?
  note         String?
  reportedById String
  createdAt    DateTime @default(now())

  // Bill Reference System — Breakage plays the "Loss Record" (LOS) bill
  // type (see lib/bill-reference.ts).
  internalBillId   String?         @unique
  displayReference String?         @unique
  billTypeConfigId String?
  billTypeConfig   BillTypeConfig? @relation(fields: [billTypeConfigId], references: [id])

  @@index([outletId, counterCode])
  @@index([warehouseId])
  @@index([createdAt])
}

// Cancellations recorded against a daily collection (Double Punch / Out of Stock / Wrong Punch).
model Cancellation {
  id           String           @id @default(cuid())
  date         DateTime         @default(now())
  collectionId String?
  collection   DailyCollection? @relation(fields: [collectionId], references: [id])
  reason       String // Double Punch | Out of Stock | Wrong Punch
  staffName    String? // set directly for standalone requests (collection ones use collection.staffName)
  productId    String?
  product      Product?         @relation(fields: [productId], references: [id])
  productName  String
  sellingPrice Float            @default(0)
  quantity     Float            @default(0)
  amount       Float            @default(0) // sellingPrice * quantity
  status       String           @default("PENDING") // PENDING | APPROVED | REJECTED
  approvedBy   String?
  outletId     String?
  cashierId    String
  createdAt    DateTime         @default(now())

  @@index([collectionId])
  @@index([date])
  @@index([status])
}

model CashRecon {
  id               String   @id @default(cuid())
  date             DateTime @default(now())
  outletId         String?
  openingBalance   Float    @default(0) // auto = previous day's closing
  cashDeposited    Float    @default(0)
  excessAmountPaid Float    @default(0) // sum of excessItems; reduces cash balance the same way cashDeposited does
  closingBalance   Float    @default(0) // computed & stored so next day can auto-open
  verifiedAmount   Float? // physical cash verified by an officer
  verifiedBy       String?
  notes            String?
  cashierId        String
  createdAt        DateTime @default(now())

  excessItems CashReconExcess[]

  @@index([date])
  @@index([outletId])
}

// One line item of "excess amount paid" within a day's cash reconciliation —
// a day can have several, each with its own reason and (if applicable)
// staff/customer. CashRecon.excessAmountPaid stores their sum for fast reads.
model CashReconExcess {
  id          String    @id @default(cuid())
  cashReconId String
  cashRecon   CashRecon @relation(fields: [cashReconId], references: [id], onDelete: Cascade)
  amount      Float
  reason      String // KITCHEN_SALES | STAFF_TIP | CUSTOMER_EXCESS | OTHERS
  staffId     String? // set when reason = STAFF_TIP
  staffName   String?
  personId    String? // set when reason = CUSTOMER_EXCESS (Person, type=CUSTOMER)
  personName  String?
  paidAmount  Float     @default(0) // settled via Excess Recon; balance = amount - paidAmount
  createdAt   DateTime  @default(now())

  // Bill Reference System — plays the "Excess Payment" (EXS) bill type
  // alongside CollectionExcess (see lib/bill-reference.ts).
  internalBillId   String?         @unique
  displayReference String?         @unique
  billTypeConfigId String?
  billTypeConfig   BillTypeConfig? @relation(fields: [billTypeConfigId], references: [id])

  @@index([cashReconId])
}

// Excess recorded during a Daily Collection (staff collected more than the
// formula required). A collection can have several — mirrors CashReconExcess's
// shape/cardinality so Excess Recon can merge both sources into a single
// Paid/Balance ledger.
model CollectionExcess {
  id           String          @id @default(cuid())
  collectionId String
  collection   DailyCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  amount       Float
  reason       String // KITCHEN_SALES | STAFF_TIP | CUSTOMER_EXCESS | OTHERS | UNASSIGNED
  staffId      String? // set when reason = STAFF_TIP
  staffName    String?
  personId     String? // set when reason = CUSTOMER_EXCESS (Person, type=CUSTOMER)
  personName   String?
  paidAmount   Float           @default(0) // settled via Excess Recon; balance = amount - paidAmount
  createdAt    DateTime        @default(now())

  // Bill Reference System — plays the "Excess Payment" (EXS) bill type
  // alongside CashReconExcess (see lib/bill-reference.ts).
  internalBillId   String?         @unique
  displayReference String?         @unique
  billTypeConfigId String?
  billTypeConfig   BillTypeConfig? @relation(fields: [billTypeConfigId], references: [id])

  @@index([collectionId])
}

// Digital Payment Reconciliation — one row per digital channel per day+outlet.
model BankRecon {
  id              String   @id @default(cuid())
  date            DateTime @default(now())
  outletId        String?
  channel         String? // digital channel code (CRDB | STANBIC | MPESA | …); null = legacy total
  reportedAmount  Float    @default(0) // auto: collections + paid bills for this channel (system "collected")
  openingBalance  Float? // account opening balance (cashier)
  closingBalance  Float? // account closing balance (cashier) — required = closing − opening
  verifiedAmount  Float? // verified collected amount by an officer (null = not yet verified)
  verifiedOpening Float? // opening balance verified by an officer
  verifiedClosing Float? // closing balance verified by an officer
  reason          String? // reason for variance
  reportedBy      String?
  verifiedBy      String?
  cashierId       String
  createdAt       DateTime @default(now())

  @@index([date])
  @@index([outletId])
}

model Setting {
  key   String  @id
  value String?
}

// Configurable person/bill categories (managed under Persons). code is the
// canonical key used as Person.type / SignedBill.billType; label is for display.
model PersonCategory {
  id        String   @id @default(cuid())
  code      String   @unique
  label     String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

// Configurable payment channels (managed under Outlets). Used by Paid Bills,
// Petty Cash, and Daily Collections amount boxes (see DailyCollectionChannel).
model PaymentChannel {
  id        String   @id @default(cuid())
  code      String   @unique
  label     String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

// Configurable cancellation reasons (managed under Setup). Cancellation.reason
// stores the label as free text — this table only drives the picker options.
model CancellationReason {
  id        String   @id @default(cuid())
  code      String   @unique
  label     String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

/// Reasons for an "excess amount" (Cash Recon / Collections excess pickers).
/// Seeded once with the four defaults (see lib/excess-reasons.ts). Two codes
/// are permanently wired into the picker UI/validation — STAFF_TIP unlocks a
/// staff picker, CUSTOMER_EXCESS a customer picker — that behavior is fixed
/// engine logic and doesn't change if a company renames or adds reasons.
model ExcessReason {
  id        String   @id @default(cuid())
  code      String   @unique
  label     String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

// ─── Bill Reference System ───────────────────────────────────────────────────
// A fully configurable, metadata-driven bill-numbering engine (see
// lib/bill-reference.ts). Scope is deliberately limited to "bills": SignedBill,
// PaidBill, CashReconExcess/CollectionExcess (Excess Payment), Breakage (Loss
// Record), and ExcessRefund. PO/GRN/Transfer/Booking/PosOrder numbering is a
// separate, untouched system.
//   BillReferenceConfig.dateFormat:          YYMMDD | DDMMYY | YYYYMMDD | DD-MM-YYYY | MM-YYYY | CUSTOM
//   BillReferenceConfig.separator:           "-" | "/" | "_" | "." | NONE
//   BillReferenceConfig.personNumberingMode: AUTO | MANUAL | EMPLOYEE_NUMBER | CUSTOMER_NUMBER | MEMBERSHIP_NUMBER | SUPPLIER_CODE
//   BillReferenceConfig.sequenceResetRule:   NEVER | DAILY | MONTHLY | YEARLY | PER_PERSON | PER_BILL_TYPE
//   BillReferenceComponent.type:             DATE | BILL_TYPE_CODE | PERSON_CODE | SEQUENCE | COMPANY_CODE | BRANCH_CODE | DEPARTMENT_CODE | COUNTER_CODE | OUTLET_CODE | STATIC_TEXT
//   BillTypeConfig.category:                 SIGNED_BILL | PAID_BILL | EXCESS_PAYMENT | EXCESS_REFUND | LOSS_RECORD

/// Singleton settings row (id is always the literal "default" — enforced by
/// application code, never by end users).
model BillReferenceConfig {
  id                  String   @id @default("default")
  dateFormat          String   @default("YYMMDD")
  customDateFormat    String? // date-fns token string, used when dateFormat = CUSTOM
  separator           String   @default("-")
  numberPadding       Int      @default(3) // 3 -> 001, 4 -> 0001, 5 -> 00001
  personNumberingMode String   @default("AUTO")
  sequenceResetRule   String   @default("NEVER")
  updatedById         String?
  updatedAt           DateTime @updatedAt
  createdAt           DateTime @default(now())

  components BillReferenceComponent[]
}

/// One row per component slot. `order` drives the admin drag-and-drop
/// position; `label` is the admin-renameable display name.
model BillReferenceComponent {
  id          String              @id @default(cuid())
  configId    String              @default("default")
  config      BillReferenceConfig @relation(fields: [configId], references: [id])
  type        String // DATE | BILL_TYPE_CODE | PERSON_CODE | SEQUENCE | COMPANY_CODE | BRANCH_CODE | DEPARTMENT_CODE | COUNTER_CODE | OUTLET_CODE | STATIC_TEXT
  label       String
  order       Int
  isEnabled   Boolean             @default(true)
  staticValue String? // only used when type = STATIC_TEXT
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@unique([configId, type])
  @@index([configId, order])
}

/// The seeded bill types (15 defaults — see lib/bill-reference-defaults.ts).
/// `prefix`/`name` are freely admin-editable. `legacyBillTypeCode` bridges to
/// the OLD SignedBill.billType vocabulary (ADMIN | DIRECTOR | CUSTOMER |
/// STAFF_LOSS | TIPS | DJ) so the one-time backfill can resolve historical rows.
model BillTypeConfig {
  id                 String   @id @default(cuid())
  code               String   @unique // SBA|SBD|SBS|SBC|SBJ|SBT|PBA|PBD|PBS|PBC|PBJ|PBT|EXS|EXR|LOS
  name               String
  prefix             String
  category           String // SIGNED_BILL | PAID_BILL | EXCESS_PAYMENT | EXCESS_REFUND | LOSS_RECORD
  legacyBillTypeCode String? // ADMIN | DIRECTOR | CUSTOMER | STAFF_LOSS | TIPS | DJ | null
  isActive           Boolean  @default(true)
  sortOrder          Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  signedBills        SignedBill[]
  paidBills          PaidBill[]
  cashReconExcesses  CashReconExcess[]
  collectionExcesses CollectionExcess[]
  breakages          Breakage[]
  excessRefunds      ExcessRefund[]
}

/// Generic atomic counter keyed by a single opaque scopeKey string built by
/// lib/bill-reference.ts (e.g. "BT:<billTypeId>:ALL", "BT:<billTypeId>:D:20260716",
/// "INTERNAL:20260716", "PERSONCODE:CUSTOMER"). No FK — the internal-bill-id
/// and person-code counters share this same table via their own scopeKey
/// prefixes, so no fake "bill type" rows are needed for them.
model BillSequenceCounter {
  id        String   @id @default(cuid())
  scopeKey  String   @unique
  lastValue Int      @default(0)
  updatedAt DateTime @updatedAt
}

/// Cross-table registry — every issued reference gets one row here, written
/// in the SAME transaction as the source record. This gives TRUE global
/// uniqueness across all 6 source tables (each also keeps its own @unique as
/// defense-in-depth) and is the single collision point the generation
/// engine's retry loop uses to "auto-advance to the next sequence" on conflict.
model BillReferenceRegistry {
  id               String   @id @default(cuid())
  internalBillId   String   @unique
  displayReference String   @unique
  sourceModel      String // SignedBill | PaidBill | CashReconExcess | CollectionExcess | Breakage | ExcessRefund
  sourceId         String
  billTypeId       String
  createdAt        DateTime @default(now())

  @@index([sourceModel, sourceId])
}

/// Minimal Excess Refund (EXR) record — nothing plays this role today. Mirrors
/// CashReconExcess/CollectionExcess's shape enough to hold a reference and
/// participate in reporting, without their settle-batch machinery (a refund is
/// a one-shot outward payment, not a receivable to collect against).
model ExcessRefund {
  id               String          @id @default(cuid())
  date             DateTime        @default(now())
  internalBillId   String          @unique
  displayReference String          @unique
  billTypeConfigId String?
  billTypeConfig   BillTypeConfig? @relation(fields: [billTypeConfigId], references: [id])
  amount           Float
  personId         String?
  person           Person?         @relation(fields: [personId], references: [id])
  personName       String
  reason           String // OVERPAYMENT | DUPLICATE_PAYMENT | OTHER
  outletId         String
  outlet           Outlet          @relation(fields: [outletId], references: [id])
  refundedById     String
  refundedBy       User            @relation(fields: [refundedById], references: [id])
  approvalStatus   String          @default("PENDING") // PENDING | APPROVED | REJECTED
  approvedBy       String?
  notes            String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([date])
  @@index([outletId])
  @@index([personId])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  details   String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entity])
  @@index([createdAt])
}

// ─── MyPos Module ─────────────────────────────────────────────────────────────
// NOTE: Status/type values are enforced at the application layer (no native enums in SQLite).
//   PosOrder.status:      OPEN | SENT | CLOSED | CANCELLED | VOID
//   PosOrderItem.status:  PENDING | SENT | CANCELLED
//   PosShift.name:        KWANZA | PILI | TATU | NNE
//   PosCounter.code:      MAIN | BAR | SHISHA | KITCHEN
//   PosOrderItem.counterCode: MAIN | BAR | SHISHA | KITCHEN

// Physical tables on the venue floor.
model PosTable {
  id        String   @id @default(cuid())
  outletId  String
  outlet    Outlet   @relation(fields: [outletId], references: [id])
  number    Int
  label     String? // e.g. "VIP 1", "Outside 3"
  capacity  Int      @default(4)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  orders PosOrder[]

  @@unique([outletId, number])
  @@index([outletId])
}

// One shift per outlet per day — KWANZA, PILI, TATU, NNE.
model PosShift {
  id       String    @id @default(cuid())
  outletId String
  outlet   Outlet    @relation(fields: [outletId], references: [id])
  name     String // KWANZA | PILI | TATU | NNE
  date     DateTime
  openedAt DateTime  @default(now())
  closedAt DateTime?
  openedBy String // userId
  closedBy String? // userId

  orders         PosOrder[]
  waiterSessions PosWaiterSession[]

  @@index([outletId])
  @@index([date])
}

// One counter/station per outlet (matches the 4-counter setup).
model PosCounter {
  id           String   @id @default(cuid())
  outletId     String
  outlet       Outlet   @relation(fields: [outletId], references: [id])
  code         String // MAIN | BAR | SHISHA | KITCHEN
  label        String // "Main Counter" | "Bar" | "Shisha" | "Kitchen"
  printerName  String? // default printer assigned to this counter
  // PREP   → kitchen/VIP model: items queue at the counter, are prepared, and
  //          the waiter is notified to collect (order goes READY).
  // DIRECT → counter-service model (Main Bar): seller serves immediately, so
  //          sent items skip the queue and are marked PREPARED at once.
  serviceModel String   @default("PREP") // PREP | DIRECT
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@unique([outletId, code])
  @@index([outletId])
}

// One bill per table per visit. Closing it feeds into DailyCollection.
model PosOrder {
  id              String    @id @default(cuid())
  orderNo         String    @unique // ORD-20260619-001
  outletId        String
  outlet          Outlet    @relation(fields: [outletId], references: [id])
  tableId         String?
  table           PosTable? @relation(fields: [tableId], references: [id])
  eventId         String? // set when this order was rung up against an event's authorized-products menu
  event           Event?    @relation(fields: [eventId], references: [id])
  shiftId         String
  shift           PosShift  @relation(fields: [shiftId], references: [id])
  waiterId        String
  waiter          User      @relation(fields: [waiterId], references: [id])
  status          String    @default("OPEN") // OPEN | SENT | READY | CLOSED | CANCELLED | VOID
  // CUSTOMER → prints "CUSTOMER'S BILL"; the rest are in-house → "IN-HOUSE BILL".
  billType        String    @default("CUSTOMER") // CUSTOMER | ADMIN | DIRECTOR | DJ | TIPS | STAFF
  discount        Float     @default(0)
  discountReason  String? // why the discount was applied — captured for reporting
  totalAmount     Float     @default(0)
  paidAmount      Float     @default(0)
  paymentMethod   String? // CASH | CRDB | STANBIC | MPESA | SIGNED
  signedBillId    String? // set when paymentMethod = SIGNED → links to cashier SignedBill
  closedAt        DateTime?
  closedBy        String? // userId
  voidReason      String? // why the order was cancelled/voided
  notes           String?
  // Offline-queue idempotency key (see lib/offline-queue.ts) — lets a retried
  // "create order" sync request return the already-created row instead of
  // making a duplicate if the first attempt actually succeeded but its
  // response never reached the client. Null for orders created while online.
  clientRequestId String?   @unique
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  items     PosOrderItem[]
  printLogs PosPrintLog[]
  payments  PosPayment[]

  @@index([outletId])
  @@index([shiftId])
  @@index([waiterId])
  @@index([eventId])
  @@index([status])
  @@index([createdAt])
}

/// A (possibly partial) payment received against a POS order. Supports the
/// "Paid 324k / Balance 81k" pattern: multiple payments until the bill settles.
/// The recorder is the verifier — receiving staff confirm cash/digital receipt.
model PosPayment {
  id             String   @id @default(cuid())
  orderId        String
  order          PosOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount         Float
  method         String // CASH | CRDB | STANBIC | MPESA
  receivedById   String // userId of staff who received & verified the payment
  receivedByName String
  note           String?
  createdAt      DateTime @default(now())

  @@index([orderId])
}

// Individual items on an order. counterCode tells the system which printer to use.
model PosOrderItem {
  id              String    @id @default(cuid())
  orderId         String
  order           PosOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId       String
  product         Product   @relation(fields: [productId], references: [id])
  productName     String // snapshot at time of order (price may change later)
  unitPrice       Float
  quantity        Float     @default(1)
  amount          Float // unitPrice * quantity
  extras          String? // JSON array e.g. ["Barafu","Straw"]
  counterCode     String? // MAIN | BAR | SHISHA | KITCHEN — which counter prints this
  status          String    @default("PENDING") // PENDING | SENT | PREPARED | CANCELLED
  sentAt          DateTime?
  preparedAt      DateTime? // when the counter marked it ready/served
  preparedBy      String? // userId of counter staff who marked it ready
  cancelledBy     String? // userId
  cancelReason    String? // why the item was cancelled — captured for reporting
  // Offline-queue idempotency key — see PosOrder.clientRequestId.
  clientRequestId String?   @unique
  createdAt       DateTime  @default(now())

  @@index([orderId])
  @@index([productId])
}

/// VIP Counter staff requesting drinks from the Main Drinks Counter (or vice
/// versa) when their own counter is out of stock of a product — physical
/// hand-off between staff, this just carries the notification/queue.
model PosStockRequest {
  id              String    @id @default(cuid())
  outletId        String
  outlet          Outlet    @relation(fields: [outletId], references: [id])
  fromCounter     String // VIP | MAIN — counter that's out of stock and asking
  toCounter       String // MAIN | VIP — counter being asked to supply
  productId       String
  productName     String // snapshot at request time (price/name may change later)
  quantity        Float     @default(1)
  note            String?
  status          String    @default("PENDING") // PENDING | FULFILLED
  requestedById   String
  requestedByName String
  fulfilledById   String?
  fulfilledAt     DateTime?
  createdAt       DateTime  @default(now())

  @@index([outletId])
  @@index([status])
}

// Tracks every receipt/ticket sent to a counter printer.
model PosPrintLog {
  id          String   @id @default(cuid())
  orderId     String
  order       PosOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  counterCode String // BAR | SHISHA | KITCHEN | CASHIER
  printedAt   DateTime @default(now())
  printedBy   String // userId
  items       String // JSON snapshot of items on this print job

  @@index([orderId])
}

// Waiter signs in/out per shift — matches POSTERMINAL SignInForm/SignOutForm.
model PosWaiterSession {
  id          String    @id @default(cuid())
  waiterId    String
  waiter      User      @relation(fields: [waiterId], references: [id])
  shiftId     String
  shift       PosShift  @relation(fields: [shiftId], references: [id])
  signedInAt  DateTime  @default(now())
  signedOutAt DateTime?

  @@index([waiterId])
  @@index([shiftId])
}

// Add-ons selectable per order item (e.g. Barafu, Straw, Lemon).
model PosProductExtra {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

// Items blocked per outlet by a manager (out of stock / not available today).
// Does not affect the global product catalogue — only the POS menu for that outlet.
model PosBlockedItem {
  id        String   @id @default(cuid())
  outletId  String
  outlet    Outlet   @relation(fields: [outletId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  blockedBy String // userId
  reason    String?
  createdAt DateTime @default(now())

  @@unique([outletId, productId])
  @@index([outletId])
}

/// Staff scheduling: a rostered shift assignment for one staff member on one
/// day at one outlet. This is the planning layer — distinct from PosShift,
/// which is the operational till-open record. Two scheduling shifts per day:
/// MORNING (09:00–16:00) and EVENING (16:00–05:00 next day).
model ScheduleAssignment {
  id          String   @id @default(cuid())
  date        DateTime // the calendar day the shift starts
  shiftType   String // MORNING | EVENING
  outletId    String
  outlet      Outlet   @relation(fields: [outletId], references: [id])
  staffId     String
  staff       User     @relation(fields: [staffId], references: [id])
  staffName   String // denormalized for fast display & export
  role        String   @default("WAITER") // WAITER | SUPERVISOR | BARTENDER | CASHIER | HOSTESS
  source      String   @default("AUTO") // AUTO | MANUAL (manager override)
  note        String? // e.g. auto-scheduler reasoning, or override note
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // A staff member can hold only one slot per shift per day (prevents double-booking).
  @@unique([date, shiftType, staffId])
  @@index([outletId])
  @@index([date])
  @@index([staffId])
}

/// Exception to the default "every active service staff is available" rule.
/// shiftType null = unavailable the whole day; otherwise only that shift.
model StaffUnavailability {
  id          String   @id @default(cuid())
  staffId     String
  staff       User     @relation(fields: [staffId], references: [id])
  staffName   String
  date        DateTime
  shiftType   String? // null = whole day | MORNING | EVENING
  reason      String   @default("OTHER") // LEAVE | ABSENT | OTHER
  note        String?
  createdById String?
  createdAt   DateTime @default(now())

  @@index([staffId])
  @@index([date])
}

/// Per-outlet knobs for the auto-scheduler (expected-traffic weighting and
/// rest-day policy). One row per outlet; sensible defaults if absent.
model OutletScheduleConfig {
  id                String   @id @default(cuid())
  outletId          String   @unique
  outlet            Outlet   @relation(fields: [outletId], references: [id])
  morningWeight     Float    @default(1) // expected traffic weight — Morning
  eveningWeight     Float    @default(1.6) // Evening is usually busier (nightlife)
  weekendMultiplier Float    @default(1.4) // Fri/Sat uplift on both shifts
  daysOffPerWeek    Int      @default(1) // rest days per staff per week
  updatedAt         DateTime @updatedAt
}

/// An external event or special function staffed temporarily from the
/// "Tips Events" outlet. Staff assigned here are pulled off their regular
/// weekly roster for the event day (see /api/events/[id]/staff).
model Event {
  id             String   @id @default(cuid())
  name           String
  description    String?
  eventType      String? // e.g. Wedding, Corporate, Concert, Private Party, Product Launch, Other
  clientName     String?
  location       String?
  date           DateTime // event day
  startTime      String? // "18:00"
  endTime        String? // "23:00"
  expectedGuests Int      @default(0)
  status         String   @default("PLANNED") // PLANNED | CONFIRMED | COMPLETED | CANCELLED
  salesTotal     Float    @default(0) // event revenue
  notes          String?
  outletId       String?
  outlet         Outlet?  @relation(fields: [outletId], references: [id])
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  staff         EventStaff[]
  expenses      EventExpense[]
  sponsors      EventSponsor[]
  products      EventProduct[]
  targets       EventTarget[]
  ticketTypes   EventTicketType[]
  tickets       TicketBooking[]
  tables        EventTable[]
  tableBookings TableBooking[]
  posOrders     PosOrder[]

  @@index([date])
  @@index([status])
}

/// A staff member assigned to work an event, with their role, attendance and
/// performance (sales attributed) during the event.
model EventStaff {
  id              String   @id @default(cuid())
  eventId         String
  event           Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  staffId         String
  staff           User     @relation(fields: [staffId], references: [id])
  staffName       String
  role            String   @default("WAITER") // SUPERVISOR | WAITER | BARTENDER | CASHIER | HOSTESS
  attended        Boolean  @default(false)
  salesAttributed Float    @default(0)
  performanceNote String?
  createdAt       DateTime @default(now())

  @@unique([eventId, staffId])
  @@index([staffId])
}

/// A budget/cost line on an event (transport, equipment, hire, etc.).
/// `amount` is the actual cost; `estimatedCost` is the planned budget for the
/// same line, so variance = estimatedCost - amount.
model EventExpense {
  id            String   @id @default(cuid())
  eventId       String
  event         Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  category      String
  description   String?
  estimatedCost Float    @default(0)
  amount        Float    @default(0) // actual cost
  supplier      String?
  paymentStatus String   @default("UNPAID") // UNPAID | PARTIAL | PAID
  createdById   String?
  createdAt     DateTime @default(now())

  @@index([eventId])
}

/// A sponsor backing an event, with the value/items they're contributing.
model EventSponsor {
  id               String   @id @default(cuid())
  eventId          String
  event            Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  sponsorName      String
  contactPerson    String?
  phone            String?
  email            String?
  sponsorshipType  String   @default("CASH") // CASH | IN_KIND | MEDIA | OTHER
  sponsorshipValue Float    @default(0)
  itemsProvided    String?
  agreementStatus  String   @default("PENDING") // PENDING | SIGNED | FULFILLED
  notes            String?
  createdById      String?
  createdAt        DateTime @default(now())

  @@index([eventId])
}

/// A product from the shared catalog authorized to be sold at an event, with
/// event-specific pricing and planning quantities. Stock fields are planning
/// inputs here — real stock movement wiring lands with the event POS phase.
model EventProduct {
  id                  String   @id @default(cuid())
  eventId             String
  event               Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  productId           String
  product             Product  @relation(fields: [productId], references: [id])
  productName         String // snapshot at time of authorization
  eventPrice          Float? // override; null = use Product.sellingPrice
  expectedQuantity    Float    @default(0)
  procurementQuantity Float    @default(0)
  stockAllocated      Float    @default(0)
  stockReturned       Float    @default(0)
  quantitySold        Float    @default(0)
  createdAt           DateTime @default(now())

  @@unique([eventId, productId])
  @@index([eventId])
}

/// A sales or procurement target set for an event, compared against a
/// (manually tracked or, where derivable, auto-suggested) actual value.
model EventTarget {
  id          String   @id @default(cuid())
  eventId     String
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  type        String // SALES | PROCUREMENT
  name        String // e.g. "Revenue Target", "Required Beer Stock"
  targetValue Float    @default(0)
  actualValue Float    @default(0)
  unit        String? // e.g. "TZS", "bottles", "crates", "guests"
  notes       String?
  createdAt   DateTime @default(now())

  @@index([eventId])
}

/// A ticket type a manager defines for an event (Regular/VIP/VVIP or custom),
/// with an optional capacity. Bookings against it are public (see
/// TicketBooking) — capacity is enforced transactionally in lib/bookings.ts.
model EventTicketType {
  id                String   @id @default(cuid())
  eventId           String
  event             Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name              String
  price             Float    @default(0)
  quantityAvailable Int? // null = unlimited
  createdAt         DateTime @default(now())

  bookings TicketBooking[]

  @@index([eventId])
}

/// A customer's ticket booking, created either publicly (app/book/[eventId])
/// or by a manager (walk-in/phone booking). Payment is tracked manually —
/// there is no payment gateway integration.
model TicketBooking {
  id            String          @id @default(cuid())
  eventId       String
  event         Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ticketTypeId  String
  ticketType    EventTicketType @relation(fields: [ticketTypeId], references: [id])
  bookingNumber String          @unique
  fullName      String
  phone         String
  email         String?
  quantity      Int             @default(1)
  totalAmount   Float           @default(0)
  paymentStatus String          @default("UNPAID") // UNPAID | PARTIAL | PAID
  bookingStatus String          @default("PENDING") // PENDING | CONFIRMED | CANCELLED
  checkedIn     Boolean         @default(false)
  checkedInAt   DateTime?
  createdAt     DateTime        @default(now())

  @@index([eventId])
  @@index([ticketTypeId])
}

/// A physical table a manager defines for an event (venue/layout varies per
/// event, so tables are per-event, not a reusable outlet-wide registry).
/// `status` doubles as the at-a-glance availability shown on the booking
/// page and can be flipped manually (e.g. a walk-in occupies a table with no
/// online booking).
model EventTable {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name      String // "Table 1", "VIP Table A"
  tableType String?
  capacity  Int      @default(4)
  price     Float    @default(0)
  status    String   @default("AVAILABLE") // AVAILABLE | RESERVED | OCCUPIED
  createdAt DateTime @default(now())

  bookings TableBooking[]

  @@index([eventId])
}

/// A customer's table reservation. Creating one flips the table's status to
/// RESERVED (see lib/bookings.ts); cancelling frees it back to AVAILABLE.
model TableBooking {
  id              String     @id @default(cuid())
  eventId         String
  event           Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  tableId         String
  table           EventTable @relation(fields: [tableId], references: [id])
  bookingNumber   String     @unique
  name            String
  phone           String
  guests          Int        @default(1)
  totalAmount     Float      @default(0)
  depositPaid     Float      @default(0) // balance = totalAmount - depositPaid, computed not stored
  specialRequests String?
  bookingStatus   String     @default("PENDING") // PENDING | CONFIRMED | CANCELLED
  createdAt       DateTime   @default(now())

  @@index([eventId])
  @@index([tableId])
}
